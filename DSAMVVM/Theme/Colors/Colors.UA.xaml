<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==== Color tokens ==== -->
    <!-- Surfaces -->
    <Color x:Key="Color.Surface.0">#0C1C36</Color>
    <Color x:Key="Color.Surface.1">#0F141A</Color>
    <Color x:Key="Color.Surface.Hover">#1C2531</Color>
    <Color x:Key="Color.Surface.Pressed">#151C25</Color>

    <!-- Borders -->
    <Color x:Key="Color.Border">#2A2F3A</Color>
    <Color x:Key="Color.Border.Active">#3A4352</Color>

    <!-- Text -->
    <Color x:Key="Color.Text.Primary">#CCD3DA</Color>
    <Color x:Key="Color.Text.Muted">#9AA3AE</Color>
    <Color x:Key="Color.Text.OnAccent">#FFFFFFFF</Color>

    <!-- Primary brand accent (maroon) -->
    <Color x:Key="Color.Accent">#421214</Color>
    <Color x:Key="Color.Accent.Hover">#4B171A</Color>
    <Color x:Key="Color.Accent.Pressed">#371013</Color>

    <!-- Info (blue) -->
    <Color x:Key="Color.Info">#3AA0FF</Color>
    <Color x:Key="Color.Info.Light">#5BC3FF</Color>
    <Color x:Key="Color.Info.Hover">#2D86EA</Color>
    <Color x:Key="Color.Info.Pressed">#1F6AC1</Color>

    <!-- Warning (gold / softened) -->
    <Color x:Key="Color.Warning">#FFB84D</Color>
    <Color x:Key="Color.Warning.Hover">#E6A645</Color>
    <Color x:Key="Color.Warning.Pressed">#CC953D</Color>

    <!-- Success (green) -->
    <Color x:Key="Color.Success">#1E7A3A</Color>
    <Color x:Key="Color.Success.Hover">#186232</Color>
    <Color x:Key="Color.Success.Pressed">#124C28</Color>

    <!-- Control neutral -->
    <Color x:Key="Color.Control.Normal">#A9A9A9</Color>

    <!-- Alternate Card colors -->
    <Color x:Key="Color.Card.Alternate">#3A4B6E</Color>
    <Color x:Key="Color.Card.Border.Alternate">#44536F</Color>


    <!-- ==== Brush wrappers ==== -->
    <SolidColorBrush x:Key="Brush.Surface"         Color="{DynamicResource Color.Surface.0}"/>
    <SolidColorBrush x:Key="Brush.Surface.1"       Color="{DynamicResource Color.Surface.1}"/>
    <SolidColorBrush x:Key="Brush.Surface.Hover"   Color="{DynamicResource Color.Surface.Hover}"/>
    <SolidColorBrush x:Key="Brush.Surface.Pressed" Color="{DynamicResource Color.Surface.Pressed}"/>

    <SolidColorBrush x:Key="Brush.Border"          Color="{DynamicResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.Border.Active"   Color="{DynamicResource Color.Border.Active}"/>

    <SolidColorBrush x:Key="Brush.Text.Primary"    Color="{DynamicResource Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text.Muted"      Color="{DynamicResource Color.Text.Muted}"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent"   Color="{DynamicResource Color.Text.OnAccent}"/>

    <SolidColorBrush x:Key="Brush.Accent"          Color="{DynamicResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover"    Color="{DynamicResource Color.Accent.Hover}"/>
    <SolidColorBrush x:Key="Brush.Accent.Pressed"  Color="{DynamicResource Color.Accent.Pressed}"/>

    <SolidColorBrush x:Key="Brush.Info"            Color="{DynamicResource Color.Info}"/>
    <SolidColorBrush x:Key="Brush.Info.Hover"      Color="{DynamicResource Color.Info.Hover}"/>
    <SolidColorBrush x:Key="Brush.Info.Pressed"    Color="{DynamicResource Color.Info.Pressed}"/>

    <SolidColorBrush x:Key="Brush.Warning"         Color="{DynamicResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Warning.Hover"   Color="{DynamicResource Color.Warning.Hover}"/>
    <SolidColorBrush x:Key="Brush.Warning.Pressed" Color="{DynamicResource Color.Warning.Pressed}"/>

    <SolidColorBrush x:Key="Brush.Success"         Color="{DynamicResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Success.Hover"   Color="{DynamicResource Color.Success.Hover}"/>
    <SolidColorBrush x:Key="Brush.Success.Pressed" Color="{DynamicResource Color.Success.Pressed}"/>

    <SolidColorBrush x:Key="Brush.Control.Normal"  Color="{DynamicResource Color.Control.Normal}"/>

    <SolidColorBrush x:Key="Brush.Card.Alternate"
                     Color="{DynamicResource Color.Card.Alternate}"/>
    <SolidColorBrush x:Key="Brush.Card.Border.Alternate"
                     Color="{DynamicResource Color.Card.Border.Alternate}"/>

    <!-- ==== Backward-compatibility aliases ==== -->
    <!-- Accent Copper / Red / Blue -->
    <SolidColorBrush x:Key="Brush.Accent.Copper" Color="#B87333"/>
    <SolidColorBrush x:Key="Brush.Accent.Red"    Color="#B11226"/>
    <SolidColorBrush x:Key="Brush.Accent.Blue"   Color="#001F3F"/>

    <!-- Text Aliases -->
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{DynamicResource Color.Text.Muted}"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled"  Color="#88FFFFFF"/>

    <!-- Legacy naming -->
    <SolidColorBrush x:Key="MenuTextPrimaryBrush"  Color="{DynamicResource Color.Text.Primary}"/>

</ResourceDictionary>
