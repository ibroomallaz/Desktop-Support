<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:res="clr-namespace:DSAMVVM.MVVM.View.Resources">

    <Style x:Key="ComboBox.Search" TargetType="{x:Type ComboBox}">
        <!-- sizing/behavior -->
        <Setter Property="IsEditable" Value="True"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="MinWidth" Value="220"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>

        <!-- colors from UA theme tokens -->
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource InputGradient.Field}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Whole-control click target to open list (no visual states) -->
                            <ToggleButton x:Name="PART_DropDownToggle"
                                          Grid.ColumnSpan="2"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsTabStop="False"
                                          Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          FocusVisualStyle="{x:Null}"
                                          OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Contextual Watermark / Placeholder -->
                            <TextBlock x:Name="Placeholder"
                                       Grid.Column="0"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, FallbackValue='Search...', TargetNullValue='Search...'}"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       FontSize="11"
                                       Margin="10,0,26,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>

                            <!-- Editable text input area -->
                            <ScrollViewer x:Name="PART_EditableTextBoxSite"
                                          Grid.Column="0">
                                <TextBox x:Name="PART_EditableTextBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="10,0,26,0"
                                         VerticalContentAlignment="Center"
                                         FontSize="12"
                                         CaretBrush="{DynamicResource Brush.Text.Primary}"
                                         Foreground="{TemplateBinding Foreground}"
                                         SelectionBrush="{DynamicResource Brush.Accent.Red}"
                                         SelectionOpacity="0.4"
                                         Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#8C1D40"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                                    </TextBox.Resources>
                                </TextBox>
                            </ScrollViewer>

                            <!-- Subtle '✕' Clear Button -->
                            <Button x:Name="PART_ClearButton"
                                    Grid.Column="1"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Focusable="False"
                                    Cursor="Hand"
                                    ToolTip="Clear search"
                                    Command="{Binding Path=DataContext.ClearSearchCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    Visibility="Collapsed">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ClearBorder"
                                                Background="Transparent"
                                                CornerRadius="9"
                                                Padding="0">
                                            <TextBlock Text="{x:Static res:Glyphs.Dismiss}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="8"
                                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       x:Name="ClearGlyph"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ClearBorder" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                                <Setter TargetName="ClearGlyph" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ClearBorder" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Dropdown popup -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource Brush.Card.Border}"
                                        Background="{DynamicResource CardGradient.Surface.L1}"
                                        SnapsToDevicePixels="True"
                                        Margin="0,4,0,0"
                                        Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType=Popup}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="260"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover border -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Active}"/>
                        </Trigger>

                        <!-- Keyboard focus: input focus gradient & active border -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InputGradient.Field.Focused}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Input.FocusRing}"/>
                        </Trigger>

                        <!-- Disabled state -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            <Setter TargetName="Chrome" Property="Cursor" Value="Arrow"/>
                        </Trigger>

                        <!-- Show Watermark when empty and no selection -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="PART_EditableTextBox" Property="Text" Value=""/>
                                <Condition Property="SelectedIndex" Value="-1"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>

                        <!-- Show Clear button when text is present -->
                        <DataTrigger Binding="{Binding HasSearchQuery}" Value="True">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
