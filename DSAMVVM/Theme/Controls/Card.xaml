<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Hover-lift card -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.CardPadding}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- prepare for animation -->
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0"/>
            </Setter.Value>
        </Setter>
        <!-- shadow we will animate from 0 opacity -->
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Opacity="0"/>
            </Setter.Value>
        </Setter>
        <!-- (optional but helps perf on animated elements) -->
        <Setter Property="CacheMode">
            <Setter.Value>
                <BitmapCache/>
            </Setter.Value>
        </Setter>

        <!-- animated hover -->
        <Style.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard x:Name="CardHoverOn">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             To="-2" Duration="0:0:0.12"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).BlurRadius"
                             To="18" Duration="0:0:0.12"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).Opacity"
                             To="0.28" Duration="0:0:0.12"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>

            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard x:Name="CardHoverOff">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             To="0" Duration="0:0:0.14"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).BlurRadius"
                             To="12" Duration="0:0:0.14"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).Opacity"
                             To="0" Duration="0:0:0.14"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
