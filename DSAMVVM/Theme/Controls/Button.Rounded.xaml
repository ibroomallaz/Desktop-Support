<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- tokens -->
    <CornerRadius x:Key="Button.Rounded.CornerRadius">12</CornerRadius>
    <CornerRadius x:Key="Button.Rounded.Small.CornerRadius">8</CornerRadius>

    <!-- effects -->
    <DropShadowEffect x:Key="Fx.ActiveGlow"
                      BlurRadius="12" ShadowDepth="0"
                      Opacity="0.35" Color="#A22C45"
                      x:Shared="False"/>

    <!-- large template -->
    <ControlTemplate x:Key="Tpl.Button.Rounded.Large" TargetType="Button">
        <Border x:Name="Root"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                CornerRadius="{TemplateBinding Tag}"
                Background="{TemplateBinding Background}"
                BorderBrush="Transparent" BorderThickness="0">
            <ContentPresenter x:Name="ContentHost"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              TextOptions.TextFormattingMode="Display"
                              TextOptions.TextRenderingMode="ClearType"
                              TextOptions.TextHintingMode="Fixed"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonGradient.Neutral}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonGradient.Primary}"/>
                <Setter TargetName="Root" Property="Effect" Value="{StaticResource Fx.ActiveGlow}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Background" Value="Transparent"/>
                <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="Transparent"/>
                <Setter TargetName="ContentHost" Property="Opacity" Value="0"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- small template -->
    <ControlTemplate x:Key="Tpl.Button.Rounded.Small" TargetType="Button">
        <Border x:Name="Root"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                CornerRadius="{TemplateBinding Tag}"
                Background="{TemplateBinding Background}"
                BorderBrush="Transparent" BorderThickness="0">
            <ContentPresenter x:Name="ContentHost"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              TextOptions.TextFormattingMode="Display"
                              TextOptions.TextRenderingMode="ClearType"
                              TextOptions.TextHintingMode="Fixed"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonGradient.Neutral}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonGradient.Primary}"/>
                <Setter TargetName="Root" Property="Effect" Value="{StaticResource Fx.ActiveGlow}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
                <Setter TargetName="ContentHost" Property="Opacity" Value="1"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- large style -->
    <Style x:Key="Button.Rounded" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Gradient.Grey}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Tag" Value="{StaticResource Button.Rounded.CornerRadius}"/>
        <Setter Property="Template" Value="{StaticResource Tpl.Button.Rounded.Large}"/>
    </Style>

    <!-- small style -->
    <Style x:Key="Button.Rounded.Small" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Tag" Value="{StaticResource Button.Rounded.Small.CornerRadius}"/>
        <Setter Property="Template" Value="{StaticResource Tpl.Button.Rounded.Small}"/>
    </Style>
    <Style x:Key="Button.QuickSearch" TargetType="Button">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="16">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Active}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
