<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- local shape -->
    <CornerRadius x:Key="FlowBtn.CornerRadius">12</CornerRadius>

    <!-- FlowDoc button: grey (normal) → blue (hover) → red (pressed) -->
    <Style x:Key="Button.FlowDoc" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Gradient.Grey}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource FlowBtn.CornerRadius}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover: blue gradient -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource InputGradient.Field.Focused}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Brush.Text.Primary}"/>
                        </Trigger>

                        <!-- Pressed: red gradient -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ButtonGradient.Primary}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Brush.Text.Primary}"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Inactive}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact square variant for A-/A/A+ -->
    <Style x:Key="Button.FlowDoc.Small"
           TargetType="Button"
           BasedOn="{StaticResource Button.FlowDoc}">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

</ResourceDictionary>
