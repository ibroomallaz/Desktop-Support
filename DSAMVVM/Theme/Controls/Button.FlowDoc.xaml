<!-- Theme/Controls/Button.FlowDoc.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- shape stays local; all colors come from Colors.UA -->
    <CornerRadius x:Key="FlowBtn.CornerRadius">12</CornerRadius>

    <Style x:Key="Button.FlowDoc" TargetType="Button">
        <!-- default look -->
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Normal}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource FlowBtn.CornerRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover: UA hover surface + UA primary text -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource MenuTextPrimaryBrush}"/>
                        </Trigger>

                        <!-- Pressed: UA pressed accent + UA primary text -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Accent.Pressed}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource MenuTextPrimaryBrush}"/>
                        </Trigger>

                        <!-- Disabled: soften using base surface -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface}"/>
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact square variant for A-/A/A+ -->
    <Style x:Key="Button.FlowDoc.Small"
           TargetType="Button"
           BasedOn="{StaticResource Button.FlowDoc}">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

</ResourceDictionary>
