<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CornerRadius x:Key="Radio.Menu.CornerRadius">20</CornerRadius>

    <!-- Main menu radio used as tabs -->
    <Style x:Key="Radio.Menu" TargetType="RadioButton">
        <!-- Defaults come from theme -->
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{DynamicResource Radio.Menu.CornerRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              RecognizesAccessKey="True"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover (inactive) -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource Brush.Surface.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                        </Trigger>

                        <!-- Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource Brush.Accent.Pressed}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                        </Trigger>

                        <!-- Checked -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource Brush.Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                        </Trigger>

                        <!-- Checked + Hover -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource Brush.Accent.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                        </MultiTrigger>

                        <!-- Checked + Pressed -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsPressed" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource Brush.Accent.Pressed}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
