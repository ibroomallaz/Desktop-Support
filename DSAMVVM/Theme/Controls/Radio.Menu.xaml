<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:enums="clr-namespace:DSAMVVM.Core.Enums">

    <!-- brushes -->
    <LinearGradientBrush x:Key="Brush.Gradient.Pill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4D0000" Offset="0.00"/>
        <GradientStop Color="#8C1D40" Offset="0.50"/>
        <GradientStop Color="#A22C45" Offset="1.00"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Gradient.Hover" StartPoint="0,0" EndPoint="1,0" Opacity="0.15">
        <GradientStop Color="#B0C8FF" Offset="0.0"/>
        <GradientStop Color="#A0B6FF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- text colors -->
    <SolidColorBrush x:Key="Brush.Text.Inactive" Color="#D5DAE1"/>
    <SolidColorBrush x:Key="Brush.Text.Primary"  Color="#FFFFFF"/>

    <!-- timing/effects -->
    <Duration x:Key="Fx.Fast">0:0:0.18</Duration>
    <DropShadowEffect x:Key="Fx.ActiveGlow" BlurRadius="12" ShadowDepth="0" Opacity="0.35" Color="#A22C45" x:Shared="False"/>

    <!-- structure: pill bleed. Left = -(sidebar left padding). Right = 0 so semicircle is fully visible. -->
    <Thickness x:Key="Nav.Pill.Bleed">-12,0,0,0</Thickness>

    <!-- Style: Radio.Menu -->
    <Style x:Key="Radio.Menu" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Inactive}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <!-- glyph size -->
        <Setter Property="Tag" Value="{x:Null}"/>
        <Setter Property="FontSize" Value="16"/>

        <!-- text rendering -->
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- allow rounded end to render fully -->
                    <Grid Margin="0,4,0,4" ClipToBounds="False" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- active pill (flat left, round right) -->
                        <Border x:Name="ActiveBg"
                                Grid.ColumnSpan="2"
                                Height="36"
                                CornerRadius="0,18,18,0"
                                Background="{DynamicResource Brush.Gradient.Pill}"
                                HorizontalAlignment="Stretch"
                                Margin="{StaticResource Nav.Pill.Bleed}"
                                Opacity="0"/>

                        <!-- hover layer (flat left, round right) -->
                        <Border x:Name="HoverBg"
                                Grid.ColumnSpan="2" Grid.Column="0"
                                Height="36"
                                CornerRadius="0,18,18,0"
                                Background="{DynamicResource Brush.Gradient.Hover}"
                                HorizontalAlignment="Stretch"
                                Margin="{StaticResource Nav.Pill.Bleed}"
                                Opacity="0"/>

                        <!-- left glyph -->
                        <TextBlock x:Name="Glyph"
                                   Grid.Column="0"
                                   FontFamily="Segoe MDL2 Assets"
                                   Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontSize="{TemplateBinding FontSize}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"/>

                        <!-- label -->
                        <ContentPresenter x:Name="LabelPresenter"
                                          Grid.Column="1"
                                          Margin="8,0,12,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource Fx.Fast}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource Fx.Fast}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- checked -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ActiveBg" Property="Opacity" Value="1"/>
                            <Setter TargetName="HoverBg"  Property="Opacity" Value="0"/>
                            <Setter TargetName="ActiveBg" Property="Effect"  Value="{StaticResource Fx.ActiveGlow}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            <Setter Property="FontWeight"  Value="SemiBold"/>
                        </Trigger>

                        <!-- disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                            <Setter Property="Cursor"  Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style: Nav.ListBoxItem -->
    <Style x:Key="Nav.ListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Inactive}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTip" Value="{Binding Title}"/>
        <Setter Property="ToolTipService.IsEnabled" Value="False"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="100"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="0,4,0,4" ClipToBounds="False" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- active pill (flat left, round right) -->
                        <Border x:Name="ActiveBg"
                                Grid.ColumnSpan="2"
                                Height="36"
                                CornerRadius="0,18,18,0"
                                Background="{DynamicResource Brush.Gradient.Pill}"
                                HorizontalAlignment="Stretch"
                                Margin="{StaticResource Nav.Pill.Bleed}"
                                Opacity="0"/>

                        <!-- hover layer (flat left, round right) -->
                        <Border x:Name="HoverBg"
                                Grid.ColumnSpan="2" Grid.Column="0"
                                Height="36"
                                CornerRadius="0,18,18,0"
                                Background="{DynamicResource Brush.Gradient.Hover}"
                                HorizontalAlignment="Stretch"
                                Margin="{StaticResource Nav.Pill.Bleed}"
                                Opacity="0"/>

                        <!-- left glyph -->
                        <TextBlock x:Name="Glyph"
                                   Grid.Column="0"
                                   FontFamily="Segoe MDL2 Assets"
                                   Text="{Binding Glyph}"
                                   FontSize="{TemplateBinding FontSize}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"/>

                        <!-- label -->
                        <TextBlock x:Name="Label"
                                   Grid.Column="1"
                                   Text="{Binding Title}"
                                   Margin="8,0,12,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   SnapsToDevicePixels="True"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource Fx.Fast}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource Fx.Fast}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- selected -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ActiveBg" Property="Opacity" Value="1"/>
                            <Setter TargetName="HoverBg"  Property="Opacity" Value="0"/>
                            <Setter TargetName="ActiveBg" Property="Effect"  Value="{StaticResource Fx.ActiveGlow}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            <Setter Property="FontWeight"  Value="SemiBold"/>
                        </Trigger>

                        <!-- disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                            <Setter Property="Cursor"  Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsCompactSidebar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="ToolTipService.IsEnabled" Value="True"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding View}" Value="{x:Static enums:AppView.Settings}">
                <Setter Property="Margin" Value="0,8,0,4"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Style: Nav.ListBox -->
    <Style x:Key="Nav.ListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Nav.ListBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style: Nav.ToggleButton (Compact 28px icon button tucked into the bottom-right corner) -->
    <Style x:Key="Nav.ToggleButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Inactive}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTip" Value="{Binding SidebarToggleToolTip}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="100"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,6,12,6"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Width="28"
                            Height="28"
                            CornerRadius="14"
                            Background="Transparent"
                            SnapsToDevicePixels="True">
                        <TextBlock x:Name="Glyph"
                                   FontFamily="Segoe MDL2 Assets"
                                   Text="{Binding SidebarToggleGlyph}"
                                   FontSize="{TemplateBinding FontSize}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Gradient.Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                        </Trigger>
                        <!-- pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                        <!-- disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompactSidebar}" Value="True">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,6,0,6"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
