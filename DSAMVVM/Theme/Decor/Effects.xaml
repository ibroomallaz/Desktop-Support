<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Elevations -->
    <DropShadowEffect x:Key="Elevation.1" BlurRadius="12" ShadowDepth="0" Opacity="0.22" Color="#000000" x:Shared="False"/>
    <DropShadowEffect x:Key="Elevation.2" BlurRadius="18" ShadowDepth="0" Opacity="0.30" Color="#000000" x:Shared="False"/>

    <!-- Tunables -->
    <Duration x:Key="Fx.Fast">0:0:0.18</Duration>

    <!-- Fade in when element becomes visible -->
    <Style x:Key="Fx.FadeInOnVisible" TargetType="FrameworkElement">
        <Setter Property="Opacity" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="{StaticResource Fx.Fast}"
                                             FillBehavior="HoldEnd"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Slide + fade for the main ContentControl host -->
    <Style x:Key="Fx.SlideFadeHost" TargetType="ContentControl">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="12"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="HasContent" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                             Duration="{StaticResource Fx.Fast}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                             From="12" To="0" Duration="{StaticResource Fx.Fast}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Hover lift for cards/buttons -->
    <Style x:Key="Fx.HoverLift" TargetType="Border">
        <Setter Property="Effect" Value="{StaticResource Elevation.1}"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                             To="0.35" Duration="{StaticResource Fx.Fast}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1.02" Duration="{StaticResource Fx.Fast}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.02" Duration="{StaticResource Fx.Fast}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                             To="0.22" Duration="{StaticResource Fx.Fast}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="{StaticResource Fx.Fast}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="{StaticResource Fx.Fast}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sidebar glyph template with animated accent bar -->
    <DataTemplate x:Key="Fx.NavItemWithAccent">
        <Grid Margin="2,2,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="Accent"
                    Grid.Column="0"
                    Background="{DynamicResource Brush.Accent.Copper}"
                    Width="0"/>

            <TextBlock Grid.Column="1"
                       FontFamily="Segoe MDL2 Assets"
                       Text="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Tag}"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=IsChecked}"
                                         Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Column="2"
                       Text="{Binding}"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=IsChecked}"
                                         Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Triggers must be a direct child of DataTemplate -->
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=IsChecked}"
                         Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Accent"
                                             Storyboard.TargetProperty="Width"
                                             To="3"
                                             Duration="{StaticResource Fx.Fast}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Accent"
                                             Storyboard.TargetProperty="Width"
                                             To="0"
                                             Duration="{StaticResource Fx.Fast}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
