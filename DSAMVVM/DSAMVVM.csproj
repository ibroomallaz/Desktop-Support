<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>False</UseWindowsForms>
    <ApplicationIcon>img\MainIcon.ico</ApplicationIcon>
    <RepositoryUrl>https://github.com/ibroomallaz/Desktop-Support</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <AssemblyVersion>4.5.1</AssemblyVersion>
    <FileVersion>4.5.1200</FileVersion>
    <Version>4.5.1</Version>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Title>Desktop Support App</Title>
    <Product>Desktop Support App</Product>
    <Description>Tools for UITS Desktop Support</Description>
    <Company>University of Arizona</Company>
    <Authors>Isaac Broomall</Authors>
    <AssemblyName>Desktop Support App</AssemblyName>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="img\fileicon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Graph" Version="6.8.0" />
    <PackageReference Include="Microsoft.Graph.Core" Version="4.0.1" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.91.1" />
    <PackageReference Include="Microsoft.Identity.Client.Broker" Version="4.91.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SharpHook" Version="8.0.1" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="img\MainIcon.ico" />
    <Resource Include="img\fileicon.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="MVVM\View\Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="MVVM\View\Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
