<Window x:Class="DSAMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DSAMVVM"
        xmlns:viewModel="clr-namespace:DSAMVVM.MVVM.ViewModel"
        xmlns:view="clr-namespace:DSAMVVM.MVVM.View"
        xmlns:enums="clr-namespace:DSAMVVM.Core.Enums"
        xmlns:util="clr-namespace:DSAMVVM.Core.Utilities"
        xmlns:res="clr-namespace:DSAMVVM.MVVM.View.Resources"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Height="600" Width="920"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        Title="Support App">

    <Window.Resources>
        <ResourceDictionary>
            <!-- geometry -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <sys:Double x:Key="AppCornerValue">20</sys:Double>
            <CornerRadius x:Key="AppCorner.All">20</CornerRadius>
            <!-- sidebar: round top-right as requested -->
            <CornerRadius x:Key="AppCorner.Sidebar">20,20,0,20</CornerRadius>

            <util:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer shell: blue ramp with soft shadow -->
    <Border Background="{StaticResource AppGradient.Window.Blue}"
            CornerRadius="{StaticResource AppCorner.All}"
            Padding="0"
            ClipToBounds="True"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <DockPanel LastChildFill="True" UseLayoutRounding="True" SnapsToDevicePixels="True">

            <!-- Status bar -->
            <view:StatusBarView DockPanel.Dock="Bottom"
                                 DataContext="{Binding StatusBar}"
                                 Margin="10,0,10,10"/>

            <!-- Header -->
            <Grid DockPanel.Dock="Top" Height="40" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="29*"/>
                    <ColumnDefinition Width="764*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Support App"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="20,0,0,0"
                           MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Grid.ColumnSpan="2"/>

                <StackPanel Orientation="Horizontal"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <Button Style="{StaticResource Button.Rounded.Small}"
                            Content="{x:Static res:Glyphs.Warning}"
                            FontFamily="Segoe MDL2 Assets"
                            Click="FeedbackButton_Click"
                            Margin="0,0,5,0">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="Report a Bug" Command="{Binding OpenFeedbackCommand}" CommandParameter="0"/>
                                <MenuItem Header="Request a Feature" Command="{Binding OpenFeedbackCommand}" CommandParameter="1"/>
                                <MenuItem Header="Update Support Team" Command="{Binding OpenFeedbackCommand}" CommandParameter="2"/>
                                <MenuItem Header="Add/Update Note" Command="{Binding OpenFeedbackCommand}" CommandParameter="3"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Style="{StaticResource Button.Rounded.Small}"
                            Content="—"
                            Click="Minimize_Click"
                            Margin="0,0,5,0"/>

                    <Button Style="{StaticResource Button.Rounded.Small}"
                            Content="X"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Sidebar: top-right rounded + single right-edge separator -->
            <Border DockPanel.Dock="Left"
                    Panel.ZIndex="1"
                    Width="200"
                    Background="{StaticResource AppGradient.Sidebar.Background}"
                    Padding="0,8,0,8"
                    SnapsToDevicePixels="True"
                    CornerRadius="{StaticResource AppCorner.Sidebar}"
                    BorderThickness="0,0,3,0"
                    BorderBrush="{StaticResource AppGradient.Sidebar.Separator}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,4">
                            <RadioButton Content="Home"
                                         Tag="{x:Static res:Glyphs.Home}"
                                         GroupName="MainMenu"
                                         Style="{StaticResource Radio.Menu}"
                                         Command="{Binding HomeViewCommand}"
                                         IsChecked="{Binding SelectedView, Mode=TwoWay,
                                                     Converter={StaticResource EnumEqualsConverter},
                                                     ConverterParameter={x:Static enums:AppView.Home}}"/>

                            <RadioButton Content="User"
                                         Tag="{x:Static res:Glyphs.User}"
                                         GroupName="MainMenu"
                                         Style="{StaticResource Radio.Menu}"
                                         Command="{Binding UserCommand}"
                                         IsChecked="{Binding SelectedView, Mode=TwoWay,
                                                     Converter={StaticResource EnumEqualsConverter},
                                                     ConverterParameter={x:Static enums:AppView.User}}"/>

                            <RadioButton Content="Computer"
                                         Tag="{x:Static res:Glyphs.Computer}"
                                         GroupName="MainMenu"
                                         Style="{StaticResource Radio.Menu}"
                                         Command="{Binding ComputerCommand}"
                                         IsChecked="{Binding SelectedView, Mode=TwoWay,
                                                     Converter={StaticResource EnumEqualsConverter},
                                                     ConverterParameter={x:Static enums:AppView.Computer}}"/>

                            <RadioButton Content="Groups"
                                         Tag="{x:Static res:Glyphs.Group}"
                                         GroupName="MainMenu"
                                         Style="{StaticResource Radio.Menu}"
                                         Command="{Binding GroupCommand}"
                                         IsChecked="{Binding SelectedView, Mode=TwoWay,
                                                     Converter={StaticResource EnumEqualsConverter},
                                                     ConverterParameter={x:Static enums:AppView.Group}}"/>

                            <RadioButton Content="Entra"
                                         Tag="{x:Static res:Glyphs.Entra}"
                                         GroupName="MainMenu"
                                         Style="{StaticResource Radio.Menu}"
                                         Command="{Binding EntraCommand}"
                                         IsChecked="{Binding SelectedView, Mode=TwoWay,
                                                     Converter={StaticResource EnumEqualsConverter},
                                                     ConverterParameter={x:Static enums:AppView.Entra}}"/>

                            <RadioButton Content="Links"
                                         Tag="{x:Static res:Glyphs.Links}"
                                         GroupName="MainMenu"
                                         Style="{StaticResource Radio.Menu}"
                                         Command="{Binding LinksCommand}"
                                         IsChecked="{Binding SelectedView, Mode=TwoWay,
                                                     Converter={StaticResource EnumEqualsConverter},
                                                     ConverterParameter={x:Static enums:AppView.Links}}"/>

                            <RadioButton Content="About"
                                         Tag="{x:Static res:Glyphs.About}"
                                         GroupName="MainMenu"
                                         Style="{StaticResource Radio.Menu}"
                                         Command="{Binding AboutCommand}"
                                         IsChecked="{Binding SelectedView, Mode=TwoWay,
                                                     Converter={StaticResource EnumEqualsConverter},
                                                     ConverterParameter={x:Static enums:AppView.About}}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1">

                        <RadioButton Content="Admin"
             Style="{StaticResource Radio.Menu}"
             Command="{Binding AdminCommand}"
             Visibility="{Binding ShowAdminView, Converter={StaticResource BoolToVis}}"
             IsChecked="{Binding SelectedView, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:AppView.Admin}}" />
                        <RadioButton Content="Settings"
                                     Tag="{x:Static res:Glyphs.Settings}"
                                     GroupName="MainMenu"
                                     Style="{StaticResource Radio.Menu}"
                                     Command="{Binding SettingsCommand}"
                                     Margin="0,12,0,6"
                                     IsChecked="{Binding SelectedView, Mode=TwoWay,
                                                 Converter={StaticResource EnumEqualsConverter},
                                                 ConverterParameter={x:Static enums:AppView.Settings}}"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- NOTE: separator Border removed to eliminate the second line -->

            <!-- Main content -->
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ComboBox Width="250"
                          Margin="5"
                          VerticalAlignment="Top"
                          Style="{StaticResource ComboBox.Search}"
                          Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding SearchHistory}"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          StaysOpenOnEdit="True"
                          PreviewMouseDown="SearchBox_ShowHistory"
                          PreviewTextInput="SearchBox_PreviewTextInput">
                    <ComboBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ExecuteSearchCommand}"/>
                    </ComboBox.InputBindings>
                </ComboBox>

                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentView}"
                                CacheMode="BitmapCache"
                                Style="{StaticResource Fx.SlideFadeHost}"/>
            </Grid>
        </DockPanel>
    </Border>
</Window>
