<Window x:Class="DSAMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DSAMVVM"
        xmlns:viewModel="clr-namespace:DSAMVVM.MVVM.ViewModel"
        xmlns:view="clr-namespace:DSAMVVM.MVVM.View"
        mc:Ignorable="d"
        Height="600" Width="920"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        Title="Support App">



    <Border Background="#071732" CornerRadius="20" Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
        </Border.Effect>

        <DockPanel LastChildFill="True">

            <!-- Status Bar -->
            <view:StatusBarView DockPanel.Dock="Bottom"
                                 DataContext="{Binding StatusBar}"
                                 Margin="10,0,10,10" />

            <!-- Header -->
            <Grid DockPanel.Dock="Top" Height="40" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title (draggable area) -->
                <TextBlock Text="Support App"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Foreground="White"
                           Margin="20,0,0,0"
                           MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

                <!-- Window buttons -->
                <StackPanel Orientation="Horizontal"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="0,0,10,0">
                    <Button Style="{StaticResource RoundedWindowButtonStyle}"
                            Content="—"
                            Click="Minimize_Click"
                            Margin="0,0,5,0" />

                    <Button Style="{StaticResource RoundedWindowButtonStyle}"
                            Content="X"
                            Click="Close_Click" />

                </StackPanel>
            </Grid>

            <!-- Sidebar -->
            <Grid DockPanel.Dock="Left" Width="200" Background="Transparent" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top nav (scrollable) -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <RadioButton Content="Home"     GroupName="MainMenu"
                         Height="50" Foreground="White" FontSize="14"
                         Style="{StaticResource MenuButtonTheme}" IsChecked="True"
                         Command="{Binding HomeViewCommand}" />

                        <RadioButton Content="User"     GroupName="MainMenu"
                         Height="50" Foreground="White" FontSize="14"
                         Style="{StaticResource MenuButtonTheme}"
                         Command="{Binding UserCommand}" />

                        <RadioButton Content="Computer" GroupName="MainMenu"
                         Height="50" Foreground="White" FontSize="14"
                         Style="{StaticResource MenuButtonTheme}"
                         Command="{Binding ComputerCommand}" />

                        <RadioButton Content="Groups"   GroupName="MainMenu"
                         Height="50" Foreground="White" FontSize="14"
                         Style="{StaticResource MenuButtonTheme}"
                         Command="{Binding GroupCommand}" />

                        <RadioButton Content="Entra"    GroupName="MainMenu"
                         Height="50" Foreground="White" FontSize="14"
                         Style="{StaticResource MenuButtonTheme}"
                         Command="{Binding EntraCommand}" />

                        <RadioButton Content="Links"    GroupName="MainMenu"
                         Height="50" Foreground="White" FontSize="14"
                         Style="{StaticResource MenuButtonTheme}"
                         Command="{Binding LinksCommand}" />

                        <RadioButton Content="About"    GroupName="MainMenu"
                         Height="50" Foreground="White" FontSize="14"
                         Style="{StaticResource MenuButtonTheme}"
                         Command="{Binding AboutCommand}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom pinned -->
                <RadioButton Grid.Row="1" GroupName="MainMenu"
                 Content="Settings"
                 Height="50"
                 Foreground="White"
                 FontSize="14"
                 Style="{StaticResource MenuButtonTheme}"
                 Command="{Binding SettingsCommand}"
                 Margin="0,0,0,10" />
            </Grid>


            <!-- Main content -->
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
             <!-- Search Box -->
                <ComboBox Width="250"
          Height="40"
          Margin="5"
          VerticalAlignment="Top"
          Style="{StaticResource SearchComboTheme}"
          Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
          ItemsSource="{Binding SearchHistory}"
          IsEditable="True"
          IsTextSearchEnabled="False"
          StaysOpenOnEdit="True"
          PreviewMouseDown="SearchBox_ShowHistory"
          PreviewTextInput="SearchBox_PreviewTextInput">
                    <ComboBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ExecuteSearchCommand}" />
                    </ComboBox.InputBindings>
                </ComboBox>







                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentView}" />
            </Grid>

        </DockPanel>
    </Border>
</Window>
