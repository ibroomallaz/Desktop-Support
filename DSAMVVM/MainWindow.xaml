<Window x:Class="DSAMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModel="clr-namespace:DSAMVVM.MVVM.ViewModel"
        xmlns:view="clr-namespace:DSAMVVM.MVVM.View"
        xmlns:enums="clr-namespace:DSAMVVM.Core.Enums"
        xmlns:util="clr-namespace:DSAMVVM.Core.Utilities"
        xmlns:res="clr-namespace:DSAMVVM.MVVM.View.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModel:MainViewModel}"
        Height="600" Width="920"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        Title="{Binding WindowTitle, Mode=OneWay, FallbackValue={x:Static res:Strings.App_Title}, TargetNullValue={x:Static res:Strings.App_Title}}">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo Overlay="{Binding TaskbarOverlayIcon}"
                         Description="{Binding TaskbarDescription}"/>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <ResourceDictionary>
            <!-- geometry -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <CornerRadius x:Key="AppCorner.All">20</CornerRadius>
            <!-- sidebar: round top-right-->
            <CornerRadius x:Key="AppCorner.Sidebar">20,20,0,20</CornerRadius>

            <util:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer shell: blue ramp with soft shadow -->
    <Border Background="{StaticResource AppGradient.Window.Blue}"
            CornerRadius="{StaticResource AppCorner.All}"
            Padding="0"
            ClipToBounds="True"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <DockPanel LastChildFill="True" UseLayoutRounding="True" SnapsToDevicePixels="True">

            <!-- Status bar docked at bottom: pushes layout, never obscures or blocks components -->
            <view:StatusBarView DockPanel.Dock="Bottom"
                                DataContext="{Binding StatusBar}"/>

            <!-- Header -->
            <Grid DockPanel.Dock="Top"
                  Height="40"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Title column: Nav Toggle Button + Support App title -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,10,0">
                    <Button Style="{StaticResource Button.Rounded.Small}"
                            Content="{Binding SidebarToggleGlyph}"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="{Binding SidebarToggleToolTip}"
                            Margin="0,0,10,0"/>

                    <TextBlock Text="{x:Static res:Strings.App_Title}"
                               VerticalAlignment="Center"
                               FontSize="18"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False"/>
                </StackPanel>

                <!-- Content header column: perfectly aligned over the views -->
                <Grid Grid.Column="1">
                    <!-- Search Omnibar centered directly over the view content area -->
                    <ComboBox Width="280"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Style="{StaticResource ComboBox.Search}"
                              Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding SearchHistory}"
                              Tag="{Binding SearchWatermark}"
                              IsEnabled="{Binding IsSearchEnabled}"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              PreviewMouseDown="SearchBox_ShowHistory"
                              PreviewTextInput="SearchBox_PreviewTextInput">
                        <ComboBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ExecuteSearchCommand}"/>
                        </ComboBox.InputBindings>
                    </ComboBox>

                    <!-- Window control buttons pinned to the far right -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <Button Style="{StaticResource Button.Rounded.Small}"
                                Content="{x:Static res:Glyphs.Warning}"
                                FontFamily="Segoe MDL2 Assets"
                                Click="FeedbackButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                    <MenuItem Header="{x:Static res:Strings.Feedback_ReportBug}" Command="{Binding OpenFeedbackCommand}" CommandParameter="0"/>
                                    <MenuItem Header="{x:Static res:Strings.Feedback_RequestFeature}" Command="{Binding OpenFeedbackCommand}" CommandParameter="1"/>
                                    <MenuItem Header="{x:Static res:Strings.Feedback_UpdateSupportTeam}" Command="{Binding OpenFeedbackCommand}" CommandParameter="2"/>
                                    <MenuItem Header="{x:Static res:Strings.Feedback_AddNote}" Command="{Binding OpenFeedbackCommand}" CommandParameter="3"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button Style="{StaticResource Button.Rounded.Small}"
                                Content="{x:Static res:Glyphs.ChromeMinimize}"
                                FontFamily="Segoe MDL2 Assets"
                                ToolTip="Minimize"
                                Click="Minimize_Click" />

                        <Button Style="{StaticResource Button.Rounded.Small}"
                                Content="{x:Static res:Glyphs.ChromeClose}"
                                FontFamily="Segoe MDL2 Assets"
                                ToolTip="Close"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Sidebar: top-right rounded + single right-edge separator -->
            <Border DockPanel.Dock="Left"
                    Panel.ZIndex="1"
                    ClipToBounds="True"
                    Background="{StaticResource AppGradient.Sidebar.Background}"
                    Padding="0,8,0,8"
                    SnapsToDevicePixels="True"
                    CornerRadius="{StaticResource AppCorner.Sidebar}"
                    BorderThickness="0,0,3,0"
                    BorderBrush="{StaticResource AppGradient.Sidebar.Separator}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="200"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactSidebar}" Value="True">
                                <Setter Property="Width" Value="56"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ListBox ItemsSource="{Binding PrimaryNavItems}"
                                 SelectedValue="{Binding SelectedView, Mode=TwoWay}"
                                 SelectedValuePath="View"
                                 Style="{StaticResource Nav.ListBox}"/>
                    </ScrollViewer>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FooterNavItems}"
                             SelectedValue="{Binding SelectedView, Mode=TwoWay}"
                             SelectedValuePath="View"
                             Style="{StaticResource Nav.ListBox}"/>

                </Grid>
            </Border>

            <!-- Main content -->
            <Grid Margin="10">
                <ContentControl Content="{Binding CurrentView}"
                                CacheMode="BitmapCache"
                                Style="{StaticResource Fx.SlideFadeHost}"/>
            </Grid>
        </DockPanel>
    </Border>
</Window>
