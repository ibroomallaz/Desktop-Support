<Window x:Class="DSAMVVM.MVVM.View.Overlays.QuickSearchOverlayView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickSearch" Width="500"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="#282828" CornerRadius="8" BorderBrush="#444" BorderThickness="1" Padding="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Opacity="0.5" ShadowDepth="5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="QUICK Search" Foreground="#888" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>

            <TextBox x:Name="SearchBox" Grid.Row="1" FontSize="24" Background="Transparent" 
                     Foreground="White" BorderThickness="0" CaretBrush="White" Margin="0,0,0,10"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#333"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Margin" Value="5,0,0,0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                </StackPanel.Resources>

                <Button Content="_User" Click="BtnUser_Click" ToolTip="Alt + U"/>
                <Button Content="_Computer" Click="BtnComputer_Click" ToolTip="Alt + C"/>
                <Button Content="_Group" Click="BtnGroup_Click" ToolTip="Alt + G"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Text="Searching..." Foreground="#888" Margin="0,15,0,0"
                       Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>

            <FlowDocumentReader Grid.Row="3" Document="{Binding ResultDocument}" 
                                ViewingMode="Scroll" Margin="0,15,0,0" MaxHeight="400"
                                Background="Transparent" BorderThickness="0"/>
        </Grid>
    </Border>
</Window>