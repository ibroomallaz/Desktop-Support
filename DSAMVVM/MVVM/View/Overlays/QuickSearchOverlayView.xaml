<Window x:Class="DSAMVVM.MVVM.View.Overlays.QuickSearchOverlayView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:DSAMVVM.MVVM.Model.Behaviors"
        Title="QuickSearch" Width="500"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Surface}" 
            CornerRadius="8" 
            BorderBrush="{DynamicResource Brush.Border}" 
            BorderThickness="1" 
            Padding="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Opacity="0.5" ShadowDepth="5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="DragBorder_MouseDown" Margin="0,0,0,5">
                <TextBlock Text="QUICK SEARCH" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" FontWeight="Bold" />
            </Border>

            <TextBox x:Name="SearchBox" Grid.Row="1" FontSize="24" Background="Transparent" 
                     Foreground="{DynamicResource Brush.Text.Primary}" BorderThickness="0" 
                     CaretBrush="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,10"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                <Button Content="User" Click="BtnUser_Click" ToolTip="Enter" Style="{DynamicResource Button.Rounded}"/>
                <Button Content="Computer" Click="BtnComputer_Click" ToolTip="Shift + Enter" Style="{DynamicResource Button.Rounded}"/>
                <Button x:Name="BtnGroupTarget" Content="Group" Click="BtnGroup_Click" ToolTip="Ctrl + Enter" Style="{DynamicResource Button.Rounded}"/>
            </StackPanel>
            
            <TextBlock Grid.Row="3" Text="Searching..." Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,15,0,0"
                       Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>

            <FlowDocumentScrollViewer Grid.Row="3" 
                                      behaviors:FlowDocBinder.Text="{Binding ResultText}"
                                      behaviors:FlowDocBinder.ViewName="QuickSearchView"
                                      VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,15,0,0" MaxHeight="400"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{DynamicResource Brush.Text.Primary}"/>
        </Grid>
    </Border>
</Window>