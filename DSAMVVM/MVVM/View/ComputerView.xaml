<UserControl x:Class="DSAMVVM.MVVM.View.ComputerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DSAMVVM.MVVM.ViewModel"
             xmlns:res="clr-namespace:DSAMVVM.MVVM.View.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ComputerViewModel}"
             d:DesignHeight="600" d:DesignWidth="850">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theme/Colors/Colors.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Decor/Gradient.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/Button.Rounded.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/Button.FlowDoc.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/Card.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <!-- Subtle Link Button -->
            <Style x:Key="InlineLinkButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Info.Light}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Info.Hover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Compact Ghost Button -->
            <Style x:Key="GhostActionButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Active}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Pill Button for Hostname Copy -->
            <Style x:Key="ChipButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.1}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Brush.Border.Active}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Collapsed Row Header Button -->
            <Style x:Key="CollapsedRowButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.1}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RowBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource CardGradient.Surface.Hover}"/>
                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border.Active}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Empty State Container -->
        <Border Grid.Row="0"
                CornerRadius="10"
                Background="{DynamicResource Brush.Surface.1}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                Padding="30">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasHistory}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{x:Static res:Glyphs.Computer}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="32"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           Opacity="0.5"
                           Margin="0,0,0,12"/>

                <TextBlock Text="No Computer Lookups Yet"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Enter a hostname in the search bar above and press Enter."
                           FontSize="12"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- History Feed ScrollViewer -->
        <ScrollViewer x:Name="HistoryScrollViewer"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasHistory}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ComputerHistoryItemViewModel}">
                        <Grid Margin="0,0,0,6">

                            <!-- ============================================== -->
                            <!-- STATE A: COLLAPSED SUMMARY ROW                 -->
                            <!-- ============================================== -->
                            <Button Command="{Binding ToggleExpandCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CollapsedRowButton}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                        <ColumnDefinition Width="Auto"/> <!-- Hostname -->
                                        <ColumnDefinition Width="Auto"/> <!-- OS Badge -->
                                        <ColumnDefinition Width="Auto"/> <!-- Status Badges -->
                                        <ColumnDefinition Width="*"/>    <!-- OU path / Description -->
                                        <ColumnDefinition Width="Auto"/> <!-- Timestamp / Stale -->
                                        <ColumnDefinition Width="Auto"/> <!-- Dismiss / Clear Individual Record -->
                                        <ColumnDefinition Width="Auto"/> <!-- Chevron -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Computer Icon -->
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Static res:Glyphs.Computer}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                    <!-- Hostname -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ComputerName}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                    <!-- OS Badge -->
                                    <Border Grid.Column="2" CornerRadius="4" Background="#122438" BorderBrush="#1D3D5E" BorderThickness="1" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OperatingSystem}" FontSize="10" FontWeight="SemiBold" Foreground="#6EC3FF"/>
                                    </Border>

                                    <!-- Status Badges Cluster -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <!-- Not Found Badge -->
                                        <Border CornerRadius="4" Background="#3A1418" BorderBrush="#63232A" BorderThickness="1" Padding="5,1" Margin="0,0,4,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFound}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Not Found" FontSize="10" FontWeight="SemiBold" Foreground="#FF7B88"/>
                                        </Border>

                                        <!-- Disabled Badge -->
                                        <Border CornerRadius="4" Background="#3A1418" BorderBrush="#63232A" BorderThickness="1" Padding="5,1" Margin="0,0,4,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Disabled" FontSize="10" FontWeight="SemiBold" Foreground="#FF7B88"/>
                                        </Border>

                                        <!-- In Hybrid Group Badge -->
                                        <Border CornerRadius="4" Background="#281738" BorderBrush="#5B2E84" BorderThickness="1" Padding="5,1" Margin="0,0,4,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHybridGroupMember}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="In Hybrid Group" FontSize="10" FontWeight="Bold" Foreground="#D8B4FE"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- OU Path / Description in Collapsed Row -->
                                    <TextBlock Grid.Column="4"
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding CleanOuPath}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDescription}" Value="True">
                                                        <Setter Property="Text">
                                                            <Setter.Value>
                                                                <MultiBinding StringFormat="{}{0}  •  {1}">
                                                                    <Binding Path="Description"/>
                                                                    <Binding Path="CleanOuPath"/>
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Timestamp on right -->
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding TimeFormatted}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                    <!-- Dismiss / Clear Record Button in Collapsed Row -->
                                    <Button Grid.Column="6"
                                            Style="{StaticResource InlineLinkButton}"
                                            Command="{Binding RemoveCommand}"
                                            ToolTip="Clear this record from history"
                                            Margin="0,0,8,0"
                                            Padding="4,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="&#xE711;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    </Button>

                                    <!-- Chevron down icon -->
                                    <TextBlock Grid.Column="7"
                                               Text="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- ============================================== -->
                            <!-- STATE B: EXPANDED CARD                         -->
                            <!-- ============================================== -->
                            <Border CornerRadius="10"
                                    Background="{DynamicResource CardGradient.Surface.L1}"
                                    BorderBrush="{DynamicResource Brush.Card.Border}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.2"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>  <!-- Red Accent Stripe -->
                                        <ColumnDefinition Width="*"/>  <!-- Main Card Body -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Accent Stripe -->
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource Brush.Accent.Red}"
                                            CornerRadius="10,0,0,10"/>

                                    <!-- Card Content -->
                                    <Grid Grid.Column="1" Margin="14,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- Header -->
                                            <RowDefinition Height="Auto"/> <!-- Divider -->
                                            <RowDefinition Height="*"/>    <!-- 2-Column Body -->
                                        </Grid.RowDefinitions>

                                        <!-- 1. Header: Glyph, Name, Copy Chip, Badges, Actions -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                                <ColumnDefinition Width="*"/>    <!-- Name + Badges -->
                                                <ColumnDefinition Width="Auto"/> <!-- Time + Actions -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Computer Glyph Icon -->
                                            <Border Grid.Column="0"
                                                    Width="34" Height="34"
                                                    CornerRadius="17"
                                                    Background="{DynamicResource Brush.Surface.Hover}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Static res:Glyphs.Computer}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="16"
                                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Hostname and Badges -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Hostname Copy Chip Button -->
                                                    <Button Style="{StaticResource ChipButton}"
                                                            Command="{Binding CopyNameCommand}"
                                                            ToolTip="Click to copy hostname to clipboard"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ComputerName}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Brush.Text.Primary}"/>

                                                            <!-- Copy Icon (default) -->
                                                            <TextBlock Text=" &#xE8C8;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- Copied Checkmark Feedback -->
                                                            <TextBlock Text=" ✓ Copied"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="#5CDA89"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- OS Badge -->
                                                    <Border CornerRadius="4" Background="#122438" BorderBrush="#1D3D5E" BorderThickness="1" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding OperatingSystem}" FontSize="10" FontWeight="SemiBold" Foreground="#6EC3FF"/>
                                                    </Border>

                                                    <!-- In Hybrid Devices Group Badge -->
                                                    <Border CornerRadius="4" Background="#281738" BorderBrush="#6C3BAA" BorderThickness="1" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                            ToolTip="Device is a member of 'UA-MEMHybridDevices' group">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHybridGroupMember}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="In Hybrid Devices Group" FontSize="10" FontWeight="Bold" Foreground="#E9D5FF"/>
                                                    </Border>

                                                    <!-- Disabled Badge -->
                                                    <Border CornerRadius="4" Background="#3A1418" BorderBrush="#63232A" BorderThickness="1" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="Disabled" FontSize="10" FontWeight="Bold" Foreground="#FF7B88"/>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Right side of Header: Stale Indicator, Timestamp, Refresh, Chevron Up -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Stale Indicator -->
                                                <Border CornerRadius="4" Background="#382810" BorderBrush="#5C421A" BorderThickness="1" Padding="5,1" Margin="0,0,6,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding RelativeAgeText, StringFormat='searched {0}'}" FontSize="10" Foreground="#FFC069" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Normal Timestamp (when not stale) -->
                                                <TextBlock Text="{Binding TimeFormatted}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Refresh Entry Button -->
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding RefreshCommand}"
                                                        ToolTip="Re-query Active Directory for this computer"
                                                        Padding="5,3"
                                                        Margin="0,0,4,0">
                                                    <TextBlock Text="&#xE72C;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                </Button>

                                                <!-- Collapse Button (Chevron Up) -->
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding ToggleExpandCommand}"
                                                        ToolTip="Collapse card"
                                                        Padding="5,3"
                                                        Margin="0,0,4,0">
                                                    <TextBlock Text="&#xE70E;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                </Button>

                                                <!-- Remove / Clear Record Button -->
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding RemoveCommand}"
                                                        ToolTip="Remove this record from history"
                                                        Padding="5,3">
                                                    <TextBlock Text="&#xE711;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 2. Divider -->
                                        <Border Grid.Row="1"
                                                Height="1"
                                                Background="{DynamicResource Brush.Border}"
                                                Margin="0,8,0,8"/>

                                        <!-- If Computer Not Found Error -->
                                        <Border Grid.Row="2"
                                                Background="#251214"
                                                BorderBrush="#4B171A"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,8"
                                                Margin="0,4,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFound}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="Computer Not Found in Active Directory"
                                                           FontWeight="Bold"
                                                           Foreground="#FF7B88"
                                                           FontSize="12"
                                                           Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding ErrorMessage}"
                                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 3. Two-Column Body -->
                                        <Grid Grid.Row="2">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFound}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/> <!-- Spacer -->
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- =================== LEFT COLUMN: IDENTITY & LOCATION =================== -->
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource Brush.Surface.1}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8">
                                                <StackPanel>
                                                    <TextBlock Text="SYSTEM &amp; DOMAIN IDENTITY"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                                               Margin="0,0,0,6"/>

                                                    <!-- Operating System -->
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock Text="Operating System: " FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" DockPanel.Dock="Left"/>
                                                        <TextBlock Text="{Binding OperatingSystem}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                    </DockPanel>

                                                    <!-- Hybrid Device Group Membership -->
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock Text="Hybrid Group: " FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" DockPanel.Dock="Left"/>
                                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Not in UA-MEMHybridDevices"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsHybridGroupMember}" Value="True">
                                                                            <Setter Property="Text" Value="In UA-MEMHybridDevices"/>
                                                                            <Setter Property="Foreground" Value="#D8B4FE"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DockPanel>

                                                    <!-- OU Location Breadcrumbs -->
                                                    <StackPanel Margin="0,0,0,2">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasOUs}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="Organizational Unit (OU): " FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                        <TextBlock Text="{Binding CleanOuPath}" FontSize="10.5" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- =================== RIGHT COLUMN: ACTIVITY & STATUS =================== -->
                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource Brush.Surface.1}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8">
                                                <StackPanel>
                                                    <TextBlock Text="ACTIVITY &amp; STATUS"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                                               Margin="0,0,0,6"/>

                                                    <!-- Last Logon Activity -->
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock Text="Last Logon: " FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" DockPanel.Dock="Left"/>
                                                        <TextBlock Text="{Binding LastLogonDate}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                    </DockPanel>

                                                    <!-- Account Status -->
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock Text="Account Status: " FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" DockPanel.Dock="Left"/>
                                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Enabled"/>
                                                                    <Setter Property="Foreground" Value="#5CDA89"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                            <Setter Property="Text" Value="Disabled"/>
                                                                            <Setter Property="Foreground" Value="#FF7B88"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DockPanel>

                                                    <!-- Description / Notes -->
                                                    <StackPanel Margin="0,2,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasDescription}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="Description / Notes: " FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                <ColumnDefinition Width="*"/>    <!-- Spacer -->
                <ColumnDefinition Width="Auto"/> <!-- Font / Scaling Controls -->
            </Grid.ColumnDefinitions>

            <!-- Left Buttons: Clear, Collapse All, Expand All -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Clear"
                        Command="{Binding ClearCommand}"
                        Style="{DynamicResource Button.FlowDoc}"
                        Margin="0,0,8,0"
                        ToolTip="Clear search history"/>

                <Button Content="Collapse All"
                        Command="{Binding CollapseAllCommand}"
                        Style="{DynamicResource Button.FlowDoc}"
                        Margin="0,0,8,0"
                        ToolTip="Collapse all history cards to single-line summaries"/>

                <Button Content="Expand All"
                        Command="{Binding ExpandAllCommand}"
                        Style="{DynamicResource Button.FlowDoc}"
                        ToolTip="Expand all history cards"/>
            </StackPanel>

            <!-- Right Buttons: Font Sizing -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="A−"
                        Command="{Binding DecreaseFontCommand}"
                        Style="{DynamicResource Button.FlowDoc.Small}"
                        ToolTip="Decrease text size"/>
                <Button Content="A"
                        Command="{Binding ResetFontCommand}"
                        Style="{DynamicResource Button.FlowDoc.Small}"
                        ToolTip="Reset text size"/>
                <Button Content="A+"
                        Command="{Binding IncreaseFontCommand}"
                        Style="{DynamicResource Button.FlowDoc.Small}"
                        Margin="6,0,0,0"
                        ToolTip="Increase text size"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
