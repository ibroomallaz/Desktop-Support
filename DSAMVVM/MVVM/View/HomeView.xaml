<UserControl x:Class="DSAMVVM.MVVM.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:res="clr-namespace:DSAMVVM.MVVM.View.Resources"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Card hover/press overlay button -->
        <Style x:Key="CardOverlayButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Overlay" Background="{TemplateBinding Background}" Opacity="0" CornerRadius="10"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#25FFFFFF"/>
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.40"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#40FFFFFF"/>
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Text Link Button -->
        <Style x:Key="SubtleLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter x:Name="ContentHost"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Info.Light}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic Colored Pill Button for Recent Queries -->
        <Style x:Key="RecentPillButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{Binding PillBg}"
                                BorderBrush="{Binding PillBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="9,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#80FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Padding="14,4,14,10"
            Background="Transparent"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">

        <Grid VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Main Body (Left Hub + Right ServiceMeow) -->
            </Grid.RowDefinitions>

            <!-- ===================== HEADER ===================== -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               FontSize="22"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding Subtitle}"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               FontSize="12"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Network Type Status Badge -->
                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtleLinkButton}"
                        Command="{Binding RefreshNetworkStatusCommand}"
                        ToolTip="{Binding NetworkStatusToolTip}">
                    <Border CornerRadius="12"
                            Background="#18FFFFFF"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1"
                            Padding="11,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NetworkStatusGlyph}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.Info.Light}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0"/>
                            <Ellipse Width="7" Height="7" Fill="{Binding NetworkStatusDotColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding NetworkStatusText}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>

            <!-- ===================== MAIN 2-COLUMN BODY ===================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.18*"/>
                    <!-- Left Column: Streamlined Status, Recent Activity, Shortcuts -->
                    <ColumnDefinition Width="14"/>
                    <!-- Spacer -->
                    <ColumnDefinition Width="1.0*"/>
                    <!-- Right Column: ServiceMeow Hero Box -->
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT COLUMN ================= -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Slim Unified Status Ribbon -->
                        <RowDefinition Height="Auto"/>
                        <!-- Recent Activity Chips -->
                        <RowDefinition Height="*"/>
                        <!-- Quick Shortcuts with Color Variation -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Slim Unified Environment Status Ribbon (saves 35px height, eliminates box clutter) -->
                    <Border Grid.Row="0"
                            Margin="0,0,0,12"
                            Height="44"
                            CornerRadius="10"
                            Background="{DynamicResource CardGradient.Surface.L1}"
                            BorderBrush="{DynamicResource Brush.Card.Border}"
                            BorderThickness="1"
                            Padding="10,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <!-- Divider -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Entra ID Status -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static res:Glyphs.Entra}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="#5BC3FF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <Ellipse Width="6" Height="6" Fill="#3CD070" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Entra:"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding EntraAccountName}"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Vertical Divider -->
                            <Rectangle Grid.Column="1" Fill="#25FFFFFF" Height="22" VerticalAlignment="Center" Margin="6,0"/>

                            <!-- Right: Active Directory DC Status -->
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE774;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="#5BC3FF"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <Ellipse Width="6" Height="6" Fill="#3CD070" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="AD:"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding DcStatusText}"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Style="{StaticResource SubtleLinkButton}"
                                        VerticalAlignment="Center"
                                        ToolTip="Probe Active Directory Domain Controllers"
                                        Command="{Binding TestDcCommand}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72C;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBlock Text="Test"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Row 1: Recent Activity ("Jump Back In") -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE81C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.Info.Light}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="Recent Activity"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="· Quick Jump"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           FontSize="11"
                                           Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Recent Activity Colored Chips -->
                        <ItemsControl ItemsSource="{Binding RecentActivities}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RecentPillButton}"
                                            Margin="0,0,8,6"
                                            Command="{Binding ActionCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="{Binding IconColor}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TypeTag}"
                                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                                       FontSize="10"
                                                       Margin="5,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Row 2: Customizable Quick Shortcuts with Color Variations -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Section Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static res:Glyphs.Links}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.Info.Light}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="Quick Shortcuts"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource SubtleLinkButton}"
                                    VerticalAlignment="Center"
                                    Command="{Binding CustomizeShortcutsCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE713;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0"/>
                                    <TextBlock Text="Customize"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 2x2 Shortcuts Grid with Jewel-Tone Theme Variations -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Shortcuts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="3"
                                            MinHeight="56"
                                            CornerRadius="10"
                                            Background="{Binding AccentBg}"
                                            BorderBrush="{Binding AccentBorder}"
                                            BorderThickness="1"
                                            Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Distinct Colored Icon Plate with High-Contrast Foreground -->
                                            <Border Grid.Column="0"
                                                    Width="30"
                                                    Height="30"
                                                    CornerRadius="7"
                                                    Background="#20FFFFFF"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Icon}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="15"
                                                           Foreground="{Binding AccentFg}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                            </Border>

                                            <!-- Title & Subtitle -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{Binding AccentFg}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                                           FontSize="10"
                                                           Margin="0,1,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Click Overlay Button -->
                                            <Button Grid.ColumnSpan="2"
                                                    Style="{StaticResource CardOverlayButton}"
                                                    Command="{Binding OpenCommand}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>

                <!-- ================= RIGHT COLUMN: SERVICEMEOW HERO BOX ================= -->
                <Border Grid.Column="2"
                        CornerRadius="12"
                        Background="{DynamicResource CardGradient.Surface.L1}"
                        BorderBrush="{DynamicResource Brush.Card.Border}"
                        BorderThickness="1"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- ServiceMeow Header -->
                            <RowDefinition Height="*"/>
                            <!-- Large Hero Pet Photo Frame (Dynamic Height) -->
                            <RowDefinition Height="Auto"/>
                            <!-- Pet Bio & Role -->
                            <RowDefinition Height="Auto"/>
                            <!-- Fun Fact Callout -->
                            <RowDefinition Height="Auto"/>
                            <!-- Footer & Submit Link -->
                        </Grid.RowDefinitions>

                        <!-- Header with Crimson Mascot Tag -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🐾 ServiceMeow"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           FontSize="15"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    CornerRadius="6"
                                    Background="{Binding CurrentPet.AccentTagBg}"
                                    BorderBrush="{Binding CurrentPet.AccentTagColor}"
                                    BorderThickness="1"
                                    Padding="7,2">
                                <TextBlock Text="Support Mascot"
                                           Foreground="{Binding CurrentPet.AccentTagColor}"
                                           FontSize="9"
                                           FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <!-- Large Hero Pet Photo Frame (Expanded to 215+ px tall for maximum visual delight) -->
                        <Border Grid.Row="1"
                                MinHeight="210"
                                CornerRadius="12"
                                Background="#0B111A"
                                BorderBrush="#253549"
                                BorderThickness="1"
                                ClipToBounds="True"
                                Margin="0,0,0,8">
                            <Grid>
                                <!-- Rich Ambient Colored Radial Aura -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <RadialGradientBrush Center="0.5,0.45" RadiusX="0.65" RadiusY="0.65">
                                            <GradientStop Color="#45263B" Offset="0.0"/>
                                            <GradientStop Color="#1F1E2C" Offset="0.55"/>
                                            <GradientStop Color="#090E17" Offset="1.0"/>
                                        </RadialGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- Large Stylized Mascot Vector Graphic -->
                                <Viewbox Width="145" Height="145" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Canvas Width="100" Height="100">
                                        <!-- Cat Ears -->
                                        <Path Data="M 28,45 L 18,16 L 43,30 Z" Fill="#5A6D8C"/>
                                        <Path Data="M 30,42 L 23,22 L 40,31 Z" Fill="#FFAEC0" Opacity="0.6"/>
                                        <Path Data="M 72,45 L 82,16 L 57,30 Z" Fill="#5A6D8C"/>
                                        <Path Data="M 70,42 L 77,22 L 60,31 Z" Fill="#FFAEC0" Opacity="0.6"/>
                                        <!-- Head -->
                                        <Ellipse Canvas.Left="18" Canvas.Top="28" Width="64" Height="54" Fill="#6E84A7"/>
                                        <!-- Chubby Cheeks -->
                                        <Ellipse Canvas.Left="20" Canvas.Top="52" Width="20" Height="16" Fill="#FFAEC0" Opacity="0.25"/>
                                        <Ellipse Canvas.Left="60" Canvas.Top="52" Width="20" Height="16" Fill="#FFAEC0" Opacity="0.25"/>
                                        <!-- Eyes -->
                                        <Ellipse Canvas.Left="34" Canvas.Top="46" Width="8" Height="12" Fill="#0E1624"/>
                                        <Ellipse Canvas.Left="36" Canvas.Top="48" Width="3" Height="4" Fill="#FFFFFF"/>
                                        <Ellipse Canvas.Left="58" Canvas.Top="46" Width="8" Height="12" Fill="#0E1624"/>
                                        <Ellipse Canvas.Left="60" Canvas.Top="48" Width="3" Height="4" Fill="#FFFFFF"/>
                                        <!-- Nose & Snout -->
                                        <Path Data="M 47,59 L 53,59 L 50,63 Z" Fill="#FFAEC0"/>
                                        <Path Data="M 50,63 Q 46,67 41,65" Stroke="#0E1624" StrokeThickness="1.6"/>
                                        <Path Data="M 50,63 Q 54,67 59,65" Stroke="#0E1624" StrokeThickness="1.6"/>
                                        <!-- Whiskers -->
                                        <Line X1="16" Y1="56" X2="36" Y2="59" Stroke="#C2D1E0" StrokeThickness="1.4"/>
                                        <Line X1="15" Y1="63" X2="36" Y2="62" Stroke="#C2D1E0" StrokeThickness="1.4"/>
                                        <Line X1="84" Y1="56" X2="64" Y2="59" Stroke="#C2D1E0" StrokeThickness="1.4"/>
                                        <Line X1="85" Y1="63" X2="64" Y2="62" Stroke="#C2D1E0" StrokeThickness="1.4"/>
                                        <!-- Red Collar with Gold Bell -->
                                        <Path Data="M 33,78 Q 50,86 67,78" Stroke="#C5355E" StrokeThickness="4" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                                        <Ellipse Canvas.Left="46" Canvas.Top="79" Width="8" Height="8" Fill="#FFD15C"/>
                                    </Canvas>
                                </Viewbox>

                                <!-- Floating Shuffle / Next Pet Button (Top Right Glass Button) -->
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="8"
                                        CornerRadius="14"
                                        Background="#660B111A"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1">
                                    <Button Width="28"
                                            Height="28"
                                            Style="{StaticResource SubtleLinkButton}"
                                            Content="&#xE72C;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            ToolTip="Shuffle / Next Mascot"
                                            Command="{Binding NextPetCommand}"/>
                                </Border>

                                <!-- Breed / Age Tag (Bottom Left Glass Tag) -->
                                <Border HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="8"
                                        CornerRadius="6"
                                        Background="#B30B111A"
                                        BorderBrush="#35FFFFFF"
                                        BorderThickness="1"
                                        Padding="8,3">
                                    <TextBlock Text="{Binding CurrentPet.Breed}"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               FontSize="10"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Pet Bio & Role -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,4">
                            <TextBlock Text="{Binding CurrentPet.Name}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       FontSize="17"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding CurrentPet.Title}"
                                       Foreground="{Binding CurrentPet.AccentTagColor}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Fun Fact Callout -->
                        <Border Grid.Row="3"
                                CornerRadius="7"
                                Background="#12FFFFFF"
                                BorderBrush="#1FFFFFFF"
                                BorderThickness="1"
                                Padding="8,5"
                                Margin="0,2,0,6">
                            <TextBlock Text="{Binding CurrentPet.FunFact}"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       FontSize="10"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Footer -->
                        <Grid Grid.Row="4" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding CurrentPet.Owner}"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       FontSize="9"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                            <Button Grid.Column="1"
                                    Style="{StaticResource SubtleLinkButton}"
                                    VerticalAlignment="Center"
                                    Command="{Binding SubmitPetCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE722;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0"/>
                                    <TextBlock Text="Submit Pet"
                                               FontSize="10"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
