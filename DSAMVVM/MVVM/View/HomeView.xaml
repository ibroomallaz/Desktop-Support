<UserControl x:Class="DSAMVVM.MVVM.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <!-- Tile hover/press overlay style -->
    <UserControl.Resources>
        <Style x:Key="TileOverlayButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Transparent by default; becomes a subtle overlay on hover/press -->
                        <Border x:Name="Overlay"
                                Background="{TemplateBinding Background}"
                                Opacity="0"
                                CornerRadius="0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.25"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Padding="{DynamicResource Space.Page}"
            Background="Transparent"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- heading -->
                <RowDefinition Height="Auto"/>
                <!-- hero -->
                <RowDefinition Height="Auto"/>
                <!-- quick panels -->
                <RowDefinition Height="Auto"/>
                <!-- tiles -->
            </Grid.RowDefinitions>

            <!-- Heading -->
            <TextBlock Grid.Row="0"
                       Text="Welcome"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       FontSize="24"
                       Margin="0,0,0,8"/>

            <!-- HERO  -->
            <Border Grid.Row="1"
                    MinHeight="140"
                    CornerRadius="12"
                    Background="{DynamicResource CardGradient.Accent}"
                    Margin="0,0,0,8"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Version"
                               Foreground="{DynamicResource Brush.Text.OnAccent}"
                               FontSize="13" Opacity="0.9"/>
                    <TextBlock Text="{Binding AppVersion}"
                               Foreground="{DynamicResource Brush.Text.OnAccent}"
                               FontSize="22" FontWeight="SemiBold"
                               Margin="0,2,0,6"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- subtext can go here-->
                    <TextBlock Text=""
                               Foreground="{DynamicResource Brush.Text.OnAccent}"
                               FontSize="13"/>
                    <!-- news can display here -->
                    <TextBlock Text=""
                               Foreground="{DynamicResource Brush.Text.OnAccent}"
                               FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- QUICK PANELS -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- User -->
                <Border Grid.Column="0"
                        MinHeight="110"
                        CornerRadius="12"
                        Background="{DynamicResource Brush.Surface.Hover}"
                        Padding="12"
                        Margin="0,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25*"/>
                            <ColumnDefinition Width="321*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="User lookup"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontSize="18" Margin="0,0,0,6" Grid.ColumnSpan="2"/>

                        <Border Grid.Row="1"
                                CornerRadius="12"
                                Background="{DynamicResource Brush.Surface}"
                                Padding="8,0" Height="34" Grid.ColumnSpan="2">
                            <TextBox Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                     CaretBrush="{DynamicResource Brush.Text.Primary}"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding UserQuery, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="NetID, or email"/>
                        </Border>

                        <Rectangle Grid.Row="2" Height="0" Grid.ColumnSpan="2" Margin="0,0,0,36" Grid.RowSpan="2"/>

                        <Button Grid.Row="3"
                                Content="Open User"
                                MinWidth="110"
                                HorizontalAlignment="Right"
                                Style="{DynamicResource Button.Rounded}"
                                Margin="0,8,0,0"
                                Grid.Column="1"
                                Command="{Binding OpenUserCommand}"/>
                    </Grid>
                </Border>

                <!-- Computer -->
                <Border Grid.Column="1"
                        MinHeight="110"
                        CornerRadius="12"
                        Background="{DynamicResource Brush.Surface.Hover}"
                        Padding="12"
                        Margin="6,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="49*"/>
                            <ColumnDefinition Width="297*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Computer lookup"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontSize="18" Margin="0,0,0,6" Grid.ColumnSpan="2"/>

                        <Border Grid.Row="1"
                                CornerRadius="12"
                                Background="{DynamicResource Brush.Surface}"
                                Padding="8,0" Height="34" Grid.ColumnSpan="2">
                            <TextBox Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                     CaretBrush="{DynamicResource Brush.Text.Primary}"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ComputerQuery, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Hostname"/>
                        </Border>

                        <Rectangle Grid.Row="2" Height="0" Grid.ColumnSpan="2" Margin="0,0,0,36" Grid.RowSpan="2"/>

                        <Button Grid.Row="3"
                                Content="Open Computer"
                                MinWidth="132"
                                HorizontalAlignment="Right"
                                Style="{DynamicResource Button.Rounded}"
                                Margin="0,8,0,0"
                                Grid.Column="1"
                                Command="{Binding OpenComputerCommand}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- LOWER TILES (wrap text) -->
            <UniformGrid Grid.Row="3" Columns="4">
                <!-- Tile 1: Groups -->
                <Border Height="80" CornerRadius="12"
                        Background="{DynamicResource Brush.Surface.Hover}"
                        Margin="0,0,8,0" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource Brush.Accent}" CornerRadius="12,0,0,12"/>

                        <StackPanel Grid.Column="1" Margin="12,8,12,8">
                            <TextBlock Text="Groups" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="15"/>
                            <TextBlock Text="Search group memberships"
                                       Foreground="{DynamicResource Brush.Text.Muted}" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource TileOverlayButton}"
                                Command="{Binding GoGroupsCommand}"/>
                    </Grid>
                </Border>

                <!-- Tile 2: Entra -->
                <Border Height="80" CornerRadius="12"
                        Background="{DynamicResource Brush.Surface.Hover}"
                        Margin="8,0,8,0" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Brush.Accent}" CornerRadius="12,0,0,12"/>
                        <StackPanel Grid.Column="1" Margin="12,8,12,8">
                            <TextBlock Text="Entra" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="15"/>
                            <TextBlock Text="Coming soon..."
                                       Foreground="{DynamicResource Brush.Text.Muted}" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource TileOverlayButton}"
                                Command="{Binding GoEntraCommand}"/>
                    </Grid>
                </Border>

                <!-- Tile 3: Links -->
                <Border Height="80" CornerRadius="12"
                        Background="{DynamicResource Brush.Surface.Hover}"
                        Margin="8,0,8,0" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Brush.Accent}" CornerRadius="12,0,0,12"/>
                        <StackPanel Grid.Column="1" Margin="12,8,12,8">
                            <TextBlock Text="Links" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="15"/>
                            <TextBlock Text="Intranet · ServiceNow"
                                       Foreground="{DynamicResource Brush.Text.Muted}" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource TileOverlayButton}"
                                Command="{Binding GoLinksCommand}"/>
                    </Grid>
                </Border>

                <!-- Tile 4: About -->
                <Border Height="80" CornerRadius="12"
                        Background="{DynamicResource Brush.Surface.Hover}"
                        Margin="8,0,0,0" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Brush.Accent}" CornerRadius="12,0,0,12"/>
                        <StackPanel Grid.Column="1" Margin="12,8,12,8">
                            <TextBlock Text="About" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="15"/>
                            <TextBlock Text="Version, source, credits"
                                       Foreground="{DynamicResource Brush.Text.Muted}" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource TileOverlayButton}"
                                Command="{Binding GoAboutCommand}"/>
                    </Grid>
                </Border>
            </UniformGrid>

        </Grid>
    </Border>
</UserControl>
