<UserControl x:Class="DSAMVVM.MVVM.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <!-- hover/press overlay for whole tiles -->
        <Style x:Key="TileOverlayButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Overlay" Background="{TemplateBinding Background}" Opacity="0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource CardGradient.Surface.Hover}"/>
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.25"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource CardGradient.Surface.Pressed}"/>
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Padding="{DynamicResource Space.Page}"
            Background="Transparent"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">

        <Grid VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- title -->
            <TextBlock Grid.Row="0"
                       Text="{Binding Title}"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       FontSize="24"
                       Margin="0,0,0,6"/>

            <!-- version banner -->
            <Border Grid.Row="1"
                    MinHeight="128"
                    CornerRadius="12"
                    Background="{DynamicResource CardGradient.Accent}"
                    Margin="0,0,0,6"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="{Binding AppVersion}"
                               Foreground="{DynamicResource Brush.Text.OnAccent}"
                               FontSize="22" FontWeight="SemiBold"
                               Margin="0,2,0,4"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text=""
                               Foreground="{DynamicResource Brush.Text.OnAccent}"
                               FontSize="13"/>
                    <TextBlock Text=""
                               Foreground="{DynamicResource Brush.Text.OnAccent}"
                               FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- quick lookups -->
            <Grid Grid.Row="2" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- user lookup -->
                <Border Grid.Column="0"
                        MinHeight="104"
                        CornerRadius="12"
                        Background="{DynamicResource CardGradient.Surface.L1}"
                        Padding="10"
                        Margin="0,0,5,0"
                        BorderBrush="{DynamicResource Brush.Card.Border}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25*"/>
                            <ColumnDefinition Width="321*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="User lookup"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontSize="18" Margin="0,0,0,6" Grid.ColumnSpan="2"/>

                        <Border Grid.Row="1"
                                CornerRadius="12"
                                Background="#12FFFFFF"
                                BorderBrush="#30FFFFFF"
                                BorderThickness="1"
                                Padding="8,0" Height="32" Grid.ColumnSpan="2">
                            <TextBox Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                     CaretBrush="{DynamicResource Brush.Text.Primary}"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding UserQuery, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="NetID, or email"/>
                        </Border>

                        <Rectangle Grid.Row="2" Height="0" Grid.ColumnSpan="2" Margin="0,0,0,28" Grid.RowSpan="2"/>

                        <Button Grid.Row="3"
                                Content="Open User"
                                MinWidth="108"
                                HorizontalAlignment="Right"
                                Style="{DynamicResource Button.Rounded}"
                                Margin="0,6,0,0"
                                Grid.Column="1"
                                Command="{Binding OpenUserCommand}"/>
                    </Grid>
                </Border>

                <!-- computer lookup -->
                <Border Grid.Column="1"
                        MinHeight="104"
                        CornerRadius="12"
                        Background="{DynamicResource CardGradient.Surface.L1}"
                        Padding="10"
                        Margin="5,0,0,0"
                        BorderBrush="{DynamicResource Brush.Card.Border}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="49*"/>
                            <ColumnDefinition Width="297*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Computer lookup"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontSize="18" Margin="0,0,0,6" Grid.ColumnSpan="2"/>

                        <Border Grid.Row="1"
                                CornerRadius="12"
                                Background="#12FFFFFF"
                                BorderBrush="#30FFFFFF"
                                BorderThickness="1"
                                Padding="8,0" Height="32" Grid.ColumnSpan="2">
                            <TextBox Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                     CaretBrush="{DynamicResource Brush.Text.Primary}"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ComputerQuery, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Hostname"/>
                        </Border>

                        <Rectangle Grid.Row="2" Height="0" Grid.ColumnSpan="2" Margin="0,0,0,28" Grid.RowSpan="2"/>

                        <Button Grid.Row="3"
                                Content="Open Computer"
                                MinWidth="128"
                                HorizontalAlignment="Right"
                                Style="{DynamicResource Button.Rounded}"
                                Margin="0,6,0,0"
                                Grid.Column="1"
                                Command="{Binding OpenComputerCommand}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- tiles -->
            <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,8">

                <!-- Groups -->
                <Border Height="82" CornerRadius="12"
                        Background="{DynamicResource CardGradient.Surface.L1}"
                        Margin="0,0,6,0" Padding="0"
                        BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardGradient.Accent}" CornerRadius="12,0,0,12"/>
                        <StackPanel Grid.Column="1" Margin="12,8,12,8">
                            <TextBlock Text="Groups" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="15"/>
                            <TextBlock Text="Search group memberships"
                                       Foreground="{DynamicResource Brush.Text.Muted}" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource TileOverlayButton}"
                                Command="{Binding GoGroupsCommand}"/>
                    </Grid>
                </Border>

                <!-- Entra -->
                <Border Height="82" CornerRadius="12"
                        Background="{DynamicResource CardGradient.Surface.L1}"
                        Margin="6,0,6,0" Padding="0"
                        BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardGradient.Accent}" CornerRadius="12,0,0,12"/>
                        <StackPanel Grid.Column="1" Margin="12,8,12,8">
                            <TextBlock Text="Entra" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="15"/>
                            <TextBlock Text="Coming soon..."
                                       Foreground="{DynamicResource Brush.Text.Muted}" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource TileOverlayButton}"
                                Command="{Binding GoEntraCommand}"/>
                    </Grid>
                </Border>

                <!-- Links -->
                <Border Height="82" CornerRadius="12"
                        Background="{DynamicResource CardGradient.Surface.L1}"
                        Margin="6,0,6,0" Padding="0"
                        BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardGradient.Accent}" CornerRadius="12,0,0,12"/>
                        <StackPanel Grid.Column="1" Margin="12,8,12,8">
                            <TextBlock Text="Links" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="15"/>
                            <TextBlock Text="Intranet · ServiceNow"
                                       Foreground="{DynamicResource Brush.Text.Muted}" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource TileOverlayButton}"
                                Command="{Binding GoLinksCommand}"/>
                    </Grid>
                </Border>

                <!-- About -->
                <Border Height="82" CornerRadius="12"
                        Background="{DynamicResource CardGradient.Surface.L1}"
                        Margin="6,0,0,0" Padding="0"
                        BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardGradient.Accent}" CornerRadius="12,0,0,12"/>
                        <StackPanel Grid.Column="1" Margin="12,8,12,8">
                            <TextBlock Text="About" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="15"/>
                            <TextBlock Text="Version, source, credits"
                                       Foreground="{DynamicResource Brush.Text.Muted}" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource TileOverlayButton}"
                                Command="{Binding GoAboutCommand}"/>
                    </Grid>
                </Border>

            </UniformGrid>

        </Grid>
    </Border>
</UserControl>
