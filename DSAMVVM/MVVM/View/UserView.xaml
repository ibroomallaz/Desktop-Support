<UserControl x:Class="DSAMVVM.MVVM.View.UserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:beh="clr-namespace:DSAMVVM.MVVM.Behaviors"
             mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- log viewer -->
            <RowDefinition Height="Auto"/>
            <!-- bottom bar -->
        </Grid.RowDefinitions>

        <!-- FlowDocument viewer driven by the shared service/behavior -->
        <FlowDocumentScrollViewer
            Grid.Row="0"
            IsToolBarVisible="False"
            VerticalScrollBarVisibility="Auto"
            beh:FlowDocBinder.Text="{Binding SearchLog}"
            beh:FlowDocBinder.ViewName="UserView"
            beh:FlowDocBinder.PreserveScrollPosition="True" />

        <!-- Bottom Bar -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Clear -->
                <Button Content="Clear Log"
                        Padding="10,4"
                        Margin="0,0,12,0"
                        Click="ClearLog_Click"
                        ToolTip="Clear the log output"/>

                <!-- Font size controls (global unless per-view override is enabled in settings) -->
                <Button Content="A-"
                        Width="44"
                        Margin="0,0,6,0"
                        Click="DecreaseFont_Click"
                        ToolTip="Decrease log text size" />

                <Button Content="A"
                        Width="44"
                        Click="ResetFont_Click"
                        ToolTip="Reset log text size (global or per-view depending on settings)" />

                <Button Content="A+"
                        Width="44"
                        Margin="0,0,6,0"
                        Click="IncreaseFont_Click"
                        ToolTip="Increase log text size" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
