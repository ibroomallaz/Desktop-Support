<UserControl x:Class="DSAMVVM.MVVM.View.UserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:beh="clr-namespace:DSAMVVM.MVVM.Model.Behaviors"
             mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- log viewer -->
            <RowDefinition Height="Auto"/>
            <!-- bottom bar -->
        </Grid.RowDefinitions>

        <!-- FlowDocument viewer driven by the shared service/behavior -->
        <FlowDocumentScrollViewer
            Grid.Row="0"
            IsToolBarVisible="False"
            VerticalScrollBarVisibility="Auto"
            beh:FlowDocBinder.Text="{Binding SearchLog}"
            beh:FlowDocBinder.ViewName="UserView"
            beh:FlowDocBinder.PreserveScrollPosition="True" />

        <!-- Bottom Bar -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Clear + Refresh (left) -->
                <ColumnDefinition Width="*"/>
                <!-- spacer -->
                <ColumnDefinition Width="Auto"/>
                <!-- Font controls (right) -->
            </Grid.ColumnDefinitions>

            <!-- Left cluster: Clear + Refresh -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <!-- Clear -->
                <Button
                    Content="Clear"
                    Padding="10,4"
                    Margin="0,0,12,0"
                    Click="ClearLog_Click"
                    Style="{DynamicResource Button.FlowDoc}"
                    ToolTip="Clear the log output"/>

                <!-- Refresh Dept Data (single Style via BasedOn) -->
                <Button
                    x:Name="RefreshDeptButton"
                    Content="Refresh Dept Data"
                    Padding="10,4"
                    Margin="0,0,12,0"
                    Click="RefreshDept_Click"
                    ToolTip="Reload departmental JSON from web/cache">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.FlowDoc}">
                            <Style.Triggers>
                                <!-- Disable and show busy label while refreshing -->
                                <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Content"   Value="Refreshing…"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Right cluster: font controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="A-"
                        Width="44"
                        Margin="0,0,6,0"
                        Click="DecreaseFont_Click"
                        Style="{DynamicResource Button.FlowDoc.Small}"
                        ToolTip="Decrease log text size" />
                <Button Content="A"
                        Width="44"
                        Click="ResetFont_Click"
                        Style="{DynamicResource Button.FlowDoc.Small}"
                        ToolTip="Reset log text size" />
                <Button Content="A+"
                        Width="44"
                        Margin="0,0,6,0"
                        Click="IncreaseFont_Click"
                        Style="{DynamicResource Button.FlowDoc.Small}"
                        ToolTip="Increase log text size" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
