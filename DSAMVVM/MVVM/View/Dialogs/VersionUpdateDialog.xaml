<Window x:Class="DSAMVVM.MVVM.View.Dialogs.VersionUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        MinWidth="560"
        MinHeight="320"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent">

    <!-- Themed container with custom title bar -->
    <Border CornerRadius="12"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Card.Border.Alternate}"
            BorderThickness="1"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Padding="12,8"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Card.Border.Alternate}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarDrag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding TitleText}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Content="✕" Width="28" Height="28" Padding="0"
                            Command="{Binding CloseCommand}"
                            Background="Transparent"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            BorderBrush="{x:Null}"/>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,12">
                    <TextBlock Text="{Binding HeaderText}"
                               FontSize="18"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock Text="{Binding SubText}"
                               Margin="0,6,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                </StackPanel>

                <!-- Change Log -->
                <TextBlock Grid.Row="1"
                           Text="Change Log"
                           Margin="0,0,0,6"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}"/>

                <Border Grid.Row="2"
                        Background="{DynamicResource Brush.Card.Alternate}"
                        BorderBrush="{DynamicResource Brush.Card.Border.Alternate}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Visibility="{Binding ChangeLogCardVisibility}">
                    <ScrollViewer x:Name="ChangelogScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="True">
                        <TextBlock Text="{Binding ChangelogText, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                    </ScrollViewer>
                </Border>

                <!-- Links -->
                <TextBlock Grid.Row="3"
                           Text="Links"
                           Margin="0,12,0,6"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}"/>

                <Border Grid.Row="4"
                        Background="{DynamicResource Brush.Card.Alternate}"
                        BorderBrush="{DynamicResource Brush.Card.Border.Alternate}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Visibility="{Binding LinksCardVisibility}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Visibility="{Binding DownloadRowVisibility}">
                            <Run Text="Download: " FontWeight="SemiBold"/>
                            <Hyperlink Command="{Binding DownloadCommand}"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       TextDecorations="Underline">
                                <Run Text="{Binding DownloadUrl, Mode=OneWay}"/>
                            </Hyperlink>
                        </TextBlock>

                        <TextBlock Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Visibility="{Binding NotesLinkVisibility}">
                            <Run Text="Release notes: " FontWeight="SemiBold"/>
                            <Hyperlink Command="{Binding OpenReleaseNotesCommand}"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       TextDecorations="Underline">
                                <Run Text="{Binding ChangeLogUrl, Mode=OneWay}"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button Content="Download"
                            MinWidth="110"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            Command="{Binding DownloadCommand}"
                            Visibility="{Binding DownloadRowVisibility}"
                            Style="{DynamicResource Button.Rounded}"/>
                    <Button Content="Release notes"
                            MinWidth="120"
                            Margin="0,0,8,0"
                            Command="{Binding OpenReleaseNotesCommand}"
                            IsEnabled="{Binding NotesButtonEnabled}"
                            Style="{DynamicResource Button.Rounded}"/>
                    <Button Content="Close"
                            MinWidth="96"
                            Command="{Binding CloseCommand}"
                            Style="{DynamicResource Button.Rounded}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
