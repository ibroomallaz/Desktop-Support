<Window x:Class="DSAMVVM.MVVM.View.Dialogs.VersionUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DSAMVVM.MVVM.ViewModel.Dialogs"
        xmlns:res="clr-namespace:DSAMVVM.MVVM.View.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:VersionUpdateDialogViewModel}"
        Title="{Binding TitleText, FallbackValue=Update Available}"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        MinWidth="560"
        MinHeight="340"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theme/Colors/Colors.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Decor/Gradient.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/Button.Rounded.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/ScrollBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <!-- Dialog Button Template (keeps disabled buttons visible with muted styling) -->
            <ControlTemplate x:Key="Tpl.Button.Dialog" TargetType="Button">
                <Border x:Name="Root"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True"
                        CornerRadius="8"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter x:Name="ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonGradient.Neutral}"/>
                        <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Active}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonGradient.Primary}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                        <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
                        <Setter TargetName="Root" Property="Opacity" Value="0.65"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="Button.Dialog.Secondary" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,5"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template" Value="{StaticResource Tpl.Button.Dialog}"/>
            </Style>

            <Style x:Key="Button.Dialog.Primary" TargetType="Button" BasedOn="{StaticResource Button.Dialog.Secondary}">
                <Setter Property="Background" Value="{DynamicResource ButtonGradient.Primary}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
                <Setter Property="BorderBrush" Value="#66B34A63"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter x:Name="ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonGradient.Primary.Hover}"/>
                                    <Setter TargetName="Root" Property="Effect" Value="{StaticResource Fx.ActiveGlow}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Pressed}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                    <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
                                    <Setter TargetName="Root" Property="Opacity" Value="0.6"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer shell: matches MainWindow blue gradient + native 8px DWM corners -->
    <Border CornerRadius="8"
            Background="{DynamicResource AppGradient.Window.Blue}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            ClipToBounds="True"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0"
                    Padding="14,0,10,0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarDrag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static res:Glyphs.Sync}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource Brush.Accent.Red.Light}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding TitleText}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="{x:Static res:Glyphs.ChromeClose}"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Margin="0"
                            ToolTip="Close"
                            Command="{Binding CloseCommand}"
                            IsEnabled="{Binding IsNotDownloading}"
                            Style="{DynamicResource Button.Rounded.Small}"/>
                </Grid>
            </Border>

            <!-- Content Body -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Version Summary Card -->
                <Border Grid.Row="0"
                        Margin="0,0,0,12"
                        CornerRadius="12"
                        Background="{DynamicResource Brush.Surface.Hover}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource CardGradient.Accent}"
                                CornerRadius="12,0,0,12"/>

                        <StackPanel Grid.Column="1" Margin="16,12">
                            <TextBlock Text="{Binding HeaderText}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <TextBlock Text="{Binding SubText}"
                                       Margin="0,4,0,0"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Text.Muted}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Change Log Card -->
                <Border Grid.Row="1"
                        CornerRadius="12"
                        Background="{DynamicResource Brush.Surface.Hover}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True"
                        Visibility="{Binding ChangeLogCardVisibility}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource CardGradient.Accent}"
                                CornerRadius="12,0,0,12"/>

                        <Grid Grid.Column="1" Margin="16,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{x:Static res:Glyphs.Checklist}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource Brush.Accent.Red.Light}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Change Log"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Background="{DynamicResource Brush.Surface.1}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10">
                                <ScrollViewer x:Name="ChangelogScroll"
                                              VerticalScrollBarVisibility="Auto"
                                              MaxHeight="200"
                                              CanContentScroll="True">
                                    <TextBlock Text="{Binding ChangelogText, Mode=OneWay}"
                                               FontSize="12.5"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Admin Privileges Warning Banner -->
                <Border Grid.Row="2"
                        Margin="0,12,0,0"
                        Padding="12,8"
                        Background="{DynamicResource Brush.Status.Warning.Bg}"
                        BorderBrush="{DynamicResource Brush.Status.Warning.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding AdminWarningVisibility}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Static res:Glyphs.Warning}"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{DynamicResource Brush.Status.Warning.Icon}"
                                   FontSize="14"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Administrator privileges required for .NET Desktop Runtime upgrade."
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Download Progress Section -->
                <Border Grid.Row="3"
                        Margin="0,12,0,0"
                        Padding="14,10"
                        Background="{DynamicResource Brush.Surface.Hover}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                        <ProgressBar IsIndeterminate="True"
                                     Height="6"
                                     BorderThickness="0"
                                     Background="{DynamicResource Brush.Surface.1}"
                                     Foreground="{DynamicResource Brush.Info}"/>
                    </StackPanel>
                </Border>

                <!-- Footer Action Buttons -->
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button Content="Release Notes"
                            MinWidth="116"
                            Margin="0,0,8,0"
                            Command="{Binding OpenReleaseNotesCommand}"
                            IsEnabled="{Binding IsNotDownloading}"
                            Style="{StaticResource Button.Dialog.Secondary}"/>
                    <Button Content="Close"
                            MinWidth="96"
                            Margin="0,0,8,0"
                            Command="{Binding CloseCommand}"
                            IsEnabled="{Binding IsNotDownloading}"
                            Style="{StaticResource Button.Dialog.Secondary}"/>
                    <Button Content="Install Update"
                            MinWidth="124"
                            IsDefault="True"
                            Command="{Binding InstallUpdateCommand}"
                            IsEnabled="{Binding IsNotDownloading}"
                            Style="{StaticResource Button.Dialog.Primary}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
