<Window x:Class="DSAMVVM.MVVM.View.Dialogs.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DSAMVVM.MVVM.ViewModel.Dialogs"
        xmlns:res="clr-namespace:DSAMVVM.MVVM.View.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FeedbackWindowViewModel}"
        Title="Submit Feedback / Nomination"
        Height="530" Width="480"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theme/Colors/Colors.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Decor/Gradient.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/Button.Rounded.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/LinksComboBoxTheme.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/ScrollBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Modern Dialog Input Field -->
            <Style x:Key="TextBox.Dialog" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.1}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Info}"/>
                <Setter Property="SelectionOpacity" Value="0.4"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                              Margin="0"
                                              Padding="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Border.Active}"/>
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Info}"/>
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Surface.1}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dialog Button Template (keeps disabled buttons visible with muted styling) -->
            <ControlTemplate x:Key="Tpl.Button.Dialog" TargetType="Button">
                <Border x:Name="Root"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True"
                        CornerRadius="8"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter x:Name="ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonGradient.Neutral}"/>
                        <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Active}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonGradient.Primary}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                        <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
                        <Setter TargetName="Root" Property="Opacity" Value="0.65"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="Button.Dialog.Secondary" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,5"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template" Value="{StaticResource Tpl.Button.Dialog}"/>
            </Style>

            <Style x:Key="Button.Dialog.Primary" TargetType="Button" BasedOn="{StaticResource Button.Dialog.Secondary}">
                <Setter Property="Background" Value="{DynamicResource ButtonGradient.Primary}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
                <Setter Property="BorderBrush" Value="#66B34A63"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter x:Name="ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonGradient.Primary.Hover}"/>
                                    <Setter TargetName="Root" Property="Effect" Value="{StaticResource Fx.ActiveGlow}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Pressed}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                    <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
                                    <Setter TargetName="Root" Property="Opacity" Value="0.6"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer shell: matches MainWindow blue gradient + native 8px DWM corners -->
    <Border CornerRadius="8"
            Background="{DynamicResource AppGradient.Window.Blue}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            ClipToBounds="True"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0"
                    Padding="14,0,10,0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarDrag">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static res:Glyphs.Support}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource Brush.Accent.Red.Light}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="Submit to Teams"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="{x:Static res:Glyphs.ChromeClose}"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Margin="0"
                            ToolTip="Close"
                            Click="Cancel_Click"
                            Style="{DynamicResource Button.Rounded.Small}"/>
                </Grid>
            </Border>

            <!-- Content Body -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Left-Accented Card Container matching SettingsView -->
                <Border Grid.Row="0"
                        CornerRadius="12"
                        Background="{DynamicResource Brush.Surface.Hover}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource CardGradient.Accent}"
                                CornerRadius="12,0,0,12"/>

                        <Grid Grid.Column="1" Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Submission Category Selector -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                <TextBlock Text="Submission Category"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           Margin="0,0,0,6"/>
                                <ComboBox x:Name="FeedbackTypeComboBox"
                                          Height="32"
                                          Style="{DynamicResource Combo.Links.Dropdown}"
                                          SelectedIndex="{Binding SelectedFeedbackIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="🐛 Report a Bug"/>
                                    <ComboBoxItem Content="💡 Request a Feature"/>
                                    <ComboBoxItem Content="🔄 Update Support Team"/>
                                    <ComboBoxItem Content="📝 Add/Update Note"/>
                                    <ComboBoxItem Content="🐾 Nominate Pet (ServiceMeow)"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Dynamic Category Forms -->
                            <Grid Grid.Row="1">

                                <!-- BUG & REQUEST UI -->
                                <Grid Visibility="{Binding IsBugOrRequestUI, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding InputPromptText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               Margin="0,0,0,6"/>
                                    <TextBox Grid.Row="1"
                                             Style="{StaticResource TextBox.Dialog}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Text="{Binding BugRequestText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- UPDATE TEAM UI -->
                                <StackPanel Visibility="{Binding IsUpdateUI, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Department Number" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,4"/>
                                    <TextBox Height="32" Margin="0,0,0,12"
                                             Style="{StaticResource TextBox.Dialog}"
                                             Text="{Binding EditableDepartment, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Text="Current Support Team" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,4"/>
                                    <TextBox Height="32" Margin="0,0,0,12"
                                             Style="{StaticResource TextBox.Dialog}"
                                             Text="{Binding EditableTeam, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Text="Expected Support Team" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,4"/>
                                    <TextBox Height="32"
                                             Style="{StaticResource TextBox.Dialog}"
                                             Text="{Binding ExpectedTeamText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <!-- NOTE UI -->
                                <Grid Visibility="{Binding IsNoteUI, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                        <TextBlock Text="Department Number" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,4"/>
                                        <TextBox Height="32"
                                                 Style="{StaticResource TextBox.Dialog}"
                                                 Text="{Binding EditableDepartment, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="Note Details" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,4"/>
                                    <TextBox Grid.Row="2"
                                             Style="{StaticResource TextBox.Dialog}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- SERVICEMEOW NOMINATION UI -->
                                <StackPanel Visibility="{Binding IsServiceMeowUI, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Pet Name *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,4"/>
                                            <TextBox Height="30"
                                                     Style="{StaticResource TextBox.Dialog}"
                                                     Text="{Binding PetName, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Species / Type" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,4"/>
                                            <TextBox Height="30"
                                                     Style="{StaticResource TextBox.Dialog}"
                                                     Text="{Binding PetSpecies, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Official Role" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,4"/>
                                            <TextBox Height="30"
                                                     Style="{StaticResource TextBox.Dialog}"
                                                     Text="{Binding PetRole, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Owner / Handler" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,4"/>
                                            <TextBox Height="30"
                                                     Style="{StaticResource TextBox.Dialog}"
                                                     Text="{Binding PetOwner, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Bio / Fun Fact" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,4"/>
                                    <TextBox Height="72"
                                             Style="{StaticResource TextBox.Dialog}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Text="{Binding PetBlurb, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Border Margin="0,10,0,0"
                                            Padding="10,8"
                                            Background="{DynamicResource Brush.Surface.1}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <TextBlock Text="🐾 Photo Submission: Once submitted, the nomination card will post to the ServiceMeow Teams channel. Simply reply to that thread with your favorite pet photo(s)!"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Footer Action Buttons -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button Content="Cancel"
                            MinWidth="96"
                            Margin="0,0,8,0"
                            Click="Cancel_Click"
                            Style="{StaticResource Button.Dialog.Secondary}"/>

                    <Button Content="{Binding SubmitButtonText}"
                            MinWidth="124"
                            IsDefault="True"
                            Command="{Binding SubmitCommand}"
                            IsEnabled="{Binding CanSubmit}"
                            Style="{StaticResource Button.Dialog.Primary}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
