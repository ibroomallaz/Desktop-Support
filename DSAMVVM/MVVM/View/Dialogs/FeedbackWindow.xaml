<Window x:Class="DSAMVVM.MVVM.View.Dialogs.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Submit Feedback"
        Height="360" Width="440"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theme/Colors/Colors.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Decor/Gradient.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/Button.Rounded.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/LinksComboBoxTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Card.Border.Alternate}"
            BorderThickness="1"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16,12"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Card.Border.Alternate}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarDrag">
                <Grid>
                    <TextBlock Text="Submit Feedback"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>

                    <Button HorizontalAlignment="Right"
                            Content="X"
                            Width="28" Height="28"
                            Click="Cancel_Click"
                            Style="{DynamicResource Button.Rounded.Small}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Feedback Type"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,0,0,4"/>
                    <ComboBox x:Name="FeedbackTypeComboBox"
                              Height="32"
                              Style="{DynamicResource Combo.Links.Dropdown}" 
                              SelectedIndex="{Binding SelectedFeedbackIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="🐛 Report a Bug"/>
                        <ComboBoxItem Content="💡 Request a Feature"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <TextBlock Text="Provide details below:"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="DetailsTextBox"
                             Height="110"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding DetailsText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource Brush.Surface.1}"
                             Foreground="{DynamicResource Brush.Text.Primary}"
                             BorderBrush="{DynamicResource Brush.Border}"
                             BorderThickness="1"
                             Padding="8"/>
                </StackPanel>
                <!-- Action Buttons -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Width="90" Height="30"
                            Margin="0,0,8,0"
                            Click="Cancel_Click"
                            Style="{DynamicResource Button.Rounded}"/>

                    <Button Content="{Binding SubmitButtonText}"
                            Width="90" Height="30"
                            IsDefault="True"
                            Command="{Binding SubmitCommand}"
                            IsEnabled="{Binding CanSubmit}"
                            Style="{DynamicResource Button.Rounded}"
                            Background="{DynamicResource Brush.Accent}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>