<Window x:Class="DSAMVVM.MVVM.View.Dialogs.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Submit Feedback / Nomination"
        Height="490" Width="460"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theme/Colors/Colors.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Decor/Gradient.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/Button.Rounded.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/LinksComboBoxTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Card.Border.Alternate}"
            BorderThickness="1"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16,12"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Card.Border.Alternate}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarDrag">
                <Grid>
                    <TextBlock Text="Submit to Teams"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>

                    <Button HorizontalAlignment="Right"
                            Content="✕"
                            Width="28"
                            Click="Cancel_Click"
                            Style="{DynamicResource Button.Rounded.Small}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Submission Category"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,0,0,4"/>
                    <ComboBox x:Name="FeedbackTypeComboBox"
                              Height="32"
                              Style="{DynamicResource Combo.Links.Dropdown}" 
                              SelectedIndex="{Binding SelectedFeedbackIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="🐛 Report a Bug"/>
                        <ComboBoxItem Content="💡 Request a Feature"/>
                        <ComboBoxItem Content="🔄 Update Support Team"/>
                        <ComboBoxItem Content="📝 Add/Update Note"/>
                        <ComboBoxItem Content="🐾 Nominate Pet (ServiceMeow)"/>
                    </ComboBox>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,14">

                    <!-- BUG & REQUEST UI -->
                    <StackPanel Visibility="{Binding IsBugOrRequestUI, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding InputPromptText}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="0,0,0,4"/>
                        <TextBox Height="230"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding BugRequestText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource Brush.Surface.1}"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderBrush="{DynamicResource Brush.Border}"
                                 BorderThickness="1" Padding="8"/>
                    </StackPanel>

                    <!-- UPDATE TEAM UI -->
                    <StackPanel Visibility="{Binding IsUpdateUI, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Department Number:" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                        <TextBox Height="30" Margin="0,0,0,12"
                                 Text="{Binding EditableDepartment, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource Brush.Surface.1}" Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="4"/>

                        <TextBlock Text="Current Support Team:" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                        <TextBox Height="30" Margin="0,0,0,12"
                                 Text="{Binding EditableTeam, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource Brush.Surface.1}" Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="4"/>

                        <TextBlock Text="Expected Support Team:" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                        <TextBox Height="30"
                                 Text="{Binding ExpectedTeamText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource Brush.Surface.1}" Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="4"/>
                    </StackPanel>

                    <!-- NOTE UI -->
                    <StackPanel Visibility="{Binding IsNoteUI, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Department Number:" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                        <TextBox Height="30" Margin="0,0,0,12"
                                 Text="{Binding EditableDepartment, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource Brush.Surface.1}" Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="4"/>

                        <TextBlock Text="Note Details:" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                        <TextBox Height="160" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource Brush.Surface.1}" Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="4"/>
                    </StackPanel>

                    <!-- SERVICEMEOW NOMINATION UI -->
                    <StackPanel Visibility="{Binding IsServiceMeowUI, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Pet Name: *" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                                <TextBox Height="28"
                                         Text="{Binding PetName, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource Brush.Surface.1}" Foreground="{DynamicResource Brush.Text.Primary}"
                                         BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Species / Type:" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                                <TextBox Height="28"
                                         Text="{Binding PetSpecies, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource Brush.Surface.1}" Foreground="{DynamicResource Brush.Text.Primary}"
                                         BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="4"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Official Role:" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                                <TextBox Height="28"
                                         Text="{Binding PetRole, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource Brush.Surface.1}" Foreground="{DynamicResource Brush.Text.Primary}"
                                         BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Owner / Handler:" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                                <TextBox Height="28"
                                         Text="{Binding PetOwner, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource Brush.Surface.1}" Foreground="{DynamicResource Brush.Text.Primary}"
                                         BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="4"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Bio / Fun Fact:" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                        <TextBox Height="75" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding PetBlurb, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource Brush.Surface.1}" Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="4"/>

                        <Border Margin="0,10,0,0" Padding="10,8" Background="{DynamicResource Brush.Surface.2}" CornerRadius="6">
                            <TextBlock Text="🐾 Photo Submission: Once submitted, the nomination card will post to the ServiceMeow Teams channel. Simply reply to that thread with your favorite pet photo(s)!"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       FontSize="11.5" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Width="90" Height="30"
                            Click="Cancel_Click"
                            Style="{DynamicResource Button.Rounded}"/>

                    <Button Content="{Binding SubmitButtonText}"
                            Width="120" Height="30"
                            IsDefault="True"
                            Command="{Binding SubmitCommand}"
                            IsEnabled="{Binding CanSubmit}"
                            Style="{DynamicResource Button.Rounded}"
                            Background="{DynamicResource Brush.Accent}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
