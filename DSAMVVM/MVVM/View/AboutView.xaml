<UserControl x:Class="DSAMVVM.MVVM.View.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theme/Colors/Colors.UA.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Compact variant for text buttons -->
            <Style x:Key="Button.Rounded.Compact"
                   TargetType="Button"
                   BasedOn="{StaticResource Button.Rounded}">
                <Setter Property="Padding"   Value="8,2"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="FontSize"  Value="12"/>
                <Setter Property="MinWidth"  Value="120"/>
                <Setter Property="Margin"    Value="0,0,6,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" Orientation="Vertical">

            <!-- Title -->
            <TextBlock Text="About"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       Margin="0,0,0,8"/>

            <!-- === APPLICATION (first) === -->
            <Border Padding="0" CornerRadius="12" Margin="0,0,0,16"
                    Background="{DynamicResource Brush.Surface.Hover}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource Brush.Accent}"
                            CornerRadius="12,0,0,12"/>

                    <StackPanel Grid.Column="1" Margin="16">
                        <TextBlock Text="Application"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Version: "
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding AppVersion}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       FontWeight="Medium"/>
                        </StackPanel>

                        <WrapPanel>
                            <Button Style="{StaticResource Button.Rounded.Compact}"
                                    Content="Check for Update"
                                    Click="OnCheckVersionClick"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- === DEVELOPERS (second) === -->
            <Border Padding="0" CornerRadius="12" Margin="0,0,0,16"
                    Background="{DynamicResource Brush.Surface.Hover}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource Brush.Accent}"
                            CornerRadius="12,0,0,12"/>

                    <StackPanel Grid.Column="1" Margin="16">
                        <TextBlock Text="Developers"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Margin="0,0,0,12"/>

                        <ItemsControl ItemsSource="{Binding Developers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                        <TextBlock Text="•"
                                                   Margin="0,0,6,0"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- === LINKS (last) === -->
            <Border Padding="0" CornerRadius="12" Margin="0,0,0,0"
                    Background="{DynamicResource Brush.Surface.Hover}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource Brush.Accent}"
                            CornerRadius="12,0,0,12"/>

                    <StackPanel Grid.Column="1" Margin="16">
                        <TextBlock Text="Links"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Margin="0,0,0,12"/>

                        <WrapPanel>
                            <Button Style="{StaticResource Button.Rounded.Compact}"
                                    Content="Open GitHub"
                                    Click="OnOpenGitHubClick"/>
                            <Button Style="{StaticResource Button.Rounded.Compact}"
                                    Content="Open SharePoint"
                                    Click="OnOpenSharePointClick"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
