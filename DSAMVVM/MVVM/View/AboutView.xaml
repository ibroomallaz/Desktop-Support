<UserControl x:Class="DSAMVVM.MVVM.View.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theme/Colors/Colors.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Decor/Gradient.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/Button.Rounded.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Card.Surface" TargetType="Border">
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="{DynamicResource CardGradient.Surface.L1}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Card.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CardGradient.Surface.Hover}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.7"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Button.Rounded.Compact" TargetType="Button" BasedOn="{StaticResource Button.Rounded}">
                <Setter Property="Padding"   Value="8,2"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="FontSize"  Value="12"/>
                <Setter Property="MinWidth"  Value="120"/>
                <Setter Property="Margin"    Value="0,0,8,8"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" Orientation="Vertical">

            <TextBlock Text="About"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       Margin="0,0,0,12"/>

            <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource CardGradient.Accent}"
                            CornerRadius="12,0,0,12"/>

                    <StackPanel Grid.Column="1" Margin="16">
                        <TextBlock Text="Application"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Version:" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding AppVersion}" 
                                       Foreground="{DynamicResource Brush.Text.Primary}" 
                                       FontWeight="Medium"
                                       Cursor="Hand"
                                       ToolTip="Click to toggle detailed file version">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleVersionCommand}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </StackPanel>
                        <WrapPanel>
                            <Button Style="{StaticResource Button.Rounded.Compact}"
                                    Content="Check for Update"
                                    Command="{Binding CheckVersionCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource CardGradient.Accent}"
                            CornerRadius="12,0,0,12"/>

                    <StackPanel Grid.Column="1" Margin="16">
                        <TextBlock Text="Developer Team"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding Developers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                        <TextBlock Text="•" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card.Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource CardGradient.Accent}"
                            CornerRadius="12,0,0,12"/>

                    <StackPanel Grid.Column="1" Margin="16">
                        <TextBlock Text="Resources"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Style="{StaticResource Button.Rounded.Compact}"
                                    Content="View Source on GitHub"
                                    Command="{Binding OpenGitHubCommand}" Click="Button_Click"/>
                            <Button Style="{StaticResource Button.Rounded.Compact}"
                                    Content="Open SharePoint"
                                    Command="{Binding OpenSharePointCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>