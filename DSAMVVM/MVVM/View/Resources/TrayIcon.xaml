<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tb="http://www.hardcodet.net/taskbar">

    <tb:TaskbarIcon x:Key="GlobalAppTrayIcon"
                    ToolTipText="Support App"
                    IconSource="pack://application:,,,/img/MainIcon.ico" 
                    Visibility="Visible"
                    DoubleClickCommand="{Binding ShowWindowCommand}">

        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Open Support App" Command="{Binding ShowWindowCommand}" FontWeight="Bold"/>

                <Separator/>

                <MenuItem Header="Search">
                    <MenuItem Header="Users" Command="{Binding UserCommand}"/>
                    <MenuItem Header="Computers" Command="{Binding ComputerCommand}"/>
                    <MenuItem Header="Groups" Command="{Binding GroupCommand}"/>
                </MenuItem>

                <MenuItem Header="Quick Links" Command="{Binding LinksCommand}"/>

                <MenuItem Header="Settings" Command="{Binding SettingsCommand}"/>

                <Separator/>

                <MenuItem Header="Submit Feedback" Command="{Binding OpenFeedbackCommand}" CommandParameter="0"/>
                <MenuItem Header="Check for Updates" Command="{Binding CheckUpdateCommand}"/>
                <Separator/>

                <MenuItem Header="Exit Application" Command="{Binding ExitApplicationCommand}"/>
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>

    </tb:TaskbarIcon>
</ResourceDictionary>