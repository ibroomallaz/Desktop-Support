<UserControl x:Class="DSAMVVM.MVVM.View.EntraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DSAMVVM.MVVM.ViewModel"
             xmlns:cards="clr-namespace:DSAMVVM.MVVM.ViewModel.Cards"
             xmlns:res="clr-namespace:DSAMVVM.MVVM.View.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EntraViewModel}"
             d:DesignHeight="600" d:DesignWidth="850">

    <UserControl.Resources>
        <ResourceDictionary>

            <!-- Subtle Link Button -->
            <Style x:Key="InlineLinkButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Info.Light}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Info.Hover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Compact Ghost Button -->
            <Style x:Key="GhostActionButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Active}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Pill Button for Hostname Copy -->
            <Style x:Key="ChipButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.1}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Brush.Border.Active}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Collapsed Row Header Button -->
            <Style x:Key="CollapsedRowButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.1}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RowBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource CardGradient.Surface.Hover}"/>
                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border.Active}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Multi-Record Device Switcher Pill -->
            <Style x:Key="DeviceOptionButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.1}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Active}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#122438"/>
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="#2A6298"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Mode + Auth Bar -->
            <RowDefinition Height="*"/>    <!-- History Feed / Empty State -->
            <RowDefinition Height="Auto"/> <!-- Bottom Action Bar -->
        </Grid.RowDefinitions>

        <!-- Top Bar: Search Mode Pills + Compact Entra Auth Status -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <RadioButton Content="Device Search"
                             GroupName="EntraMode"
                             IsChecked="{Binding IsDeviceMode}"
                             Style="{StaticResource Radio.GroupView}"/>
            </StackPanel>

            <!-- Compact Auth Status Pill -->
            <Border Grid.Column="1"
                    Background="{DynamicResource Brush.Surface.1}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,4"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FFA000"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                        <Setter Property="Fill" Value="#3CD070"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding AccountDisplayText}"
                               FontSize="11.5"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <Button Content="{Binding AuthButtonText}"
                            Command="{Binding AuthToggleCommand}"
                            Style="{StaticResource GhostActionButton}"
                            Padding="10,3"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Empty State Container -->
        <Border Grid.Row="1"
                CornerRadius="10"
                Background="{DynamicResource Brush.Surface.1}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                Padding="30">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasHistory}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{x:Static res:Glyphs.Entra}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="32"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           Opacity="0.5"
                           Margin="0,0,0,12"/>

                <TextBlock Text="No Entra Lookups Yet"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Enter a device hostname or Entra Object/Device ID in the search bar above and press Enter."
                           FontSize="12"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <Button Content="Sign in to Microsoft Entra ID"
                        Command="{Binding AuthToggleCommand}"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Rounded}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- History Feed ScrollViewer -->
        <ScrollViewer x:Name="HistoryScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasHistory}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type cards:EntraHistoryItemViewModel}">
                        <Grid x:Name="RootCard" Margin="0,0,0,6">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy Entra Summary" Command="{Binding CopySummaryCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Copy Device Name" Command="{Binding CopyPrimaryCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Copy Entra Object ID" Command="{Binding CopyTextCommand}" CommandParameter="{Binding ObjectId}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <!-- ============================================== -->
                            <!-- STATE A: COLLAPSED SUMMARY ROW                 -->
                            <!-- ============================================== -->
                            <Button Command="{Binding ToggleExpandCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CollapsedRowButton}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                        <ColumnDefinition Width="Auto"/> <!-- Device Name -->
                                        <ColumnDefinition Width="Auto"/> <!-- OS Badge -->
                                        <ColumnDefinition Width="Auto"/> <!-- Join / Status Badges -->
                                        <ColumnDefinition Width="*"/>    <!-- Owner + Group count -->
                                        <ColumnDefinition Width="Auto"/> <!-- Timestamp -->
                                        <ColumnDefinition Width="Auto"/> <!-- Copy Summary -->
                                        <ColumnDefinition Width="Auto"/> <!-- Dismiss -->
                                        <ColumnDefinition Width="Auto"/> <!-- Chevron -->
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{x:Static res:Glyphs.Entra}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="{Binding DataContext.Typography.IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DeviceName}"
                                               FontWeight="SemiBold"
                                               FontSize="{Binding DataContext.Typography.BodySize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                    <!-- OS Badge -->
                                    <Border Grid.Column="2" CornerRadius="4" Background="#122438" BorderBrush="#1D3D5E" BorderThickness="1" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OperatingSystem}" FontSize="{Binding DataContext.Typography.BadgeSize, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold" Foreground="#6EC3FF" TextWrapping="NoWrap"/>
                                    </Border>

                                    <!-- Status Badges Cluster -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <!-- Not Found Badge -->
                                        <Border CornerRadius="4" Background="#3A1418" BorderBrush="#63232A" BorderThickness="1" Padding="5,1" Margin="0,0,4,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFound}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Not Found" FontSize="{Binding DataContext.Typography.BadgeSize, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold" Foreground="#FF7B88" TextWrapping="NoWrap"/>
                                        </Border>

                                        <!-- Division Pill -->
                                        <Border CornerRadius="4" Background="#281738" BorderBrush="#6C3BAA" BorderThickness="1" Padding="5,1" Margin="0,0,4,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDivision}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DivisionCode, StringFormat='DIV: {0}'}" FontSize="{Binding DataContext.Typography.BadgeSize, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="Bold" Foreground="#E9D5FF" TextWrapping="NoWrap"/>
                                        </Border>

                                        <!-- Join Type Badge -->
                                        <Border CornerRadius="4" Background="#1C2433" BorderBrush="#374663" BorderThickness="1" Padding="5,1" Margin="0,0,4,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFound}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding JoinTypeDisplay}" FontSize="{Binding DataContext.Typography.BadgeSize, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold" Foreground="#A5B4FC" TextWrapping="NoWrap"/>
                                        </Border>

                                        <!-- Disabled Badge -->
                                        <Border CornerRadius="4" Background="#3A1418" BorderBrush="#63232A" BorderThickness="1" Padding="5,1" Margin="0,0,4,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Disabled" FontSize="{Binding DataContext.Typography.BadgeSize, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold" Foreground="#FF7B88" TextWrapping="NoWrap"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Owner + Group Summary -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding CollapsedSummaryText}"
                                               FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding TimeFormatted}"
                                               FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                    <!-- Copy Summary -->
                                    <Button Grid.Column="6"
                                            Style="{StaticResource InlineLinkButton}"
                                            Command="{Binding CopySummaryCommand}"
                                            ToolTip="Copy Entra summary to clipboard"
                                            Margin="0,0,8,0"
                                            Padding="4,2"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSummaryCopied}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#5CDA89">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSummaryCopied}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>

                                    <!-- Dismiss -->
                                    <Button Grid.Column="7"
                                            Style="{StaticResource InlineLinkButton}"
                                            Command="{Binding RemoveCommand}"
                                            ToolTip="Clear this record from history"
                                            Margin="0,0,8,0"
                                            Padding="4,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    </Button>

                                    <!-- Chevron Down -->
                                    <TextBlock Grid.Column="8"
                                               Text="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- ============================================== -->
                            <!-- STATE B: EXPANDED CARD                         -->
                            <!-- ============================================== -->
                            <Border CornerRadius="10"
                                    Background="{DynamicResource CardGradient.Surface.L1}"
                                    BorderBrush="{DynamicResource Brush.Card.Border}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.2"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Accent Stripe -->
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource Brush.Accent.Red}"
                                            CornerRadius="10,0,0,10"/>

                                    <!-- Main Content -->
                                    <Grid Grid.Column="1" Margin="14,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- 0. Header -->
                                            <RowDefinition Height="Auto"/> <!-- 1. Multi-record switcher -->
                                            <RowDefinition Height="Auto"/> <!-- 2. Divider -->
                                            <RowDefinition Height="Auto"/> <!-- 3. Error / 2-Column Body -->
                                            <RowDefinition Height="Auto"/> <!-- 4. Entra Groups Section -->
                                        </Grid.RowDefinitions>

                                        <!-- 0. Header -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="34" Height="34"
                                                    CornerRadius="17"
                                                    Background="{DynamicResource Brush.Surface.Hover}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Static res:Glyphs.Entra}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="{Binding DataContext.Typography.IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Name Copy Chip -->
                                                    <Button Style="{StaticResource ChipButton}"
                                                            Command="{Binding CopyPrimaryCommand}"
                                                            ToolTip="Click to copy device hostname"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DeviceName}"
                                                                       FontSize="{Binding DataContext.Typography.TitleSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                            <TextBlock Text=" &#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text=" ✓ Copied" FontSize="11" FontWeight="Bold" Foreground="#5CDA89" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Division Pill (extracted from e.g. CDIV-Wrkst-Intune-All, clickable to Division Support) -->
                                                     <Button Command="{Binding NavigateDivisionSupportCommand}"
                                                             Cursor="Hand"
                                                             FocusVisualStyle="{x:Null}"
                                                             Margin="0,0,6,2"
                                                             VerticalAlignment="Center"
                                                             ToolTip="{Binding DivisionSourceGroup, StringFormat='Division from Entra group: {0} — click to open Division Support'}">
                                                         <Button.Style>
                                                             <Style TargetType="Button">
                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                                 <Setter Property="Template">
                                                                     <Setter.Value>
                                                                         <ControlTemplate TargetType="Button">
                                                                             <Border x:Name="DivPillBorder"
                                                                                     CornerRadius="4"
                                                                                     Background="#281738"
                                                                                     BorderBrush="#6C3BAA"
                                                                                     BorderThickness="1"
                                                                                     Padding="6,2">
                                                                                 <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                             </Border>
                                                                             <ControlTemplate.Triggers>
                                                                                 <Trigger Property="IsMouseOver" Value="True">
                                                                                     <Setter TargetName="DivPillBorder" Property="Background" Value="#361E4D"/>
                                                                                     <Setter TargetName="DivPillBorder" Property="BorderBrush" Value="#8E54DB"/>
                                                                                 </Trigger>
                                                                             </ControlTemplate.Triggers>
                                                                         </ControlTemplate>
                                                                     </Setter.Value>
                                                                 </Setter>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding HasDivision}" Value="True">
                                                                         <Setter Property="Visibility" Value="Visible"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Button.Style>
                                                         <TextBlock Text="{Binding DivisionCode, StringFormat='DIV: {0}'}" FontSize="{Binding DataContext.Typography.BadgeSize, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="Bold" Foreground="#E9D5FF" TextWrapping="NoWrap"/>
                                                     </Button>

                                                     <!-- OS Badge -->
                                                     <Border CornerRadius="4" Background="#122438" BorderBrush="#1D3D5E" BorderThickness="1" Padding="6,2" Margin="0,0,6,2" VerticalAlignment="Center">
                                                         <Border.Style>
                                                             <Style TargetType="Border">
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding IsFound}" Value="False">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Border.Style>
                                                         <TextBlock Text="{Binding OperatingSystem}" FontSize="{Binding DataContext.Typography.BadgeSize, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold" Foreground="#6EC3FF" TextWrapping="NoWrap"/>
                                                     </Border>

                                                     <!-- Join Type Badge -->
                                                     <Border CornerRadius="4" Background="#1C2433" BorderBrush="#374663" BorderThickness="1" Padding="6,2" Margin="0,0,6,2" VerticalAlignment="Center">
                                                         <Border.Style>
                                                             <Style TargetType="Border">
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding IsFound}" Value="False">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Border.Style>
                                                         <TextBlock Text="{Binding JoinTypeDisplay}" FontSize="{Binding DataContext.Typography.BadgeSize, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold" Foreground="#A5B4FC" TextWrapping="NoWrap"/>
                                                     </Border>

                                                    <!-- Managed Badge -->
                                                    <Border CornerRadius="4" Background="#102E1B" BorderBrush="#257A42" BorderThickness="1" Padding="6,2" Margin="0,0,6,2" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsManaged}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="Managed" FontSize="{Binding DataContext.Typography.BadgeSize, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold" Foreground="#5CDA89" TextWrapping="NoWrap"/>
                                                    </Border>

                                                    <!-- Disabled Badge -->
                                                    <Border CornerRadius="4" Background="#3A1418" BorderBrush="#63232A" BorderThickness="1" Padding="6,2" Margin="0,0,6,2" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="Disabled" FontSize="{Binding DataContext.Typography.BadgeSize, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="Bold" Foreground="#FF7B88" TextWrapping="NoWrap"/>
                                                    </Border>

                                                    <!-- View in AD Quick Action -->
                                                    <Button Command="{Binding LookupInAdCommand}"
                                                            ToolTip="Search this hostname in On-Premises AD Computer View"
                                                            Padding="7,2"
                                                            Margin="0,0,0,2"
                                                            VerticalAlignment="Center">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFound}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{x:Static res:Glyphs.Computer}" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Brush.Info.Light}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="View in AD" FontSize="10.5" Foreground="{DynamicResource Brush.Info.Light}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Right Header Actions -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border CornerRadius="4" Background="#382810" BorderBrush="#5C421A" BorderThickness="1" Padding="5,1" Margin="0,0,6,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding RelativeAgeText, StringFormat='searched {0}'}" FontSize="10" Foreground="#FFC069" VerticalAlignment="Center"/>
                                                </Border>

                                                <TextBlock Text="{Binding TimeFormatted}"
                                                           FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding CopySummaryCommand}"
                                                        ToolTip="Copy Entra summary"
                                                        Padding="5,3"
                                                        Margin="0,0,4,0">
                                                    <Grid>
                                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSummaryCopied}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#5CDA89">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSummaryCopied}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding RefreshCommand}"
                                                        ToolTip="Re-query Microsoft Graph and update card"
                                                        Padding="5,3"
                                                        Margin="0,0,4,0">
                                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                </Button>

                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding ToggleExpandCommand}"
                                                        ToolTip="Collapse card"
                                                        Padding="5,3"
                                                        Margin="0,0,4,0">
                                                    <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                </Button>

                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding RemoveCommand}"
                                                        ToolTip="Remove record"
                                                        Padding="5,3">
                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 1. Multi-Record Device Switcher (collapsible, collapsed by default when > 1 Entra record matched) -->
                                        <Border Grid.Row="1"
                                                Background="#141C27"
                                                BorderBrush="#27364A"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,6"
                                                Margin="0,8,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMultipleDevices}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel>
                                                <Button Command="{Binding ToggleDeviceSwitcherCommand}"
                                                        Cursor="Hand"
                                                        FocusVisualStyle="{x:Null}"
                                                        HorizontalContentAlignment="Stretch">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent" Padding="0,2">
                                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="10"
                                                                   Foreground="#8BB9E8"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,7,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="&#xE70D;"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDeviceSwitcherExpanded}" Value="True">
                                                                            <Setter Property="Text" Value="&#xE70E;"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="1"
                                                                   FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   Foreground="#8BB9E8"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="{Binding MatchedDeviceCount, Mode=OneWay}"/>
                                                            <Run Text=" Entra device records matched"/>
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="2"
                                                                   FontSize="{Binding DataContext.Typography.NotesSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Show other records"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDeviceSwitcherExpanded}" Value="True">
                                                                            <Setter Property="Text" Value="Hide other records"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>

                                                <ItemsControl ItemsSource="{Binding DeviceOptions}" Margin="0,6,0,0">
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDeviceSwitcherExpanded}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type cards:EntraDeviceRecordOption}">
                                                            <Button Style="{StaticResource DeviceOptionButton}"
                                                                    Command="{Binding ElementName=RootCard, Path=DataContext.SelectDeviceCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Margin="0,0,6,4">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Label}"
                                                                               FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                                    <TextBlock Text="{Binding SubLabel}"
                                                                               FontSize="{Binding DataContext.Typography.NotesSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                               Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- 2. Divider -->
                                        <Border Grid.Row="2"
                                                Height="1"
                                                Background="{DynamicResource Brush.Border}"
                                                Margin="0,8,0,8"/>

                                        <!-- 3A. Error Box (Not Found / Graph Error) -->
                                        <Border Grid.Row="3"
                                                Background="#251214"
                                                BorderBrush="#4B171A"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFound}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="Entra Device Not Found or Query Failed"
                                                           FontWeight="Bold"
                                                           Foreground="#FF7B88"
                                                           FontSize="12"
                                                           Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding ErrorMessage}"
                                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 3B. Two-Column Device Details -->
                                        <Grid Grid.Row="3">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFound}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- LEFT COLUMN: IDENTITY, HARDWARE & SYNC -->
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource Brush.Surface.1}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8">
                                                <StackPanel>
                                                    <TextBlock Text="ENTRA DEVICE IDENTITY"
                                                               FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                                               Margin="0,0,0,6"/>

                                                    <!-- Object ID -->
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock Text="Object ID: " FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Text.Muted}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource InlineLinkButton}"
                                                                Command="{Binding CopyTextCommand}"
                                                                CommandParameter="{Binding ObjectId}"
                                                                ToolTip="Click to copy Entra Object ID">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding ObjectId}" FontFamily="Consolas" FontSize="{Binding DataContext.Typography.NotesSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text=" &#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DockPanel>

                                                    <!-- Device ID -->
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock Text="Device ID: " FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Text.Muted}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource InlineLinkButton}"
                                                                Command="{Binding CopyTextCommand}"
                                                                CommandParameter="{Binding DeviceId}"
                                                                ToolTip="Click to copy Entra Device ID">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DeviceId}" FontFamily="Consolas" FontSize="{Binding DataContext.Typography.NotesSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text=" &#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DockPanel>

                                                    <!-- OS & Version -->
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock Text="OS / Version: " FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Text.Muted}" DockPanel.Dock="Left"/>
                                                        <TextBlock Text="{Binding OperatingSystemDisplay}" FontSize="{Binding DataContext.Typography.BodySize, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                                                    </DockPanel>

                                                    <!-- Hardware -->
                                                    <DockPanel Margin="0,0,0,4">
                                                        <DockPanel.Style>
                                                            <Style TargetType="DockPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasHardware}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DockPanel.Style>
                                                        <TextBlock Text="Hardware: " FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Text.Muted}" DockPanel.Dock="Left"/>
                                                        <TextBlock Text="{Binding HardwareDisplay}" FontSize="{Binding DataContext.Typography.BodySize, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                                                    </DockPanel>

                                                    <!-- Join Type -->
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock Text="Join Type: " FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Text.Muted}" DockPanel.Dock="Left"/>
                                                        <TextBlock Text="{Binding JoinTypeDisplay}" FontSize="{Binding DataContext.Typography.BodySize, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold" Foreground="#D8B4FE" TextWrapping="Wrap"/>
                                                    </DockPanel>

                                                    <!-- On-Prem Sync -->
                                                    <DockPanel>
                                                        <TextBlock Text="On-Prem Sync: " FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Text.Muted}" DockPanel.Dock="Left"/>
                                                        <TextBlock Text="{Binding OnPremSyncDisplay}" FontSize="{Binding DataContext.Typography.NotesSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- RIGHT COLUMN: MDM, ACTIVITY & OWNERSHIP -->
                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource Brush.Surface.1}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8">
                                                <StackPanel>
                                                    <TextBlock Text="MDM, ACTIVITY &amp; OWNERSHIP"
                                                               FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                                               Margin="0,0,0,6"/>

                                                    <!-- MDM -->
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock Text="MDM: " FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Text.Muted}" DockPanel.Dock="Left"/>
                                                        <TextBlock Text="{Binding MdmDisplayName}" FontSize="{Binding DataContext.Typography.BodySize, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                                                    </DockPanel>

                                                    <!-- Account Status -->
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock Text="Account Status: " FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Text.Muted}" DockPanel.Dock="Left"/>
                                                        <TextBlock FontSize="{Binding DataContext.Typography.BodySize, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Enabled"/>
                                                                    <Setter Property="Foreground" Value="#5CDA89"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                            <Setter Property="Text" Value="Disabled"/>
                                                                            <Setter Property="Foreground" Value="#FF7B88"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DockPanel>

                                                    <!-- Activity -->
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock Text="Last Activity: " FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Text.Muted}" DockPanel.Dock="Left"/>
                                                        <TextBlock Text="{Binding LastActivityDisplay}" FontSize="{Binding DataContext.Typography.NotesSize, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                                                    </DockPanel>

                                                    <!-- Registration Date -->
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock Text="Registered: " FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Text.Muted}" DockPanel.Dock="Left"/>
                                                        <TextBlock Text="{Binding RegistrationDateDisplay}" FontSize="{Binding DataContext.Typography.NotesSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                                                    </DockPanel>

                                                    <!-- Device Owner(s) -->
                                                    <StackPanel Margin="0,0,0,4">
                                                        <TextBlock Text="Device Owner(s):" FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,2"/>

                                                        <TextBlock Text="None" FontSize="{Binding DataContext.Typography.NotesSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Text.Muted}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasOwners}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <ItemsControl ItemsSource="{Binding Owners}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                        <Button Style="{StaticResource InlineLinkButton}"
                                                                                Command="{Binding ElementName=RootCard, Path=DataContext.LookupUserInAdCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="Open user in AD User View">
                                                                            <TextBlock FontSize="{Binding DataContext.Typography.NotesSize, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold">
                                                                                <Run Text="{Binding DisplayName, Mode=OneWay}"/>
                                                                                <Run Text=" (" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                                                <Run Text="{Binding UserPrincipalName, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                                                <Run Text=")" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                                            </TextBlock>
                                                                        </Button>
                                                                        <Button Style="{StaticResource InlineLinkButton}"
                                                                                Command="{Binding ElementName=RootCard, Path=DataContext.CopyTextCommand}"
                                                                                CommandParameter="{Binding UserPrincipalName}"
                                                                                ToolTip="Copy owner UPN"
                                                                                Margin="6,0,0,0">
                                                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- 4. Entra Groups Section -->
                                        <Border Grid.Row="4"
                                                Background="{DynamicResource Brush.Surface.1}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,8"
                                                Margin="0,10,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFound}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel>
                                                <!-- Groups Collapsible Header + Controls -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0"
                                                            Command="{Binding ToggleGroupsExpandedCommand}"
                                                            Cursor="Hand"
                                                            FocusVisualStyle="{x:Null}"
                                                            HorizontalContentAlignment="Stretch"
                                                            ToolTip="Expand or collapse Entra group memberships">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent" Padding="0,2">
                                                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>

                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,7,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="&#xE70D;"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsGroupsExpanded}" Value="True">
                                                                                <Setter Property="Text" Value="&#xE70E;"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <TextBlock Text="ENTRA GROUPS"
                                                                       FontSize="{Binding DataContext.Typography.BadgeSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock FontSize="{Binding DataContext.Typography.BadgeSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                                                       VerticalAlignment="Center">
                                                                <Run Text=" ("/>
                                                                <Run Text="{Binding TotalGroupCount, Mode=OneWay}"/>
                                                                <Run Text=" total • "/>
                                                                <Run Text="{Binding DirectGroupCount, Mode=OneWay}"/>
                                                                <Run Text=" direct)"/>
                                                            </TextBlock>
                                                            <TextBlock FontSize="{Binding DataContext.Typography.NotesSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="• Show groups"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsGroupsExpanded}" Value="True">
                                                                                <Setter Property="Text" Value="• Hide"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Direct vs All Toggle -->
                                                    <Button Grid.Column="1"
                                                            Command="{Binding ToggleDirectOnlyCommand}"
                                                            ToolTip="Toggle between Direct memberships only or Direct + Transitive"
                                                            Padding="7,2"
                                                            Margin="6,0,6,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsGroupsExpanded}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock Text="{Binding DirectFilterButtonText}" FontSize="10"/>
                                                    </Button>

                                                    <!-- Filter Box Toggle -->
                                                    <Button Grid.Column="2"
                                                            Command="{Binding ToggleGroupFilterCommand}"
                                                            ToolTip="Filter Entra groups by name or ID"
                                                            Padding="7,2">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsGroupsExpanded}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Filter" FontSize="10"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>

                                                <!-- Group Lookup Error Banner -->
                                                <Border Background="#251214"
                                                        BorderBrush="#4B171A"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="8,6"
                                                        Margin="0,8,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasGroupLookupError}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding GroupLookupError}" Foreground="#FF7B88" FontSize="11" TextWrapping="Wrap"/>
                                                </Border>

                                                <!-- Collapsible Groups Body -->
                                                <StackPanel Margin="0,8,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGroupsExpanded}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <!-- Expandable Filter Input -->
                                                    <Border Background="{DynamicResource Brush.Surface}"
                                                            BorderBrush="{DynamicResource Brush.Border}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="6,4"
                                                            Margin="0,0,0,8">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsGroupFilterOpen}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="4,0,6,0"/>

                                                            <TextBox Grid.Column="1"
                                                                     Style="{x:Null}"
                                                                     Text="{Binding GroupFilter, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="Transparent"
                                                                     BorderThickness="0"
                                                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                                                     CaretBrush="{DynamicResource Brush.Text.Primary}"
                                                                     FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                     VerticalAlignment="Center"/>

                                                            <Button Grid.Column="2"
                                                                    Command="{Binding ClearGroupFilterCommand}"
                                                                    ToolTip="Clear filter"
                                                                    VerticalAlignment="Center"
                                                                    Margin="4,0,4,0">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource InlineLinkButton}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding GroupFilter}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                            </Button>

                                                            <Border Grid.Column="3"
                                                                    Background="{DynamicResource Brush.Surface.1}"
                                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="6,2"
                                                                    VerticalAlignment="Center"
                                                                    Margin="4,0,0,0">
                                                                <TextBlock FontSize="{Binding DataContext.Typography.NotesSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Text.Muted}">
                                                                    <Run Text="Showing "/>
                                                                    <Run Text="{Binding FilteredGroupCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                                    <Run Text=" of "/>
                                                                    <Run Text="{Binding TotalGroupCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Empty Groups Notice -->
                                                    <TextBlock Text="No Entra groups match the current filter."
                                                               FontSize="{Binding DataContext.Typography.NotesSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Foreground="{DynamicResource Brush.Text.Muted}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasFilteredGroups}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Groups Chips WrapPanel -->
                                                    <ItemsControl ItemsSource="{Binding FilteredGroups}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="6"
                                                                    Background="{DynamicResource Brush.Surface.Hover}"
                                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                                    BorderThickness="1"
                                                                    Margin="0,0,6,6"
                                                                    Padding="8,4">
                                                                <Border.ToolTip>
                                                                    <ToolTip>
                                                                        <StackPanel MaxWidth="340">
                                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,4,0,0">
                                                                                <Run Text="{Binding GroupTypeLabel, Mode=OneWay}"/>
                                                                                <Run Text=" • ID: "/>
                                                                                <Run Text="{Binding ObjectId, Mode=OneWay}"/>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </ToolTip>
                                                                </Border.ToolTip>

                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="&#xE902; " FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>

                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontSize="{Binding DataContext.Typography.CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                               FontWeight="Medium"
                                                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                                                               VerticalAlignment="Center"/>

                                                                    <!-- Direct vs Transitive Tag -->
                                                                    <Border CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="#1E242D"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsDirect}" Value="True">
                                                                                        <Setter Property="Background" Value="#122438"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock FontSize="9.5" FontWeight="SemiBold">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="Transitive"/>
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsDirect}" Value="True">
                                                                                            <Setter Property="Text" Value="Direct"/>
                                                                                            <Setter Property="Foreground" Value="#6EC3FF"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>

                                                                    <!-- Dynamic Tag -->
                                                                    <Border CornerRadius="3" Background="#281738" Padding="4,0" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsDynamic}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="Dynamic" FontSize="9.5" FontWeight="SemiBold" Foreground="#D8B4FE"/>
                                                                    </Border>

                                                                    <!-- AD Synced (clickable to view in AD GroupView) or Cloud Tag -->
                                                                    <Button Command="{Binding ElementName=RootCard, Path=DataContext.LookupGroupInAdCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="Synced from On-Prem AD — click to view members in Group View"
                                                                            Margin="4,0,0,0">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource InlineLinkButton}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSyncedFromOnPrem}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                        <Border CornerRadius="3" Background="#0E282A" Padding="4,0">
                                                                            <TextBlock Text="AD Synced" FontSize="9.5" FontWeight="SemiBold" Foreground="#5EEAD4"/>
                                                                        </Border>
                                                                    </Button>

                                                                    <Border CornerRadius="3" Background="#1A222D" Padding="4,0" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSyncedFromOnPrem}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="Cloud" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                                    </Border>

                                                                    <!-- Copy Group Name -->
                                                                    <Button Style="{StaticResource InlineLinkButton}"
                                                                            Command="{Binding ElementName=RootCard, Path=DataContext.CopyTextCommand}"
                                                                            CommandParameter="{Binding DisplayName}"
                                                                            ToolTip="Copy group name"
                                                                            Margin="6,0,0,0">
                                                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="{x:Static res:Strings.Common_Button_Clear}"
                        Command="{Binding ClearCommand}"
                        Style="{DynamicResource Button.FlowDoc}"
                        ToolTip="{x:Static res:Strings.Common_Tooltip_ClearHistory}"/>

                <Button Content="{x:Static res:Strings.Common_Button_CollapseAll}"
                        Command="{Binding CollapseAllCommand}"
                        Style="{DynamicResource Button.FlowDoc}"
                        ToolTip="{x:Static res:Strings.Common_Tooltip_CollapseAll}"/>

                <Button Content="{x:Static res:Strings.Common_Button_ExpandAll}"
                        Command="{Binding ExpandAllCommand}"
                        Style="{DynamicResource Button.FlowDoc}"
                        ToolTip="{x:Static res:Strings.Common_Tooltip_ExpandAll}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="A−"
                        Command="{Binding DecreaseFontCommand}"
                        Style="{DynamicResource Button.FlowDoc.Small}"
                        ToolTip="{x:Static res:Strings.Common_Tooltip_TextSizeDecrease}"/>
                <Button Content="A"
                        Command="{Binding ResetFontCommand}"
                        Style="{DynamicResource Button.FlowDoc.Small}"
                        ToolTip="{x:Static res:Strings.Common_Tooltip_TextSizeReset}"/>
                <Button Content="A+"
                        Command="{Binding IncreaseFontCommand}"
                        Style="{DynamicResource Button.FlowDoc.Small}"
                        Margin="6,0,0,0"
                        ToolTip="{x:Static res:Strings.Common_Tooltip_TextSizeIncrease}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>