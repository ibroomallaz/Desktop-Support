<UserControl x:Class="DSAMVVM.MVVM.View.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- GLOBAL TEXTBLOCK STYLE FOR THIS VIEW -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title and Selector -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,15">
            <TextBlock Text="JSON Data Administration" 
                       FontSize="20" 
                       FontWeight="SemiBold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton x:Name="RadioDept" Content="Department" IsChecked="True" Margin="0,0,20,0" Foreground="{DynamicResource Brush.Text.Primary}"/>
                <RadioButton x:Name="RadioTeam" Content="Support Team" Margin="0,0,20,0" Foreground="{DynamicResource Brush.Text.Primary}"/>
                <RadioButton x:Name="RadioLinks" Content="Links" Foreground="{DynamicResource Brush.Text.Primary}"/>
            </StackPanel>
        </StackPanel>

        <!-- Separator -->
        <Separator Grid.Row="1" Margin="0,0,0,20" Style="{DynamicResource {x:Static ToolBar.SeparatorStyleKey}}"/>

        <!-- Department Editor Panel -->
        <Grid Grid.Row="2" Visibility="{Binding IsChecked, ElementName=RadioDept, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Department ID:" Margin="0,0,15,15"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,15" Text="{Binding DeptId, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Support Known:" Margin="0,0,15,15"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,15" Height="35" SelectedIndex="0" Style="{DynamicResource Combo.Links.Dropdown}">
                <ComboBoxItem Content="True"/>
                <ComboBoxItem Content="False"/>
            </ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Support Team:" Margin="0,0,15,15"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,15" Text="{Binding DeptTeam, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Notes:" VerticalAlignment="Top" Margin="0,10,15,15"/>
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,15" MinHeight="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,10" Text="{Binding DeptNotes, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Support Team Editor Panel -->
        <Grid Grid.Row="2" Visibility="{Binding IsChecked, ElementName=RadioTeam, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Team Name:" Margin="0,0,15,15"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,15" Text="{Binding TeamName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Manager Name:" Margin="0,0,15,15"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,15" Text="{Binding ManagerName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Manager NetID:" Margin="0,0,15,15"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,15" Text="{Binding ManagerNetId, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Support Number:" Margin="0,0,15,15"/>
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,15" Text="{Binding SupportNumber, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Divisions:" VerticalAlignment="Top" Margin="0,10,15,15"/>
            <Expander Grid.Row="4" Grid.Column="1" Header="Manage Supported Divisions..." Margin="0,0,0,15" Foreground="{DynamicResource Brush.Text.Primary}">
                <StackPanel Margin="10">
                    <TextBlock Text="[Division List / Add / Remove Controls]" Opacity="0.6" FontStyle="Italic"/>
                </StackPanel>
            </Expander>
        </Grid>

        <!-- Links Editor Panel -->
        <Grid Grid.Row="2" Visibility="{Binding IsChecked, ElementName=RadioLinks, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Link Type:" Margin="0,0,15,25"/>
            <ComboBox x:Name="ComboLinkType" Grid.Row="0" Grid.Column="1" Margin="0,0,0,25" Height="35" SelectedIndex="{Binding SelectedLinkTypeIndex}" Style="{DynamicResource Combo.Links.Dropdown}">
                <ComboBoxItem Content="Common"/>
                <ComboBoxItem Content="Team"/>
            </ComboBox>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Target Team:" Margin="0,0,15,15">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=ComboLinkType}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,15" Height="35">
                <ComboBox.Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource Combo.Links.Dropdown}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=ComboLinkType}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
                <ComboBoxItem Content="-- Select a Team --" IsSelected="True"/>
            </ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Display Name:" Margin="0,0,15,15"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,15" Text="{Binding LinkDisplayName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Description:" Margin="0,0,15,15"/>
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,15" Text="{Binding LinkDescription, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="URL:" Margin="0,0,15,15"/>
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,15" Text="{Binding LinkUrl, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Action Buttons -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" 
                        Width="100" 
                        Height="32" 
                        Style="{DynamicResource Button.Rounded}"
                        Opacity="0.8"
                        Margin="0,0,10,0"/>

                <Button Content="Save Changes" 
                        Command="{Binding SaveCommand}"
                        Width="130" 
                        Height="32" 
                        Style="{DynamicResource Button.Rounded}"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>