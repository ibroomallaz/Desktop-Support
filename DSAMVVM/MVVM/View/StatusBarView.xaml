<UserControl x:Class="DSAMVVM.MVVM.View.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:statusRend="clr-namespace:DSAMVVM.MVVM.View.Renderers.Status"
             xmlns:res="clr-namespace:DSAMVVM.MVVM.View.Resources"
             xmlns:models="clr-namespace:DSAMVVM.Core.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="40"
             d:DesignWidth="400">

    <Grid UseLayoutRounding="True">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentStatusItem}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Border x:Name="StatusCard"
                Padding="12,5"
                MinHeight="28"
                VerticalAlignment="Bottom"
                CornerRadius="8"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" Color="#000000"/>
            </Border.Effect>

            <Border.Style>
                <Style TargetType="Border">
                    <!-- Default (Neutral / Info): Theme neutral card gradient and crisp outline -->
                    <Setter Property="Background" Value="{DynamicResource CardGradient.Surface.L1}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Neutral.Border}"/>
                    <Style.Triggers>
                        <!-- Success -->
                        <DataTrigger Binding="{Binding CurrentStatusItem.Level}" Value="{x:Static models:StatusLevel.Success}">
                            <Setter Property="Background" Value="{DynamicResource Brush.Status.Success.Bg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Success.Border}"/>
                        </DataTrigger>
                        <!-- Warning -->
                        <DataTrigger Binding="{Binding CurrentStatusItem.Level}" Value="{x:Static models:StatusLevel.Warning}">
                            <Setter Property="Background" Value="{DynamicResource Brush.Status.Warning.Bg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Warning.Border}"/>
                        </DataTrigger>
                        <!-- Error -->
                        <DataTrigger Binding="{Binding CurrentStatusItem.Level}" Value="{x:Static models:StatusLevel.Error}">
                            <Setter Property="Background" Value="{DynamicResource Brush.Status.Error.Bg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Error.Border}"/>
                        </DataTrigger>
                        <!-- Info -->
                        <DataTrigger Binding="{Binding CurrentStatusItem.Level}" Value="{x:Static models:StatusLevel.Info}">
                            <Setter Property="Background" Value="{DynamicResource CardGradient.Surface.L1}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Neutral.Border}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Level Icon Glyph -->
                <TextBlock Grid.Column="0"
                           x:Name="StatusGlyph"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{x:Static res:Glyphs.About}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Info.Icon}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStatusItem.Level}" Value="{x:Static models:StatusLevel.Success}">
                                    <Setter Property="Text" Value="{x:Static res:Glyphs.Checkmark}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Success.Icon}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentStatusItem.Level}" Value="{x:Static models:StatusLevel.Warning}">
                                    <Setter Property="Text" Value="{x:Static res:Glyphs.Warning}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Warning.Icon}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentStatusItem.Level}" Value="{x:Static models:StatusLevel.Error}">
                                    <Setter Property="Text" Value="{x:Static res:Glyphs.Warning}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Error.Icon}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentStatusItem.Level}" Value="{x:Static models:StatusLevel.Info}">
                                    <Setter Property="Text" Value="{x:Static res:Glyphs.About}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Info.Icon}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Status Content Spans -->
                <TextBlock Grid.Column="1"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           statusRend:StatusItemRenderer.Item="{Binding CurrentStatusItem}" />

                <!-- Dismiss Button -->
                <Button Grid.Column="2"
                        Command="{Binding DismissCommand}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Margin="8,0,0,0"
                        Width="20"
                        Height="20"
                        Cursor="Hand"
                        ToolTip="Dismiss">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" 
                                    Background="Transparent" 
                                    CornerRadius="10">
                                <TextBlock Text="{x:Static res:Glyphs.Dismiss}" 
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="8" 
                                           Foreground="{DynamicResource Brush.Text.Primary}" 
                                           Opacity="0.6" 
                                           x:Name="BtnText"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Brush.Status.Dismiss.Hover}"/>
                                    <Setter TargetName="BtnText" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Brush.Status.Dismiss.Pressed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>