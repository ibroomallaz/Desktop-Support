<UserControl x:Class="DSAMVVM.MVVM.View.LinksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5,0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="10,5,0,20" Orientation="Horizontal">

                <!-- Common Links -->
                <StackPanel Margin="10" Orientation="Vertical">
                    <Label Content="Common Links"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MenuTextPrimaryBrush}"
                           HorizontalAlignment="Center"/>

                    <Border Width="300"
                            Height="250"
                            CornerRadius="10"
                            VerticalAlignment="Top" 
                            Background="{DynamicResource Brush.Card.Alternate}"
                            BorderBrush="{DynamicResource Brush.Card.Border.Alternate}"
                            HorizontalAlignment="Center">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock Padding="10,10,10,10">
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding CommonLinks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="17"
                                                           HorizontalAlignment="Left"
                                                           Padding="5,5,5,5"
                                                           Foreground="{DynamicResource MenuTextPrimaryBrush}">
                                                    <Hyperlink NavigateUri="{Binding URL}" RequestNavigate="Hyperlink_RequestNavigate">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{DynamicResource MenuTextPrimaryBrush}"/>
                                                    </Hyperlink>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </TextBlock>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- Team Links -->
                <StackPanel Margin="10" Orientation="Vertical">
                    <Label Content="Team Links"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MenuTextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                    <!-- Dropdown (non-editable) -->
                    <ComboBox Style="{StaticResource Combo.Links.Dropdown}"
          Width="250" Height="24"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Margin="0,0,0,13">
                        <ComboBoxItem Content="Change Team Links"/>
                        <ComboBoxItem Content="DST"/>
                        <ComboBoxItem Content="Example 1"/>
                        <ComboBoxItem Content="Example 2"/>
                        <ComboBoxItem Content="Example 3"/>
                    </ComboBox>

                    <Border Width="300"
                            Height="215"
                            CornerRadius="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" 
                            Background="{DynamicResource Brush.Card.Alternate}"
                            BorderBrush="{DynamicResource Brush.Card.Border.Alternate}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock Padding="10,10,10,10">
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding TeamLinks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,20,0">
                                                    <Label Content="{Binding GroupName}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource MenuTextPrimaryBrush}"/>
                                                    <ItemsControl ItemsSource="{Binding Links}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock FontSize="17"
                                                                           HorizontalAlignment="Left"
                                                                           Padding="5,5,5,5"
                                                                           Foreground="{DynamicResource MenuTextPrimaryBrush}">
                                                                    <Hyperlink NavigateUri="{Binding URL}" RequestNavigate="Hyperlink_RequestNavigate">
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   Foreground="{DynamicResource MenuTextPrimaryBrush}"/>
                                                                    </Hyperlink>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </TextBlock>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
