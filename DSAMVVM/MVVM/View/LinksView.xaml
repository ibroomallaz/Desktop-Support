<UserControl x:Class="DSAMVVM.MVVM.View.LinksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <TextDecorationCollection x:Key="Underline.Hover">
            <TextDecoration Location="Underline">
                <TextDecoration.Pen>
                    <Pen Brush="{DynamicResource Brush.Accent}" Thickness="1.25"/>
                </TextDecoration.Pen>
                <TextDecoration.PenThicknessUnit>FontRecommended</TextDecoration.PenThicknessUnit>
            </TextDecoration>
        </TextDecorationCollection>

        <Style x:Key="InlineLinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground"      Value="{DynamicResource MenuTextPrimaryBrush}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground"      Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="TextDecorations" Value="{StaticResource Underline.Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TeamNameTemplate">
            <TextBlock Text="{Binding}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding}"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Main content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="5,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <StackPanel Margin="10,5,0,20" Orientation="Horizontal">

                <!-- Common Links -->
                <StackPanel Margin="10" Orientation="Vertical">
                    <Label Content="Common Links"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MenuTextPrimaryBrush}"
                           HorizontalAlignment="Center"/>

                    <Border Width="300"
                            Height="250"
                            CornerRadius="10"
                            VerticalAlignment="Top"
                            Background="{DynamicResource Brush.Card.Alternate}"
                            BorderBrush="{DynamicResource Brush.Card.Border.Alternate}"
                            HorizontalAlignment="Center">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CommonLinks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="17"
                                                   HorizontalAlignment="Left"
                                                   Padding="22,8,6,8"
                                                   Foreground="{DynamicResource MenuTextPrimaryBrush}"
                                                   ToolTipService.InitialShowDelay="300"
                                                   ToolTipService.ShowDuration="120000">
                                            <TextBlock.ToolTip>
                                                <StackPanel MaxWidth="360">
                                                    <!-- Description if present -->
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </TextBlock.ToolTip>

                                            <!-- Robust bindings: Title|Name and Url|URL|Uri|Href -->
                                            <Hyperlink Style="{StaticResource InlineLinkStyle}"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                <Hyperlink.NavigateUri>
                                                    <PriorityBinding>
                                                        <Binding Path="Url"/>
                                                        <Binding Path="URL"/>
                                                        <Binding Path="Uri"/>
                                                        <Binding Path="Href"/>
                                                    </PriorityBinding>
                                                </Hyperlink.NavigateUri>
                                                <Run>
                                                    <Run.Text>
                                                        <PriorityBinding>
                                                            <Binding Path="Title"/>
                                                            <Binding Path="Name"/>
                                                            <Binding Path="DisplayName"/>
                                                        </PriorityBinding>
                                                    </Run.Text>
                                                </Run>
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- Team Links -->
                <StackPanel Margin="10" Orientation="Vertical">
                    <Label Content="Team Links"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MenuTextPrimaryBrush}"
                           HorizontalAlignment="Center"/>

                    <ComboBox Style="{StaticResource Combo.Links.Dropdown}"
                              Width="260" Height="32"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="0,0,0,13"
                              ItemsSource="{Binding TeamNames}"
                              SelectedItem="{Binding SelectedTeam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsSynchronizedWithCurrentItem="False"
                              ItemTemplate="{StaticResource TeamNameTemplate}"/>

                    <Border Width="300"
                            Height="215"
                            CornerRadius="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Card.Alternate}"
                            BorderBrush="{DynamicResource Brush.Card.Border.Alternate}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SelectedTeamLinks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="17"
                                                   HorizontalAlignment="Left"
                                                   Padding="22,8,6,8"
                                                   Foreground="{DynamicResource MenuTextPrimaryBrush}"
                                                   ToolTipService.InitialShowDelay="300"
                                                   ToolTipService.ShowDuration="120000">
                                            <TextBlock.ToolTip>
                                                <StackPanel MaxWidth="360">
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </TextBlock.ToolTip>

                                            <!-- Robust bindings: Title|Name and Url|URL|Uri|Href -->
                                            <Hyperlink Style="{StaticResource InlineLinkStyle}"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                <Hyperlink.NavigateUri>
                                                    <PriorityBinding>
                                                        <Binding Path="Url"/>
                                                        <Binding Path="URL"/>
                                                        <Binding Path="Uri"/>
                                                        <Binding Path="Href"/>
                                                    </PriorityBinding>
                                                </Hyperlink.NavigateUri>
                                                <Run>
                                                    <Run.Text>
                                                        <PriorityBinding>
                                                            <Binding Path="Title"/>
                                                            <Binding Path="Name"/>
                                                            <Binding Path="DisplayName"/>
                                                        </PriorityBinding>
                                                    </Run.Text>
                                                </Run>
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom-right Reload button (overlay) -->
        <Button Content="Reload Links"
                Command="{Binding ReloadLinksCommand}"
                ToolTip="Force refresh links data"
                MinHeight="28"
                Padding="10,4"
                Margin="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Button.Rounded}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReloading}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
