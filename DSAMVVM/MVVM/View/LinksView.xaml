<UserControl x:Class="DSAMVVM.MVVM.View.LinksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <!-- resources -->
    <UserControl.Resources>

        <!-- link hover (local safe defaults + alias) -->
        <SolidColorBrush x:Key="Brush.Links.LinkHover.UARed"  Color="#FF8C1D40"/>
        <SolidColorBrush x:Key="Brush.Links.LinkHover.Indigo" Color="#FF7FA0FF"/>
        <StaticResource x:Key="Brush.Links.LinkHover" ResourceKey="Brush.Links.LinkHover.UARed"/>

        <TextDecorationCollection x:Key="Underline.Hover">
            <TextDecoration Location="Underline">
                <TextDecoration.Pen>
                    <Pen Brush="{StaticResource Brush.Links.LinkHover}" Thickness="1.25"/>
                </TextDecoration.Pen>
                <TextDecoration.PenThicknessUnit>FontRecommended</TextDecoration.PenThicknessUnit>
            </TextDecoration>
        </TextDecorationCollection>

        <Style x:Key="InlineLinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource MenuTextPrimaryBrush}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Links.LinkHover}"/>
                    <Setter Property="TextDecorations" Value="{StaticResource Underline.Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TeamNameTemplate">
            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
        </DataTemplate>

        <!-- links card container using your new gradients -->
        <CornerRadius x:Key="Links.Card.Radius.Inner">10</CornerRadius>
        <CornerRadius x:Key="Links.Card.Radius.Outer">12</CornerRadius>

        <Style x:Key="LinksCard" TargetType="ContentControl">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <!-- outer rim -->
                            <Border CornerRadius="{StaticResource Links.Card.Radius.Outer}"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource BorderGradient.Links.Rim}"
                                    BorderThickness="1.25"/>

                            <!-- inner card -->
                            <Border x:Name="Card"
                                    CornerRadius="{StaticResource Links.Card.Radius.Inner}"
                                    Background="{DynamicResource CardGradient.Links.Surface}"
                                    BorderBrush="{DynamicResource Brush.Links.Card.Border}"
                                    BorderThickness="1">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- hover lift -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="{DynamicResource CardGradient.Links.Surface.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- layout -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="5,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <StackPanel Margin="10,5,0,20" Orientation="Horizontal">

                <!-- common links -->
                <StackPanel Margin="10" Orientation="Vertical">
                    <Label Content="Common Links"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MenuTextPrimaryBrush}"
                           HorizontalAlignment="Center"/>

                    <ContentControl Style="{StaticResource LinksCard}"
                                    Width="300" Height="250"
                                    HorizontalAlignment="Center">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CommonLinks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="17"
                                                   HorizontalAlignment="Left"
                                                   Padding="22,8,6,8"
                                                   Foreground="{DynamicResource MenuTextPrimaryBrush}"
                                                   ToolTipService.InitialShowDelay="300"
                                                   ToolTipService.ShowDuration="120000">
                                            <TextBlock.ToolTip>
                                                <StackPanel MaxWidth="360">
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </TextBlock.ToolTip>
                                            <Hyperlink Style="{StaticResource InlineLinkStyle}"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                <Hyperlink.NavigateUri>
                                                    <PriorityBinding>
                                                        <Binding Path="Url"/>
                                                        <Binding Path="URL"/>
                                                        <Binding Path="Uri"/>
                                                        <Binding Path="Href"/>
                                                    </PriorityBinding>
                                                </Hyperlink.NavigateUri>
                                                <Run>
                                                    <Run.Text>
                                                        <PriorityBinding>
                                                            <Binding Path="Title"/>
                                                            <Binding Path="Name"/>
                                                            <Binding Path="DisplayName"/>
                                                        </PriorityBinding>
                                                    </Run.Text>
                                                </Run>
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </ContentControl>
                </StackPanel>

                <!-- team links -->
                <StackPanel Margin="10" Orientation="Vertical">
                    <Label Content="Team Links"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MenuTextPrimaryBrush}"
                           HorizontalAlignment="Center"/>

                    <ComboBox Style="{StaticResource Combo.Links.Dropdown}"
                              Width="260" Height="32"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="0,0,0,13"
                              ItemsSource="{Binding TeamNames}"
                              SelectedItem="{Binding SelectedTeam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsSynchronizedWithCurrentItem="False"
                              ItemTemplate="{StaticResource TeamNameTemplate}"/>

                    <ContentControl Style="{StaticResource LinksCard}"
                                    Width="300" Height="215"
                                    HorizontalAlignment="Center">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SelectedTeamLinks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="17"
                                                   HorizontalAlignment="Left"
                                                   Padding="22,8,6,8"
                                                   Foreground="{DynamicResource MenuTextPrimaryBrush}"
                                                   ToolTipService.InitialShowDelay="300"
                                                   ToolTipService.ShowDuration="120000">
                                            <TextBlock.ToolTip>
                                                <StackPanel MaxWidth="360">
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </TextBlock.ToolTip>
                                            <Hyperlink Style="{StaticResource InlineLinkStyle}"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                <Hyperlink.NavigateUri>
                                                    <PriorityBinding>
                                                        <Binding Path="Url"/>
                                                        <Binding Path="URL"/>
                                                        <Binding Path="Uri"/>
                                                        <Binding Path="Href"/>
                                                    </PriorityBinding>
                                                </Hyperlink.NavigateUri>
                                                <Run>
                                                    <Run.Text>
                                                        <PriorityBinding>
                                                            <Binding Path="Title"/>
                                                            <Binding Path="Name"/>
                                                            <Binding Path="DisplayName"/>
                                                        </PriorityBinding>
                                                    </Run.Text>
                                                </Run>
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </ContentControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- reload -->
        <Button Content="Reload Links"
                Command="{Binding ReloadLinksCommand}"
                ToolTip="Force refresh links data"
                MinHeight="28"
                Padding="10,4"
                Margin="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Button.Rounded}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReloading}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
