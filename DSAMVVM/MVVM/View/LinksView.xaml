<UserControl x:Class="DSAMVVM.MVVM.View.LinksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <!-- Common Links -->
            <TextBlock Text="Common Links"
                       FontWeight="Bold"
                       FontSize="14"
                       Margin="0,0,0,5" />

            <ItemsControl ItemsSource="{Binding CommonLinks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding URL}"
                                       Foreground="Blue"
                                       Cursor="Hand"
                                       TextDecorations="Underline"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Team Links -->
            <TextBlock Text="Team Links"
                       FontWeight="Bold"
                       FontSize="14"
                       Margin="0,15,0,5" />

            <ItemsControl ItemsSource="{Binding TeamLinks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding GroupName}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,3"/>

                            <ItemsControl ItemsSource="{Binding Links}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="{Binding Name}"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding URL}"
                                                       Foreground="Blue"
                                                       Cursor="Hand"
                                                       TextDecorations="Underline"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
