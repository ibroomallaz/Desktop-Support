<UserControl x:Class="DSAMVVM.MVVM.View.LinksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DSAMVVM.MVVM.ViewModel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LinksViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="520"
             d:DesignWidth="840">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theme/Colors/Colors.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Decor/Gradient.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/Button.Rounded.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/LinksComboBoxTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Card surface container -->
            <Style x:Key="Card.Surface" TargetType="Border">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="{DynamicResource CardGradient.Surface.L1}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Card.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- Compact rounded button -->
            <Style x:Key="Button.Rounded.Compact" TargetType="Button" BasedOn="{StaticResource Button.Rounded}">
                <Setter Property="Padding"   Value="10,3"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="Height"    Value="26"/>
                <Setter Property="FontSize"  Value="11"/>
                <Setter Property="MinWidth"  Value="0"/>
            </Style>

            <!-- Subtle icon button for copy / open -->
            <Style x:Key="SubtleIconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="#25FFFFFF"/>
                                    <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#35FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="#40FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sleek Single-Line Link Tile Template -->
            <DataTemplate x:Key="LinkTileTemplate" DataType="{x:Type vm:LinkDisplayItem}">
                <Border CornerRadius="6"
                        Background="{DynamicResource Brush.Surface.1}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        Padding="8,5"
                        Margin="0,0,0,4"
                        SnapsToDevicePixels="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CardGradient.Surface.Hover}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Active}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <!-- Mouseover Tooltip with Name, Description, and URL -->
                    <Border.ToolTip>
                        <ToolTip>
                            <StackPanel MaxWidth="320">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding Description}" Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" FontSize="10.5" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Url}" FontSize="9.5" Foreground="{DynamicResource Brush.Info.Light}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </ToolTip>
                    </Border.ToolTip>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon badge -->
                        <Border Grid.Column="0"
                                Width="24" Height="24"
                                CornerRadius="5"
                                Background="#153AA0FF"
                                BorderBrush="#253AA0FF"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                            <TextBlock Text="&#xE774;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.Info.Light}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Link Name (Click to open) -->
                        <Border Grid.Column="1"
                                Background="Transparent"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Actions (Copy, Open) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Button Style="{StaticResource SubtleIconButton}"
                                    ToolTip="Copy URL to clipboard"
                                    Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="&#xE8C8;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource Brush.Text.Muted}"/>
                            </Button>

                            <Button Style="{StaticResource SubtleIconButton}"
                                    ToolTip="Open link in default browser"
                                    Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="2,0,0,0">
                                <TextBlock Text="&#xE8A7;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource Brush.Text.Muted}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="14,10,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== TOP HEADER BANNER ===================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardGradient.Surface.L1}"
                BorderBrush="{DynamicResource Brush.Card.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8"
                Margin="0,0,0,10"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="32" Height="32"
                        CornerRadius="8"
                        Background="#183AA0FF"
                        BorderBrush="#353AA0FF"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                    <TextBlock Text="&#xE774;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="{DynamicResource Brush.Info.Light}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Links Directory"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock Text="Quick access to common university portals and team resources"
                       FontSize="10.5"
                       Foreground="{DynamicResource Brush.Text.Muted}"
                       Margin="0,1,0,0"/>
                </StackPanel>

                <!-- Reload Button -->
                <Button Grid.Column="2"
                        Command="{Binding ReloadLinksCommand}"
                        ToolTip="Force refresh links data"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Rounded.Compact}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReloading}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10.5"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <TextBlock Text="Reload Links" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ===================== 2-COLUMN MAIN CONTENT ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Common Links -->
            <Border Grid.Column="0" Style="{StaticResource Card.Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Red accent strip -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource CardGradient.Accent}"
                            CornerRadius="10,0,0,10"/>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="12,10,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE774;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.Accent.Red.Light}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="Common Links"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="University-wide"
                                       FontSize="10"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>

                            <Border Grid.Column="2"
                                    Background="#18FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding CommonLinksCount}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Muted}"/>
                            </Border>
                        </Grid>

                        <Separator Grid.Row="1" Margin="12,0,12,6" Background="{DynamicResource Brush.Border}" Opacity="0.4"/>

                        <!-- Links List -->
                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="12,0,10,10">
                            <ItemsControl ItemsSource="{Binding CommonLinks}"
                                          ItemTemplate="{StaticResource LinkTileTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: Team Links -->
            <Border Grid.Column="2" Style="{StaticResource Card.Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Blue accent strip -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource CardGradient.Info}"
                            CornerRadius="10,0,0,10"/>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="12,8,12,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7EF;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.Info.Light}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="Team"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Team Dropdown -->
                            <ComboBox Grid.Column="1"
                                      Style="{DynamicResource Combo.Links.Dropdown}"
                                      ItemsSource="{Binding TeamNames}"
                                      SelectedItem="{Binding SelectedTeam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsSynchronizedWithCurrentItem="False"
                                      Height="24"
                                      Margin="6,0,6,0"
                                      VerticalAlignment="Center"
                                      FontSize="10.5"/>

                            <!-- Count badge -->
                            <Border Grid.Column="2"
                                    Background="#18FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedTeamLinksCount}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Muted}"/>
                            </Border>
                        </Grid>

                        <Separator Grid.Row="1" Margin="12,0,12,6" Background="{DynamicResource Brush.Border}" Opacity="0.4"/>

                        <!-- Links List & Empty state -->
                        <Grid Grid.Row="2" Margin="12,0,10,10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,2,0">
                                <ItemsControl ItemsSource="{Binding SelectedTeamLinks}"
                                              ItemTemplate="{StaticResource LinkTileTemplate}"/>
                            </ScrollViewer>

                            <!-- Empty State -->
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Margin="16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedTeamLinks}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="&#xE711;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="No links found for this team"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
