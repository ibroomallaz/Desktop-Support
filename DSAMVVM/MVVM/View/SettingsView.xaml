<UserControl x:Class="DSAMVVM.MVVM.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:DSAMVVM"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Match About: same global theme dictionaries -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theme/Colors/Colors.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Decor/Gradient.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/Button.Rounded.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Card container style (same pattern used in About) -->
            <Style x:Key="Card.Container" TargetType="Border">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <!-- Use the same hover background token as About -->
                        <Setter Property="Background" Value="{DynamicResource CardGradient.Surface.Hover}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.7"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Compact rounded button to match About small CTAs -->
            <Style x:Key="Button.Rounded.Compact" TargetType="Button" BasedOn="{StaticResource Button.Rounded}">
                <Setter Property="Padding"   Value="8,2"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="Height"    Value="28"/>
                <Setter Property="MinWidth"  Value="0"/>
            </Style>

            <!-- Local helpers -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Label formatters for int-based ComboBoxes -->
            <DataTemplate x:Key="HistoryItemTemplate">
                <TextBlock Foreground="{DynamicResource Brush.Text.Primary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding StringFormat={}{0} items}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="0">
                                    <Setter Property="Text" Value="Never"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="1">
                                    <Setter Property="Text" Value="1 item"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DataTemplate>

            <DataTemplate x:Key="DaysItemTemplate">
                <TextBlock Foreground="{DynamicResource Brush.Text.Primary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding StringFormat={}{0} days}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="-1">
                                    <Setter Property="Text" Value="Keep indefinitely"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="1">
                                    <Setter Property="Text" Value="1 day"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DataTemplate>

            <DataTemplate x:Key="PtItemTemplate">
                <TextBlock Foreground="{DynamicResource Brush.Text.Primary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding StringFormat={}{0} pt}"/>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.Surface.0}">
        <!-- Row 0 = scrollable content, Row 1 = fixed bottom bar -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- SCROLLABLE CONTENT -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16" Orientation="Vertical">

                <!-- === SEARCH TEXT CARD === -->
                <Border Style="{StaticResource Card.Container}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left gradient accent -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource CardGradient.Accent}"
                                CornerRadius="12,0,0,12"/>

                        <StackPanel Grid.Column="1" Margin="16">
                            <TextBlock Text="Search text" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>

                            <!-- Default size at launch -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Default search size at launch" Style="{StaticResource FieldLabel}"/>

                                <ComboBox x:Name="InitialSizeCombo" Grid.Column="2"
                                          Style="{DynamicResource Combo.Links.Dropdown}"
                                          ItemsSource="{Binding InitialFontSizeOptions}"
                                          SelectedValue="{Binding DefaultFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="."
                                          ItemTemplate="{StaticResource PtItemTemplate}"
                                          SelectionChanged="InitialSizeCombo_SelectionChanged"/>
                            </Grid>

                            <!-- Default (app-wide) search size -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Default search text size" Style="{StaticResource FieldLabel}"/>

                                <Slider x:Name="GeneralSizeSlider" Grid.Column="2"
                                        Minimum="8" Maximum="24" TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding DefaultFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ValueChanged="GeneralSizeSlider_ValueChanged"/>
                                <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}">
                                    <Run Text="{Binding ElementName=GeneralSizeSlider, Path=Value, StringFormat=F0}"/>
                                    <Run Text=" pt"/>
                                </TextBlock>
                            </Grid>

                            <!-- Per-tab toggle -->
                            <CheckBox x:Name="UsePerViewCheck"
                                      Foreground="{DynamicResource Brush.Text.Primary}"
                                      Content="Enable per-tab search size (override default)"
                                      Margin="0,0,0,8"
                                      IsChecked="{Binding UsePerViewOverride, Mode=TwoWay}"
                                      Checked="UsePerViewCheck_Changed"
                                      Unchecked="UsePerViewCheck_Changed"/>

                            <!-- Per-tab sliders -->
                            <StackPanel x:Name="PerViewPanel"
                                        Visibility="{Binding ElementName=UsePerViewCheck, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Per-tab search text sizes" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,8"/>

                                <UniformGrid Columns="2" Rows="2">
                                    <!-- User -->
                                    <Grid Margin="0,0,12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="User" Style="{StaticResource FieldLabel}"/>
                                        <Slider x:Name="UserSize" Grid.Column="2" Minimum="8" Maximum="24"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding UserFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ValueChanged="PerViewSize_ValueChanged"/>
                                        <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}">
                                            <Run Text="{Binding ElementName=UserSize, Path=Value, StringFormat=F0}"/><Run Text=" pt"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Computer -->
                                    <Grid Margin="0,0,12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Computer" Style="{StaticResource FieldLabel}"/>
                                        <Slider x:Name="ComputerSize" Grid.Column="2" Minimum="8" Maximum="24"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding ComputerFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ValueChanged="PerViewSize_ValueChanged"/>
                                        <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}">
                                            <Run Text="{Binding ElementName=ComputerSize, Path=Value, StringFormat=F0}"/><Run Text=" pt"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Group -->
                                    <Grid Margin="0,0,12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Group" Style="{StaticResource FieldLabel}"/>
                                        <Slider x:Name="GroupSize" Grid.Column="2" Minimum="8" Maximum="24"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding GroupFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ValueChanged="PerViewSize_ValueChanged"/>
                                        <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}">
                                            <Run Text="{Binding ElementName=GroupSize, Path=Value, StringFormat=F0}"/><Run Text=" pt"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Entra -->
                                    <Grid Margin="0,0,12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Entra" Style="{StaticResource FieldLabel}"/>
                                        <Slider x:Name="EntraSize" Grid.Column="2" Minimum="8" Maximum="24"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding EntraFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ValueChanged="PerViewSize_ValueChanged"/>
                                        <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}">
                                            <Run Text="{Binding ElementName=EntraSize, Path=Value, StringFormat=F0}"/><Run Text=" pt"/>
                                        </TextBlock>
                                    </Grid>
                                </UniformGrid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- === LINKS CARD (RADIO MODE + DROPDOWN) === -->
                <Border Style="{StaticResource Card.Container}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource CardGradient.Accent}"
                                CornerRadius="12,0,0,12"/>

                        <StackPanel Grid.Column="1" Margin="16">
                            <TextBlock Text="Links" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>

                            <!-- Mode selection: radio group -->
                            <StackPanel Margin="0,0,0,8">
                                <RadioButton x:Name="RB_LastViewed"
                                             GroupName="LinksStartMode"
                                             Content="Start with last viewed team"
                                             Foreground="{DynamicResource Brush.Text.Primary}"
                                             IsChecked="{Binding Source={x:Static app:App.Settings}, Path=Ui.Links.OpenLastViewedFirst, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Checked="LinksMode_LastViewed_Checked"/>

                                <RadioButton x:Name="RB_Override"
                                             GroupName="LinksStartMode"
                                             Content="Start with a specific team"
                                             Foreground="{DynamicResource Brush.Text.Primary}"
                                             Margin="0,6,0,0"
                                             IsChecked="{Binding Source={x:Static app:App.Settings}, Path=Ui.Links.OverrideEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Checked="LinksMode_Override_Checked"/>
                            </StackPanel>

                            <!-- Override team dropdown (visible only when Override is selected) -->
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding Source={x:Static app:App.Settings}, Path=Ui.Links.OverrideEnabled, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Override team" Style="{StaticResource FieldLabel}"/>

                                <ComboBox Grid.Column="2"
                                          Style="{DynamicResource Combo.Links.Dropdown}"
                                          Width="220"                   
                                          Height="28"
                                          HorizontalAlignment="Left"
                                          Foreground="{DynamicResource Brush.Text.Primary}"
                                          ItemsSource="{Binding DataContext.LinksVM.TeamNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Source={x:Static app:App.Settings}, Path=Ui.Links.OverrideTeam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsSynchronizedWithCurrentItem="False">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding}"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                                       FontSize="12"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <TextBlock Text="Choose how Links opens. If ‘Start with a specific team’ is selected and that team exists, Links opens to it; otherwise it opens to your last viewed team"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- === LOGS CARD === -->
                <Border Style="{StaticResource Card.Container}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource CardGradient.Accent}"
                                CornerRadius="12,0,0,12"/>

                        <StackPanel Grid.Column="1" Margin="16">
                            <TextBlock Text="Logs" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>

                            <!-- Log level -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Log level" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="LogLevelCombo" Grid.Column="2"
                                          Style="{DynamicResource Combo.Links.Dropdown}"
                                          ItemsSource="{Binding LogLevels}"
                                          SelectedItem="{Binding MinimumLogLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Retention -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Log retention" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="RetentionCombo" Grid.Column="2"
                                          Style="{DynamicResource Combo.Links.Dropdown}"
                                          ItemsSource="{Binding RetentionOptions}"
                                          SelectedItem="{Binding RetentionDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ItemTemplate="{StaticResource DaysItemTemplate}"/>
                            </Grid>

                            <WrapPanel Orientation="Horizontal">
                                <Button x:Name="BtnOpenLogsFolder"
                                        Style="{StaticResource Button.Rounded.Compact}"
                                        Click="BtnOpenLogsFolder_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="pack://application:,,,/img/fileicon.png"
                                               Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="Open logs folder"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- === SEARCH CARD (history) === -->
                <Border Style="{StaticResource Card.Container}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource CardGradient.Accent}"
                                CornerRadius="12,0,0,12"/>

                        <StackPanel Grid.Column="1" Margin="16">
                            <TextBlock Text="Search" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="History size" Style="{StaticResource FieldLabel}"/>

                                <ComboBox x:Name="HistorySizeCombo" Grid.Column="2"
                                          Style="{DynamicResource Combo.Links.Dropdown}"
                                          ItemsSource="{Binding HistorySizeOptions}"
                                          SelectedValue="{Binding MaxSearchHistory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="."
                                          ItemTemplate="{StaticResource HistoryItemTemplate}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- FIXED BOTTOM BAR -->
        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Border Background="{DynamicResource Brush.Surface.Hover}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="12">
                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Changes are not saved until you click Apply."
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>

                    <Button x:Name="BtnApply" Grid.Column="1"
                            Style="{StaticResource Button.Rounded}"
                            Click="BtnApply_Click"
                            MinHeight="32" Height="36" MinWidth="92" Padding="14,6"
                            Margin="12,0,0,0"
                            BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1.25">
                        <TextBlock Text="Apply" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
