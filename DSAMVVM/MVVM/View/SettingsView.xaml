<UserControl x:Class="DSAMVVM.MVVM.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:DSAMVVM"
             xmlns:vm="clr-namespace:DSAMVVM.MVVM.ViewModel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theme/Colors/Colors.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Decor/Gradient.UA.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/Button.Rounded.xaml"/>
                <ResourceDictionary Source="/Theme/Controls/LinksComboBoxTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Card.Container" TargetType="Border">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CardGradient.Surface.Hover}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.7"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Button.Rounded.Compact" TargetType="Button" BasedOn="{StaticResource Button.Rounded}">
                <Setter Property="Padding"   Value="8,2"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="Height"    Value="28"/>
                <Setter Property="MinWidth"  Value="0"/>
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="TextBox.Settings" TargetType="TextBox">
                <Setter Property="Height" Value="28"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.1}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <DataTemplate x:Key="HistoryItemTemplate">
                <TextBlock Foreground="{DynamicResource Brush.Text.Primary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding StringFormat={}{0} items}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="0">
                                    <Setter Property="Text" Value="Never"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="1">
                                    <Setter Property="Text" Value="1 item"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DataTemplate>

            <DataTemplate x:Key="DaysItemTemplate">
                <TextBlock Foreground="{DynamicResource Brush.Text.Primary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding StringFormat={}{0} days}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="-1">
                                    <Setter Property="Text" Value="Keep indefinitely"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="1">
                                    <Setter Property="Text" Value="1 day"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DataTemplate>

            <DataTemplate x:Key="PtItemTemplate">
                <TextBlock Foreground="{DynamicResource Brush.Text.Primary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding StringFormat={}{0} pt}"/>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16" Orientation="Vertical">

                <Border Style="{StaticResource Card.Container}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardGradient.Accent}" CornerRadius="12,0,0,12"/>
                        <StackPanel Grid.Column="1" Margin="16">
                            <TextBlock Text="Search text" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Default search size at launch" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Column="2" Style="{DynamicResource Combo.Links.Dropdown}"
                                          ItemsSource="{Binding InitialFontSizeOptions}"
                                          SelectedValue="{Binding DefaultFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="." ItemTemplate="{StaticResource PtItemTemplate}"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Default search text size" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="GeneralSizeSlider" Grid.Column="2" Minimum="8" Maximum="24" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Value="{Binding DefaultFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}">
                                    <Run Text="{Binding ElementName=GeneralSizeSlider, Path=Value, StringFormat=F0}"/><Run Text=" pt"/>
                                </TextBlock>
                            </Grid>

                            <CheckBox x:Name="UsePerViewCheck" Foreground="{DynamicResource Brush.Text.Primary}"
                                      Content="Enable per-tab search size (override default)" Margin="0,0,0,8"
                                      IsChecked="{Binding UsePerViewOverride, Mode=TwoWay}"/>

                            <StackPanel Visibility="{Binding ElementName=UsePerViewCheck, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Per-tab search text sizes" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,8"/>
                                <UniformGrid Columns="2" Rows="2">
                                    <Grid Margin="0,0,12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="User" Style="{StaticResource FieldLabel}"/>
                                        <Slider x:Name="UserSize" Grid.Column="2" Minimum="8" Maximum="24" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="{Binding UserFontSize, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}"><Run Text="{Binding ElementName=UserSize, Path=Value, StringFormat=F0}"/><Run Text=" pt"/></TextBlock>
                                    </Grid>
                                    <Grid Margin="0,0,12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Computer" Style="{StaticResource FieldLabel}"/>
                                        <Slider x:Name="ComputerSize" Grid.Column="2" Minimum="8" Maximum="24" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="{Binding ComputerFontSize, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}"><Run Text="{Binding ElementName=ComputerSize, Path=Value, StringFormat=F0}"/><Run Text=" pt"/></TextBlock>
                                    </Grid>
                                    <Grid Margin="0,0,12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Group" Style="{StaticResource FieldLabel}"/>
                                        <Slider x:Name="GroupSize" Grid.Column="2" Minimum="8" Maximum="24" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="{Binding GroupFontSize, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}"><Run Text="{Binding ElementName=GroupSize, Path=Value, StringFormat=F0}"/><Run Text=" pt"/></TextBlock>
                                    </Grid>
                                    <Grid Margin="0,0,12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Entra" Style="{StaticResource FieldLabel}"/>
                                        <Slider x:Name="EntraSize" Grid.Column="2" Minimum="8" Maximum="24" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="{Binding EntraFontSize, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}"><Run Text="{Binding ElementName=EntraSize, Path=Value, StringFormat=F0}"/><Run Text=" pt"/></TextBlock>
                                    </Grid>
                                </UniformGrid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card.Container}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardGradient.Accent}" CornerRadius="12,0,0,12"/>
                        <StackPanel Grid.Column="1" Margin="16">
                            <TextBlock Text="System Tray" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>
                            <CheckBox x:Name="EnableTrayCheck" Foreground="{DynamicResource Brush.Text.Primary}" Content="Enable System Tray Icon" Margin="0,0,0,8" IsChecked="{Binding EnableTrayIcon, Mode=TwoWay}"/>
                            <StackPanel Visibility="{Binding ElementName=EnableTrayCheck, Path=IsChecked, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                <CheckBox Foreground="{DynamicResource Brush.Text.Primary}" Content="Minimize window to Tray" Margin="24,0,0,8" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"/>
                                <CheckBox Foreground="{DynamicResource Brush.Text.Primary}" Content="Close button (X) minimizes to Tray" Margin="24,0,0,0" IsChecked="{Binding CloseToTray, Mode=TwoWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card.Container}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardGradient.Accent}" CornerRadius="12,0,0,12"/>

                        <StackPanel Grid.Column="1" Margin="16">
                            <TextBlock Text="Quick Search (Overlay)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>

                            <CheckBox x:Name="EnableQuickSearchCheck" Foreground="{DynamicResource Brush.Text.Primary}" 
                      Content="Enable Double-Tap Quick Search" Margin="0,0,0,12" 
                      IsChecked="{Binding EnableQuickSearch, Mode=TwoWay}"/>

                            <StackPanel Visibility="{Binding ElementName=EnableQuickSearchCheck, Path=IsChecked, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Double-Tap Key" Style="{StaticResource FieldLabel}"/>

                                    <ComboBox Grid.Column="2" Style="{DynamicResource Combo.Links.Dropdown}" 
                                              ItemsSource="{Binding ModifierKeyOptions}" 
                                              DisplayMemberPath="Value" 
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding QuickSearchModifierKey, Mode=TwoWay}"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Double-Tap Speed" Style="{StaticResource FieldLabel}"/>
                                    <Slider x:Name="DoubleTapSlider" Grid.Column="2" Minimum="100" Maximum="1000" TickFrequency="50" 
                            IsSnapToTickEnabled="True" Value="{Binding QuickSearchDoubleTapMs, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}">
                        <Run Text="{Binding ElementName=DoubleTapSlider, Path=Value, StringFormat=F0}"/><Run Text=" ms"/>
                                    </TextBlock>
                                </Grid>

                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card.Container}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardGradient.Accent}" CornerRadius="12,0,0,12"/>
                        <StackPanel Grid.Column="1" Margin="16">
                            <TextBlock Text="Application Updates" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>
                            <CheckBox Foreground="{DynamicResource Brush.Text.Primary}" Content="Opt-in to Pre-Release Channels" IsChecked="{Binding EnablePreReleaseChannel, Mode=TwoWay}" ToolTip="Download preview builds for testing."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card.Container}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardGradient.Accent}" CornerRadius="12,0,0,12"/>
                        <StackPanel Grid.Column="1" Margin="16">
                            <TextBlock Text="Data Management" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>
                            <TextBlock Text="Department Data" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,8"/>
                            <CheckBox Content="Override Default Location" IsChecked="{Binding UseCustomDept}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,16" Visibility="{Binding UseCustomDept, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Source" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding DataSourceOptions}" SelectedItem="{Binding DeptSource}" Style="{DynamicResource Combo.Links.Dropdown}" HorizontalAlignment="Left" Width="140"/>
                                <TextBlock Grid.Row="2" Text="Location" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding DeptUri, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Settings}"/>
                                <Button Grid.Row="2" Grid.Column="3" Command="{Binding BrowseDeptCommand}" Content="Browse" Width="60" Margin="8,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Rounded.Compact}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeptSource}" Value="File">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                            <TextBlock Text="Links Data" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,8"/>
                            <CheckBox Content="Override Default Location" IsChecked="{Binding UseCustomLinks}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>
                            <Grid Visibility="{Binding UseCustomLinks, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Source" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding DataSourceOptions}" SelectedItem="{Binding LinksSource}" Style="{DynamicResource Combo.Links.Dropdown}" HorizontalAlignment="Left" Width="140"/>
                                <TextBlock Grid.Row="2" Text="Location" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding LinksUri, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Settings}"/>
                                <Button Grid.Row="2" Grid.Column="3" Command="{Binding BrowseLinksCommand}" Content="Browse" Width="60" Margin="8,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Rounded.Compact}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LinksSource}" Value="File">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card.Container}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardGradient.Accent}" CornerRadius="12,0,0,12"/>
                        <StackPanel Grid.Column="1" Margin="16">
                            <TextBlock Text="Links Start Mode" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>
                            <StackPanel Margin="0,0,0,8">
                                <RadioButton GroupName="LinksStartMode" Content="Start with last viewed team" Foreground="{DynamicResource Brush.Text.Primary}" IsChecked="{Binding LinksSettings.OpenLastViewedFirst, Mode=TwoWay}"/>
                                <RadioButton GroupName="LinksStartMode" Content="Start with a specific team" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,6,0,0" IsChecked="{Binding LinksSettings.OverrideEnabled, Mode=TwoWay}"/>
                            </StackPanel>
                            <Grid Visibility="{Binding LinksSettings.OverrideEnabled, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Override team" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Column="2" Width="220" Height="28" Style="{DynamicResource Combo.Links.Dropdown}"
                                          ItemsSource="{Binding DataContext.LinksVM.TeamNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding LinksSettings.OverrideTeam, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card.Container}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardGradient.Accent}" CornerRadius="12,0,0,12"/>
                        <StackPanel Grid.Column="1" Margin="16">
                            <TextBlock Text="Logs" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Log level" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Column="2" Style="{DynamicResource Combo.Links.Dropdown}" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding MinimumLogLevel, Mode=TwoWay}"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Log retention" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Column="2" Style="{DynamicResource Combo.Links.Dropdown}" ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding RetentionDays, Mode=TwoWay}" ItemTemplate="{StaticResource DaysItemTemplate}"/>
                            </Grid>
                            <Button Command="{Binding OpenLogsCommand}" Style="{StaticResource Button.Rounded.Compact}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/img/fileicon.png" Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Open logs folder" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card.Container}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardGradient.Accent}" CornerRadius="12,0,0,12"/>
                        <StackPanel Grid.Column="1" Margin="16">
                            <TextBlock Text="Search History" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="History size" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Column="2" Style="{DynamicResource Combo.Links.Dropdown}" ItemsSource="{Binding HistorySizeOptions}" SelectedValue="{Binding MaxSearchHistory, Mode=TwoWay}" SelectedValuePath="." ItemTemplate="{StaticResource HistoryItemTemplate}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card.Container}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardGradient.Accent}" CornerRadius="12,0,0,12"/>
                        <StackPanel Grid.Column="1" Margin="16">
                            <TextBlock Text="App Maintenance" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,4"/>

                            <TextBlock Text="Reset all settings, paths, and UI preferences to factory state." 
                                       Foreground="{DynamicResource Brush.Text.Primary}" Opacity="0.6" FontSize="11" Margin="0,0,0,12"/>

                            <Button Command="{Binding ResetDefaultsCommand}" Style="{StaticResource Button.Rounded.Compact}"
                                    HorizontalAlignment="Left" Padding="16,4">
                                <TextBlock Text="Reset to Factory Defaults" Foreground="White" FontSize="12"/>
                            </Button>

                            <CheckBox Content="Enable Admin Panel"
                                      IsChecked="{Binding ShowAdminView, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding HasUnlockedAdmin, Converter={StaticResource BoolToVis}}"
                                      Foreground="{DynamicResource Brush.Text.Primary}"
                                      Margin="0,20,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Border x:Name="FooterBorder" BorderThickness="1" CornerRadius="12" Padding="12,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                <Setter Property="Background" Value="#1A1A00"/>
                                <Setter Property="BorderBrush" Value="Yellow"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠" Foreground="Yellow" FontSize="18" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"
                                   Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock VerticalAlignment="Center" Foreground="White">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding StatusMessage}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                            <Setter Property="Text" Value="Changes detected. Remember to click Apply!"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="Yellow"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding DiscardCommand}" Content="Discard" Style="{StaticResource Button.Rounded.Compact}"
                                Margin="0,0,10,0" Padding="14,0" Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}"/>
                        <Button x:Name="BtnApply" Style="{StaticResource Button.Rounded}" Command="{Binding ApplyCommand}"
                                MinHeight="32" Height="36" MinWidth="92" Padding="14,6">
                            <TextBlock Text="Apply" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>