<UserControl x:Class="DSAMVVM.MVVM.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Local helpers; global themed brushes come from App.xaml -->
            <SolidColorBrush x:Key="TextPrimBrush" Color="{DynamicResource Color.Text.Primary}"/>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimBrush}"/>
            </Style>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.Surface.0}">
        <!-- Row 0 = scrollable content, Row 1 = fixed bottom bar -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- SCROLLABLE CONTENT -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16" Orientation="Vertical">

                <!-- === SEARCH TEXT CARD === -->
                <Border Padding="0" CornerRadius="12" Margin="0,0,0,16"
                        Background="{StaticResource Brush.Surface.Hover}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left accent -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource Brush.Accent}"
                                CornerRadius="12,0,0,12"/>

                        <StackPanel Grid.Column="1" Margin="16">
                            <TextBlock Text="Search text" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimBrush}" Margin="0,0,0,12"/>

                            <!-- Default size at launch -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Default search size at launch" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="InitialSizeCombo" Grid.Column="2"
                                          Style="{DynamicResource Combo.Links.Dropdown}"
                                          SelectionChanged="InitialSizeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Small (12 pt)"       Tag="12"/>
                                    <ComboBoxItem Content="Normal (14 pt)"      Tag="14" IsSelected="True"/>
                                    <ComboBoxItem Content="Large (16 pt)"       Tag="16"/>
                                    <ComboBoxItem Content="Extra Large (18 pt)" Tag="18"/>
                                </ComboBox>
                            </Grid>

                            <!-- Default (app-wide) search size -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Default search text size" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="GeneralSizeSlider" Grid.Column="2"
                                        Minimum="8" Maximum="24" TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="GeneralSizeSlider_ValueChanged"/>
                                <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}">
                                    <Run Text="{Binding ElementName=GeneralSizeSlider, Path=Value, StringFormat=F0}"/>
                                    <Run Text=" pt"/>
                                </TextBlock>
                            </Grid>

                            <!-- Per-tab toggle -->
                            <CheckBox x:Name="UsePerViewCheck"
                                      Foreground="{StaticResource TextPrimBrush}"
                                      Content="Enable per-tab search size (override default)"
                                      Margin="0,0,0,8"
                                      Checked="UsePerViewCheck_Changed"
                                      Unchecked="UsePerViewCheck_Changed"/>

                            <!-- Per-tab sliders -->
                            <StackPanel x:Name="PerViewPanel"
                                        Visibility="{Binding ElementName=UsePerViewCheck, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Per-tab search text sizes" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimBrush}" Margin="0,0,0,8"/>

                                <UniformGrid Columns="2" Rows="2">
                                    <!-- User -->
                                    <Grid Margin="0,0,12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="User" Style="{StaticResource FieldLabel}"/>
                                        <Slider x:Name="UserSize" Grid.Column="2" Minimum="8" Maximum="24"
                                                TickFrequency="1" IsSnapToTickEnabled="True" Value="14"
                                                ValueChanged="PerViewSize_ValueChanged"/>
                                        <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}">
                                            <Run Text="{Binding ElementName=UserSize, Path=Value, StringFormat=F0}"/><Run Text=" pt"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Computer -->
                                    <Grid Margin="0,0,12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Computer" Style="{StaticResource FieldLabel}"/>
                                        <Slider x:Name="ComputerSize" Grid.Column="2" Minimum="8" Maximum="24"
                                                TickFrequency="1" IsSnapToTickEnabled="True" Value="14"
                                                ValueChanged="PerViewSize_ValueChanged"/>
                                        <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}">
                                            <Run Text="{Binding ElementName=ComputerSize, Path=Value, StringFormat=F0}"/><Run Text=" pt"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Group -->
                                    <Grid Margin="0,0,12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Group" Style="{StaticResource FieldLabel}"/>
                                        <Slider x:Name="GroupSize" Grid.Column="2" Minimum="8" Maximum="24"
                                                TickFrequency="1" IsSnapToTickEnabled="True" Value="14"
                                                ValueChanged="PerViewSize_ValueChanged"/>
                                        <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}">
                                            <Run Text="{Binding ElementName=GroupSize, Path=Value, StringFormat=F0}"/><Run Text=" pt"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Entra -->
                                    <Grid Margin="0,0,12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Entra" Style="{StaticResource FieldLabel}"/>
                                        <Slider x:Name="EntraSize" Grid.Column="2" Minimum="8" Maximum="24"
                                                TickFrequency="1" IsSnapToTickEnabled="True" Value="14"
                                                ValueChanged="PerViewSize_ValueChanged"/>
                                        <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}">
                                            <Run Text="{Binding ElementName=EntraSize, Path=Value, StringFormat=F0}"/><Run Text=" pt"/>
                                        </TextBlock>
                                    </Grid>
                                </UniformGrid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- === LOGS CARD === -->
                <Border Padding="0" CornerRadius="12" Margin="0,0,0,16"
                        Background="{StaticResource Brush.Surface.Hover}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource Brush.Accent}"
                                CornerRadius="12,0,0,12"/>

                        <StackPanel Grid.Column="1" Margin="16">
                            <TextBlock Text="Logs" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimBrush}" Margin="0,0,0,12"/>

                            <!-- Log level -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Log level" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="LogLevelCombo" Grid.Column="2"
                                          Style="{DynamicResource Combo.Links.Dropdown}"
                                          SelectedIndex="2">
                                    <ComboBoxItem Content="Off"/>
                                    <ComboBoxItem Content="Debug"/>
                                    <ComboBoxItem Content="Info"/>
                                    <ComboBoxItem Content="Warning"/>
                                    <ComboBoxItem Content="Error"/>
                                </ComboBox>
                            </Grid>

                            <!-- Retention -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Log retention" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="RetentionCombo" Grid.Column="2"
                                          Style="{DynamicResource Combo.Links.Dropdown}"
                                          SelectedIndex="3">
                                    <ComboBoxItem Content="1 day"             Tag="1"/>
                                    <ComboBoxItem Content="7 days"            Tag="7"/>
                                    <ComboBoxItem Content="14 days"           Tag="14"/>
                                    <ComboBoxItem Content="30 days"           Tag="30"/>
                                    <ComboBoxItem Content="60 days"           Tag="60"/>
                                    <ComboBoxItem Content="Keep indefinitely" Tag="-1"/>
                                </ComboBox>
                            </Grid>

                            <!-- Action -->
                            <WrapPanel ItemHeight="32" ItemWidth="220" Orientation="Horizontal">
                                <Button x:Name="BtnOpenLogsFolder"
                                        Style="{DynamicResource Button.Rounded}"
                                        Click="BtnOpenLogsFolder_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="pack://application:,,,/img/fileicon.png"
                                               Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="Open logs folder"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- === SEARCH CARD (history) === -->
                <Border Padding="0" CornerRadius="12" Margin="0,0,0,16"
                        Background="{StaticResource Brush.Surface.Hover}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource Brush.Accent}"
                                CornerRadius="12,0,0,12"/>

                        <StackPanel Grid.Column="1" Margin="16">
                            <TextBlock Text="Search" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimBrush}" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="History size" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="HistorySizeCombo" Grid.Column="2"
                                          Style="{DynamicResource Combo.Links.Dropdown}"
                                          SelectedIndex="6">
                                    <ComboBoxItem Content="Never"     Tag="0"/>
                                    <ComboBoxItem Content="5 items"   Tag="5"/>
                                    <ComboBoxItem Content="6 items"   Tag="6"/>
                                    <ComboBoxItem Content="7 items"   Tag="7"/>
                                    <ComboBoxItem Content="8 items"   Tag="8"/>
                                    <ComboBoxItem Content="9 items"   Tag="9"/>
                                    <ComboBoxItem Content="10 items"  Tag="10"/>
                                    <ComboBoxItem Content="15 items"  Tag="15"/>
                                    <ComboBoxItem Content="20 items"  Tag="20"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- FIXED BOTTOM BAR — Outline glow -->
        <Grid Grid.Row="1" Margin="16,0,16,16">
            <!-- Glow ring (behind) -->
            <Border x:Name="GlowRing"
          IsHitTestVisible="False"
          Background="Transparent"
          BorderBrush="{DynamicResource Brush.Accent.Hover}"
          BorderThickness="1.25"
          CornerRadius="12">
                <Border.Effect>
                    <!-- Outer glow that follows your accent color -->
                    <DropShadowEffect ShadowDepth="0"
                        BlurRadius="24"
                        Opacity="0.35"
                        Color="{Binding BorderBrush.(SolidColorBrush.Color), ElementName=GlowRing}"/>
                </Border.Effect>
            </Border>

            <!-- Actual footer card -->
            <Border Background="{DynamicResource Brush.Surface.Hover}"
          BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
          CornerRadius="12" Margin="1">
                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Changes are not saved until you click Apply."
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.Text.Primary}"/>

                    <Button x:Name="BtnApply" Grid.Column="1"
              Style="{DynamicResource Button.Rounded}"
              Click="BtnApply_Click"
              MinHeight="32" Height="36" MinWidth="92" Padding="14,6"
              Margin="12,0,0,0"
              BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1.25">
                        <TextBlock Text="Apply"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
