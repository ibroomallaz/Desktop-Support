<UserControl x:Class="DSAMVVM.MVVM.View.GroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:DSAMVVM.MVVM.Model.Behaviors">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,0,0,10">
            <RadioButton Content="User's MIM Groups"
                 GroupName="Mode"
                 IsChecked="{Binding IsUserMim}"
                 Margin="0,0,16,0"
                 Style="{StaticResource Radio.GroupView}"/>
            <RadioButton Content="Group Members"
                 GroupName="Mode"
                 IsChecked="{Binding IsGroupMembers}"
                 Margin="0,0,16,0"
                 Style="{StaticResource Radio.GroupView}"/>
            <RadioButton Content="Dept Support Search"
                 GroupName="Mode"
                 IsChecked="{Binding IsDeptSearch}"
                 Margin="0,0,16,0" 
                 Style="{StaticResource Radio.GroupView}"/>
            <RadioButton Content="Division Support"
                 GroupName="Mode"
                 IsChecked="{Binding IsDivSearch}"
                 Style="{StaticResource Radio.GroupView}"/>
        </StackPanel>

        <FlowDocumentScrollViewer
                Grid.Row="1"
                IsToolBarVisible="False"
                VerticalScrollBarVisibility="Auto"
                beh:FlowDocBinder.Text="{Binding SearchLog}"
                beh:FlowDocBinder.ViewName="{Binding CurrentViewContext}"
                beh:FlowDocBinder.PreserveScrollPosition="True" />

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Clear"
                    Padding="10,4"
                    Margin="0,0,12,0"
                    Command="{Binding ClearLogCommand}"
                    Style="{DynamicResource Button.FlowDoc}"
                    ToolTip="Clear the log output"/>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="A-"
                        Width="44"
                        Margin="0,0,6,0"
                        Command="{Binding DecreaseFontCommand}"
                        Style="{DynamicResource Button.FlowDoc.Small}"
                        ToolTip="Decrease log text size"/>
                <Button Content="A"
                        Width="44"
                        Command="{Binding ResetFontCommand}"
                        Style="{DynamicResource Button.FlowDoc.Small}"
                        ToolTip="Reset log text size"/>
                <Button Content="A+"
                        Width="44"
                        Margin="6,0,0,0"
                        Command="{Binding IncreaseFontCommand}"
                        Style="{DynamicResource Button.FlowDoc.Small}"
                        ToolTip="Increase log text size"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>