<UserControl x:Class="DSAMVVM.MVVM.View.GroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:DSAMVVM.MVVM.Behaviors">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- mode radios -->
            <RowDefinition Height="*"/>
            <!-- log viewer -->
            <RowDefinition Height="Auto"/>
            <!-- bottom bar -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,0,0,10">
            <RadioButton Content="User's MIM Groups"
                 IsChecked="{Binding IsUserMim}"
                 Margin="0,0,16,0"
                 Foreground="White"
                 Style="{StaticResource GroupViewRadioButtonTheme}"/>
            <RadioButton Content="Group Members"
                 IsChecked="{Binding IsGroupMembers}"
                 Foreground="White"
                 Style="{StaticResource GroupViewRadioButtonTheme}"/>
        </StackPanel>


        <FlowDocumentScrollViewer
            Grid.Row="1"
            IsToolBarVisible="False"
            VerticalScrollBarVisibility="Auto"
            beh:FlowDocBinder.Text="{Binding SearchLog}"
            beh:FlowDocBinder.ViewName="GroupView"
            beh:FlowDocBinder.PreserveScrollPosition="True" />

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Clear Log" Padding="10,4" Margin="0,0,12,0" Click="ClearLog_Click"/>
                <Button Content="A-" Width="44" Margin="0,0,6,0" Click="DecreaseFont_Click"/>
                <Button Content="A"  Width="44" Click="ResetFont_Click"/>
                <Button Content="A+" Width="44" Margin="0,0,6,0" Click="IncreaseFont_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
