<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>DSA_Installer</OutputName>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressIces>ICE38;ICE64;ICE91</SuppressIces>
    <SuppressValidation>true</SuppressValidation>
    <OutputPath>..\artifacts\$(Configuration)\</OutputPath>
    <AcceptEula>wix7</AcceptEula>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DSAMVVM\DSAMVVM.csproj" Publish="true" />
  </ItemGroup>

  <!-- Ensure DSAMVVM is always freshly published even when Rider builds with BuildProjectReferences=false -->
  <Target Name="PublishAppForWix" BeforeTargets="BeforeBuild">
    <RemoveDir Directories="$(BaseIntermediateOutputPath)$(Configuration)\publish\DSAMVVM" />
    <MSBuild Projects="..\DSAMVVM\DSAMVVM.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)$(Configuration)\publish\DSAMVVM\" />
  </Target>
</Project>
